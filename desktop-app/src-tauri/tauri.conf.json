{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Vitora HMIS",
  "version": "0.1.0",
  "identifier": "digital.vitora.hmis",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://127.0.0.1:3009",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vitora HMIS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://*.vitora.digital wss://*.vitora.digital https://*.azurecontainerapps.io wss://*.azurecontainerapps.io https://*.powersync.journeyapps.com wss://*.powersync.journeyapps.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' https://*.vitora.digital"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Vitora HMIS"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [],
    "resources": [
      "standalone.tar.gz",
      "binaries/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US",
        "template": null,
        "bannerPath": null,
        "dialogImagePath": null
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "startMenuFolder": "Vitora HMIS",
        "headerImage": null,
        "sidebarImage": null
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGOUI3MzdEN0RGMTY2QzIKUldUQ1p2RjlmWE9iLzJ5NzJ1Y3dUem9oRFFmemRzMFdtM1VlVXk5N1BIVEtRYkJ5c29SampiRG0K",
      "endpoints": [
        "https://vitora-releases-dzf4f6hmfdadf3gk.z01.azurefd.net/updates"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vitora"]
      }
    }
  }
}
