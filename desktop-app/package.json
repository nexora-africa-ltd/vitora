{
  "name": "vitora-desktop",
  "version": "0.1.0",
  "description": "Vitora HMIS Desktop Application (Tauri v2)",
  "private": true,
  "scripts": {
    "dev": "concurrently --names web,tauri --prefix-colors cyan,magenta \"npm run dev:web\" \"npm run dev:tauri\"",
    "dev:web": "cd ../web-app && npm run dev",
    "dev:tauri": "cd src-tauri && cargo tauri dev",
    "build": "npm run build:web && npm run build:tauri",
    "build:web": "cd ../web-app && npm run build",
    "build:tauri": "cd src-tauri && cargo tauri build",
    "bundle-standalone": "node scripts/bundle-standalone.js",
    "tauri": "cd src-tauri && cargo tauri"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
