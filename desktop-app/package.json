{
  "name": "vitora-desktop",
  "version": "1.0.6",
  "description": "Vitora HMIS Desktop Application (Tauri v2)",
  "private": true,
  "scripts": {
    "dev": "concurrently --names web,tauri --prefix-colors cyan,magenta \"npm run dev:web\" \"npm run dev:tauri\"",
    "dev:web": "cd ../web-app && npm run dev",
    "dev:tauri": "cd src-tauri && cargo tauri dev",
    "build": "npm run build:web && npm run bundle-standalone && npm run build:tauri",
    "build:web": "cd ../web-app && VITORA_DESKTOP=1 npm run build",
    "build:tauri": "cd src-tauri && cargo tauri build",
    "build:check": "cd src-tauri && cargo check --release",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:desktop-smoke": "cd src-tauri && cargo test --lib",
    "bundle-standalone": "node scripts/bundle-standalone.js",
    "download-node": "node scripts/download-node.js",
    "setup": "npm run download-node && npm run build:web && npm run bundle-standalone",
    "tauri": "cd src-tauri && cargo tauri"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
