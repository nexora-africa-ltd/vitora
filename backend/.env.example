# =============================================================================
# Vitora HMIS Backend - Environment Variables
# =============================================================================
# Copy this file to .env for local development
# =============================================================================

# Django Core Settings
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=true

# =============================================================================
# Database (SQLite for development, PostgreSQL for production)
# =============================================================================
# For production (Render, Heroku, etc.):
# DATABASE_URL=postgres://user:password@host:port/database
# Persistent DB connection age in seconds (staging recommendation: 60)
DB_CONN_MAX_AGE=60

# =============================================================================
# CORS & Security
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3009,http://127.0.0.1:3009

# =============================================================================
# SHA / DHA Integration (Kenya Digital Superhighway)
# =============================================================================
SHA_ENABLED=true
# SHA API base URL (provided during DHA onboarding)
SHA_API_BASE_URL=
SHA_AUTH_MODE=legacy
SHA_AUTH_BASE_URL=
SHA_AUTH_TOKEN_ENDPOINT=

# SHA Authentication (get from DHA portal)
SHA_CONSUMER_KEY=
SHA_CLIENT_ID=
SHA_USERNAME=
SHA_PASSWORD=
SHA_CLIENT_SECRET=
SHA_AGENT=
SHA_ENCRYPTED_PIN=  # Pre-encrypted PIN (use sha-pin-gen.py to generate)

# SHA FHIR Base URL (provided by DHA coordinator during onboarding)
SHA_FHIR_BASE_URL=
SHA_API_TIMEOUT=30
# DHA Shared Health Record consent lifecycle (disabled until DHA UAT approval)
SHR_ENABLED=false
SHR_ILM_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1

# DHA ILM terminology provenance (set by DHA; exactly one scope is required)
ILM_TERMINOLOGY_OWNER=
ILM_TERMINOLOGY_SOURCES=
ILM_TERMINOLOGY_COLLECTION=


# =============================================================================
# Facility Configuration
# =============================================================================
FACILITY_MFL_CODE=TEST-001
FACILITY_LEVEL=L3

# =============================================================================
# Encryption (for sensitive data)
# =============================================================================
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =============================================================================
# Celery/Redis (optional)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# =============================================================================
# Email (optional)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# =============================================================================
# M-Pesa (optional)
# =============================================================================
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:9088/api/payments/mpesa/callback/

# =============================================================================
# ICD-11 Local API (optional)
# =============================================================================
ICD11_USE_LOCAL=true
ICD11_LOCAL_API_URL=http://localhost:5080

# =============================================================================
# Sync
# =============================================================================
SYNC_ENABLED=false
# Set CLOUD_API_BASE_URL per environment; activation derives /api/sync from it.
# You may override SYNC_SERVER_URL directly when needed.
CLOUD_API_BASE_URL=
SYNC_SERVER_URL=

# =============================================================================
# Media Storage (DICOM PACS + thumbnails)
# =============================================================================
# local: store under MEDIA_ROOT on local disk
# azure_blob: store DICOM and thumbnails in Azure Blob Storage
MEDIA_BACKEND=local
MEDIA_ROOT=media
MEDIA_URL=/media/
MEDIA_SERVE_FROM_DJANGO=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_MEDIA_STORAGE_ACCOUNT_NAME=
AZURE_MEDIA_STORAGE_ACCOUNT_KEY=
AZURE_MEDIA_CONTAINER=vitora-media
# Optional override for public media base URL
MEDIA_BLOB_BASE_URL=

AT_USERNAME=
AT_API_KEY=
SMS_SENDER_ID=VitoraHMIS
SMS_BACKEND=hmis.apps.core.sms.backends.MockSMSBackend

# =============================================================================
# TibaBot AI Integration
# =============================================================================
# Master switch: set to true to enable AI proxy endpoints (/api/ai/*)
TIBABOT_ENABLED=false
# TibaBot API URL (provided by Nexora support)
TIBABOT_API_URL=
TIBABOT_API_KEY=
TIBABOT_TIMEOUT=30
# User-identity JWT (dual-layer auth): HS256 shared secret, must match TibaBot facility key config
TIBABOT_JWT_SECRET=
TIBABOT_JWT_KID=tibabot-vitora-1
TIBABOT_JWT_ISSUER=vitora.nexora.africa
TIBABOT_JWT_AUDIENCE=tibabot-api
TIBABOT_JWT_EXPIRY_SECONDS=300
# Admin key for provisioning per-facility TibaBot keys via Django admin
TIBABOT_ADMIN_KEY=

# =============================================================================
# WebAuthn / Passkey (Windows Hello, Touch ID, security keys)
# =============================================================================
# RP ID must match the domain the browser sees (no port, no scheme)
WEBAUTHN_RP_ID=localhost
# Origin(s) the browser sends — comma-separate for multiple
WEBAUTHN_ORIGIN=http://localhost:3009

POWER_SYNC_URL=

# =============================================================================
# Web Push Notifications (VAPID)
# =============================================================================
# Generate keys: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:info@nexora.africa

# =============================================================================
# Sentry (strict privacy mode)
# =============================================================================
# Leave SENTRY_DSN empty to disable Sentry for this environment.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_MAX_BREADCRUMBS=50
SENTRY_DEBUG=false

# =============================================================================
# Paystack Subscription Billing
# =============================================================================
# Keep PAYSTACK_SECRET_KEY server-side. Callback is the frontend return page;
# webhook is the signed backend endpoint configured in the Paystack dashboard.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3009/account-billing?payment=returned
PAYSTACK_WEBHOOK_URL=
# Comma-separated frontend origins. For Cloudflare Quick Tunnels use the exact
# ephemeral https://<name>.trycloudflare.com origin.
CSRF_TRUSTED_ORIGINS=http://localhost:3009
CORS_ALLOWED_ORIGINS=http://localhost:3009
