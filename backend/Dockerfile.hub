# Dockerfile for Vitora HMIS Compiled Hub
# Phase 4: Distribution Hardening — Containerised delivery
#
# This image contains Nuitka-compiled binaries (no readable Python source).
# Pulled from registry.vitora.digital with license JWT authentication.
#
# Build context should be the backend/ directory with build/payload/ populated.

ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

# Build argument for version tagging
ARG VERSION=dev

# Labels
LABEL org.opencontainers.image.title="Vitora HMIS Hub" \
      org.opencontainers.image.description="Compiled hub for on-premises deployment" \
      org.opencontainers.image.vendor="Nexora Consulting Ltd" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="Proprietary"

# System dependencies (minimal for compiled Python + gunicorn/daphne)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libffi8 \
    libssl3 \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated unprivileged user
RUN groupadd -r vitora && useradd -r -g vitora -d /opt/vitora-hub -s /sbin/nologin vitora

# Application directory
WORKDIR /opt/vitora-hub

# Install Python dependencies first (layer caching)
COPY build/payload/requirements-hub.txt ./requirements-hub.txt
RUN pip install --no-cache-dir --no-compile -r requirements-hub.txt \
    && pip install --no-cache-dir gunicorn daphne

# Copy compiled application payload
COPY build/payload/ ./

# Write version file
RUN echo "${VERSION}" > VERSION

# Ensure proper ownership — root owns files (read-only for app user)
RUN chown -R root:vitora /opt/vitora-hub \
    && chmod -R 750 /opt/vitora-hub \
    && find /opt/vitora-hub -type f -name "*.so" -exec chmod 550 {} \;

# Create writable directories for runtime data
RUN mkdir -p /var/lib/vitora-hub /var/log/vitora-hub \
    && chown vitora:vitora /var/lib/vitora-hub /var/log/vitora-hub

# Data volume for SQLite DB and license token
VOLUME ["/var/lib/vitora-hub"]

# Environment defaults
ENV DJANGO_SETTINGS_MODULE=hmis.settings.production \
    DJANGO_ENV=hub \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=9088 \
    HUB_LICENSE_TOKEN_PATH=/var/lib/vitora-hub/license.jwt \
    DATABASE_URL=sqlite:////var/lib/vitora-hub/db.sqlite3

# Expose the API port
EXPOSE 9088

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:9088/api/health/ || exit 1

# Run as unprivileged user
USER vitora

# Use tini as init (reaps zombies, forwards signals)
ENTRYPOINT ["tini", "--"]

# Default: run migrations then start gunicorn
CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn hmis.wsgi:application --bind 0.0.0.0:${PORT} --workers 3 --timeout 120 --access-logfile - --error-logfile -"]
