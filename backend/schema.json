      - in: query
        name: end_date
        schema:
          type: string
          format: date
        description: End date (YYYY-MM-DD)
        required: true
      - in: query
        name: granularity
        schema:
          type: string
        description: '''day'', ''week'', or ''month'''
      - in: query
        name: refresh
        schema:
          type: boolean
        description: Bypass cache
      - in: query
        name: start_date
        schema:
          type: string
          format: date
        description: Start date (YYYY-MM-DD)
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
