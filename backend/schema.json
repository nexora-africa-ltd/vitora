  /api/triage/breaches/:
    get:
      operationId: api_triage_breaches_list
      description: |-
        ViewSet for wait time breach alerts.

        Read-only listing with acknowledge and resolve actions.
      parameters:
      - in: query
        name: assigned_area
        schema:
          type: string
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: severity
        schema:
          type: string
          enum:
          - CRITICAL
          - INFO
          - URGENT
          - WARNING
        description: |-
          Severity derived from triage category

          * `CRITICAL` - Critical – RED category breach (> 0 min)
          * `URGENT` - Urgent – ORANGE category breach (> 10 min)
          * `WARNING` - Warning – YELLOW category breach (> 60 min)
          * `INFO` - Informational – GREEN/BLUE category breach
      - in: query
        name: status
        schema:
          type: string
          enum:
          - ACKNOWLEDGED
          - ACTIVE
          - ESCALATED
          - RESOLVED
        description: |-
          * `ACTIVE` - Active – Unacknowledged
          * `ACKNOWLEDGED` - Acknowledged by staff
          * `ESCALATED` - Escalated to charge nurse/supervisor
          * `RESOLVED` - Resolved – Patient seen or left
      - in: query
        name: triage_category
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedWaitTimeBreachList'
          description: ''
