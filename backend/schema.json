  /api/triage/assessments/:
    get:
      operationId: api_triage_assessments_list
      description: |-
        ViewSet for TriageAssessment model.

        Provides CRUD operations with:
        - Auto-calculation of triage category
        - Alert generation
        - Queue integration
        - Audit logging
      parameters:
      - in: query
        name: assigned_area
        schema:
          type: string
          enum:
          - ER_ACUTE
          - ER_FAST_TRACK
          - ER_RESUS
          - MATERNITY
          - OBSERVATION
          - OPD
          - PEDIATRIC_ER
          - SPECIALTY
          - TRAUMA
        description: |-
          Emergency care area assignment (ER zones). Use for emergency cases.

          * `ER_RESUS` - ER - Resuscitation
          * `ER_ACUTE` - ER - Acute Care
          * `ER_FAST_TRACK` - ER - Fast Track
          * `OBSERVATION` - Observation Unit
          * `OPD` - Outpatient Department
          * `TRAUMA` - Trauma Bay
          * `PEDIATRIC_ER` - Pediatric ER
          * `MATERNITY` - Maternity/Labor
          * `SPECIALTY` - Specialty Clinic
      - in: query
        name: encounter
        schema:
          type: integer
      - in: query
        name: mental_status
        schema:
          type: string
          enum:
          - A
          - P
          - U
          - V
        description: |-
          AVPU mental status scale

          * `A` - Alert
          * `V` - Responds to Voice
          * `P` - Responds to Pain
          * `U` - Unresponsive
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: triage_category
        schema:
          type: string
          enum:
          - BLUE
          - GREEN
          - ORANGE
          - RED
          - YELLOW
        description: |-
          Final triage category

          * `RED` - Emergency - Immediate
          * `ORANGE` - Very Urgent - <10 min
          * `YELLOW` - Urgent - <60 min
          * `GREEN` - Standard - <240 min
          * `BLUE` - Non-Urgent/Referral
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedTriageAssessmentList'
          description: ''
    post:
      operationId: api_triage_assessments_create
      description: |-
        Create triage assessment with audit logging.

        Also updates the WaitingQueue entry to mark triage as complete.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TriageAssessmentCreateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TriageAssessmentCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TriageAssessmentCreateRequest'
        required: true
