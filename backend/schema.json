  /api/allergies/:
    get:
      operationId: api_allergies_list
      description: |-
        ViewSet for Allergy model.

        Provides CRUD operations for patient allergies with:
        - Automatic audit logging
        - Filtering by patient, substance type, severity, status
        - Drug-allergy interaction checking
        - Nested under patient or standalone access

        URL patterns:
        - /api/patients/{patient_id}/allergies/  (nested)
        - /api/allergies/  (standalone)
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: patient
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: severity
        schema:
          type: string
          enum:
          - life_threatening
          - mild
          - moderate
          - severe
        description: |-
          Severity of the allergic reaction

          * `mild` - Mild
          * `moderate` - Moderate
          * `severe` - Severe
          * `life_threatening` - Life-Threatening
      - in: query
        name: status
        schema:
          type: string
          enum:
          - active
          - inactive
          - resolved
        description: |-
          Current status of the allergy

          * `active` - Active
          * `inactive` - Inactive
          * `resolved` - Resolved
      - in: query
        name: substance_type
        schema:
          type: string
          enum:
          - biological
          - environmental
          - food
          - medication
          - other
        description: |-
          Category of allergen

          * `medication` - Medication
          * `food` - Food
          * `environmental` - Environmental
          * `biological` - Biological
          * `other` - Other
      - in: query
        name: verification_status
        schema:
          type: string
          enum:
          - confirmed
          - entered_in_error
          - presumed
          - refuted
          - unconfirmed
        description: |-
          Whether the allergy is confirmed or suspected

          * `unconfirmed` - Unconfirmed
          * `presumed` - Presumed
          * `confirmed` - Confirmed
          * `refuted` - Refuted
          * `entered_in_error` - Entered in Error
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAllergyListList'
          description: ''
    post:
      operationId: api_allergies_create
      description: Create an allergy record with audit logging.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AllergyRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AllergyRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AllergyRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Allergy'
          description: ''
  /api/allergies/{id}/:
    get:
      operationId: api_allergies_retrieve
      description: Retrieve an allergy with audit logging.
      parameters:
      - in: path
        name: id
