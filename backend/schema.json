  /api/mch/hei/{id}/determine_final_status/:
    post:
      operationId: api_mch_hei_determine_final_status_create
      description: |-
        Determine final HIV status based on PCR test results.

        Business rules:
        - If any PCR test is POSITIVE → CONFIRMED_POSITIVE
        - If all scheduled PCR tests (at least 2) are NEGATIVE → CONFIRMED_NEGATIVE
        - If tests are still PENDING or insufficient → remains ACTIVE

        When confirmed positive, auto-enrollment to CCC is triggered via signal.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this HEI Follow-Up.
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/HEIFollowUpRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/HEIFollowUpRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/HEIFollowUpRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HEIFollowUp'
          description: ''
