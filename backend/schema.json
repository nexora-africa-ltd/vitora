  /api/pharmacy/drugs/:
    get:
      operationId: api_pharmacy_drugs_list
      description: |-
        ViewSet for Drug model.

        Endpoints:
        - GET /api/pharmacy/drugs/ - List drugs with search and filtering
        - GET /api/pharmacy/drugs/{id}/ - Get drug details
        - POST /api/pharmacy/drugs/ - Create drug (admin only)
        - PATCH /api/pharmacy/drugs/{id}/ - Update drug (admin only)
        - DELETE /api/pharmacy/drugs/{id}/ - Delete drug (admin only)
      parameters:
      - in: query
        name: form
        schema:
          type: string
          enum:
          - CAPSULE
          - CREAM
          - DROPS
          - GEL
          - INHALER
          - INJECTION
          - OINTMENT
          - OTHER
          - PATCH
          - POWDER
          - SOLUTION
          - SPRAY
          - SUPPOSITORY
          - SUSPENSION
          - SYRUP
          - TABLET
          - UNIT
        description: |-
          * `TABLET` - Tablet
          * `CAPSULE` - Capsule
          * `SYRUP` - Syrup
          * `INJECTION` - Injection
          * `CREAM` - Cream
          * `OINTMENT` - Ointment
          * `DROPS` - Drops
          * `INHALER` - Inhaler
          * `SUPPOSITORY` - Suppository
          * `POWDER` - Powder
          * `SUSPENSION` - Suspension
          * `SOLUTION` - Solution
          * `GEL` - Gel
          * `PATCH` - Patch
          * `SPRAY` - Spray
          * `UNIT` - Unit/Piece
          * `OTHER` - Other
      - in: query
        name: is_active
        schema:
          type: boolean
      - in: query
        name: is_essential
        schema:
          type: boolean
      - in: query
        name: item_type
        schema:
          type: string
          enum:
          - CONSUMABLE
          - MEDICATION
          - REAGENT
        description: |-
          MEDICATION for drugs, CONSUMABLE for medical supplies, REAGENT for lab reagents

          * `MEDICATION` - Medication
          * `CONSUMABLE` - Consumable
          * `REAGENT` - Reagent
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: schedule
        schema:
          type: string
          enum:
          - CD
          - OTC
          - P
          - POM
        description: |-
          * `OTC` - Over The Counter
          * `POM` - Prescription Only Medicine
          * `P` - Pharmacy Only
          * `CD` - Controlled Drug
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDrugList'
          description: ''
