          type: string
          format: date
        round_time:
          type: string
          format: time
        conducted_by:
          type: integer
        review_type:
          allOf:
          - $ref: '#/components/schemas/WardRoundReviewTypeEnum'
          description: |-
            Type of review being conducted

            * `WARD_ROUND` - Scheduled Ward Round
            * `URGENT_REVIEW` - Urgent Review
            * `CONSULTANT_REVIEW` - Consultant Review
            * `TRANSFER_REVIEW` - Transfer Assessment
            * `PRE_DISCHARGE` - Pre-Discharge Assessment
        review_request:
          type: integer
          nullable: true
          description: Review request this ward round fulfills (if applicable)
        subjective:
          type: string
          minLength: 1
          description: Patient complaints, symptoms
        objective:
          type: string
          minLength: 1
          description: Examination findings, vitals, observations
        assessment:
          type: string
          minLength: 1
          description: Clinical assessment, diagnosis updates
        plan:
          type: string
          minLength: 1
          description: Treatment plan, orders, next steps
        temperature:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          nullable: true
          description: Temperature in °C
        pulse:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Pulse rate in BPM
        blood_pressure:
          type: string
          description: Blood pressure (e.g., '120/80')
          maxLength: 20
        respiratory_rate:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Respiratory rate in breaths/min
        spo2:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Oxygen saturation percentage
        gcs_total:
          type: integer
          maximum: 15
          minimum: 3
          nullable: true
          description: Glasgow Coma Scale total score (3-15)
        on_vasopressors:
          type: boolean
          nullable: true
          description: Whether patient is currently on vasopressor support
        vasopressor_dose_mcg_kg_min:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,3})?$
          nullable: true
          description: Current vasopressor dose in mcg/kg/min where known
        on_mechanical_ventilation:
          type: boolean
          nullable: true
          description: Whether patient is currently mechanically ventilated
        urine_output_ml_24h:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Estimated or measured total urine output in the last 24 hours
            (mL)
        maternity_continuity_action:
          allOf:
          - $ref: '#/components/schemas/MaternityContinuityActionEnum'
          description: |-
            Planned postpartum continuity step captured during ward review

            * `NONE` - No Continuity Action
            * `CONTINUE_POSTPARTUM_OBSERVATION` - Continue Postpartum Observation
            * `SCHEDULE_EARLY_PNC` - Schedule Early PNC
            * `ROUTE_TO_PNC_QUEUE` - Route To PNC Queue
        maternity_continuity_notes:
          type: string
