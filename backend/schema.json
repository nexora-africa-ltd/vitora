          type: string
          description: Floor/level
          maxLength: 20
        capacity:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Number of patients that can be seen simultaneously
        department:
          type: integer
          nullable: true
          description: Department this clinic belongs to (e.g., Outpatient, MCH)
        department_name:
          type: string
          readOnly: true
        status:
          $ref: '#/components/schemas/ClinicStatusEnum'
        status_display:
          type: string
          readOnly: true
        requires_appointment:
          type: boolean
          description: Whether patients need prior appointment
        requires_referral:
          type: boolean
          description: Whether patients need referral from another clinic
        accepts_walk_ins:
          type: boolean
          description: Whether walk-in patients are accepted
        triage_required:
          type: boolean
