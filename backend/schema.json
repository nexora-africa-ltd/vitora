      description: Serializer for vital thresholds.
      properties:
        id:
          type: integer
          readOnly: true
        vital_type:
          allOf:
          - $ref: '#/components/schemas/VitalTypeEnum'
          description: |-
            Type of vital sign

            * `SPO2` - Oxygen Saturation (%)
            * `SYSTOLIC_BP` - Systolic Blood Pressure (mmHg)
            * `DIASTOLIC_BP` - Diastolic Blood Pressure (mmHg)
            * `HEART_RATE` - Heart Rate (bpm)
            * `TEMPERATURE` - Temperature (°C)
            * `RESPIRATORY_RATE` - Respiratory Rate (breaths/min)
        critical_low:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Value below this triggers critical alert
        warning_low:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Value below this triggers warning
        warning_high:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Value above this triggers warning
        critical_high:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Value above this triggers critical alert
        is_active:
          type: boolean
          description: Whether this threshold is active
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
