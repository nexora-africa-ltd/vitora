      - code
      - created_at
      - daily_rate
      - id
      - name
      - occupancy_rate
      - occupied_beds
      - total_beds
      - updated_at
      - ward_type
      - ward_type_display
    InpatientWardRequest:
      type: object
      description: Serializer for Ward model (inpatient-specific with occupancy stats).
      properties:
        name:
          type: string
          minLength: 1
          description: Ward name (e.g., 'Medical Ward 1'), unique per facility
          maxLength: 100
        code:
          type: string
          minLength: 1
          description: Ward code (e.g., 'MED-01'), unique per facility
          maxLength: 20
        ward_type:
          allOf:
          - $ref: '#/components/schemas/WardTypeEnum'
          description: |-
            Type of ward

            * `MEDICAL` - Medical Ward
            * `SURGICAL` - Surgical Ward
            * `PEDIATRIC` - Pediatric Ward
            * `MATERNITY` - Maternity Ward
            * `HDU` - High Dependency Unit
            * `ICU` - Intensive Care Unit
            * `NBU` - Newborn Unit
            * `ISOLATION` - Isolation Ward
        floor:
          type: string
          description: Floor location
          maxLength: 50
        capacity:
          type: integer
          maximum: 9223372036854775807
          minimum: 1
          format: int64
          description: Total bed count (must be positive)
        description:
          type: string
          description: Ward description
        is_active:
          type: boolean
          description: Whether ward is currently active
        daily_rate:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          description: Bed charge per day (must be positive)
        gender_restriction:
          allOf:
          - $ref: '#/components/schemas/GenderRestrictionEnum'
          description: |-
            Gender restriction for patient admission

            * `ANY` - Any Gender
            * `MALE_ONLY` - Male Only
            * `FEMALE_ONLY` - Female Only
        min_age_years:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Minimum patient age in years (null = no minimum)
        max_age_years:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Maximum patient age in years (null = no maximum)
        isolation_capable:
          type: boolean
          description: Whether ward can handle isolation patients
        oxygen_equipped:
          type: boolean
          description: Whether beds have oxygen supply
        ventilator_capable:
          type: boolean
          description: Whether ward supports ventilated patients
        maternity_designated:
          type: boolean
          description: Whether ward is designated for maternity patients (enforces
            female-only admission)
        emergency_buffer_percent:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Percentage of beds reserved for emergency admissions (0-100)
