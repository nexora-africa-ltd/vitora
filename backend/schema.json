        schema:
          type: integer
      - in: query
        name: rule_type
        schema:
          type: string
          enum:
          - 10X
          - 1_2S
          - 1_3S
          - 2_2S
          - 4_1S
          - CUSTOM
          - R_4S
        description: |-
          Westgard rule type

          * `1_2S` - 1-2s (Warning)
          * `1_3S` - 1-3s (Reject)
          * `2_2S` - 2-2s (Reject)
          * `R_4S` - R-4s (Reject)
          * `4_1S` - 4-1s (Reject)
          * `10X` - 10x (Reject)
          * `CUSTOM` - Custom Rule
