          type: string
          nullable: true
          description: Get room name.
          readOnly: true
        clinic:
          type: integer
          readOnly: true
          nullable: true
          description: Clinic associated with this shift (set at clock-in)
        clinic_name:
          type: string
          nullable: true
          description: Get clinic name.
          readOnly: true
