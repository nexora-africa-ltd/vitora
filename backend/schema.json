          nullable: true
          description: Timestamp when chief complaint was edited
        assigned_clinician:
          type: integer
          readOnly: true
        assigned_clinician_username:
          type: string
          readOnly: true
          nullable: true
        assigned_clinician_name:
          type: string
          nullable: true
