          type: integer
          maximum: 300
          minimum: 0
          nullable: true
          description: Heart rate (beats per minute)
        systolic_bp:
          type: integer
          maximum: 300
          minimum: 0
          nullable: true
          description: Systolic blood pressure (mmHg)
        diastolic_bp:
          type: integer
          maximum: 200
          minimum: 0
          nullable: true
          description: Diastolic blood pressure (mmHg)
        temperature:
          type: number
          format: double
          nullable: true
        respiratory_rate:
          type: integer
          maximum: 60
          minimum: 0
          nullable: true
          description: Respiratory rate (breaths per minute)
        weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Body weight in kilograms (kg)
        height:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Body height in centimeters (cm)
        etat_danger_signs:
          description: 'ETAT danger signs present (list of strings). Valid values:
            unable_to_drink, convulsions, lethargy, chest_indrawing, stridor, severe_malnutrition,
            grunting, cyanosis, severe_pallor, hypothermia'
        dehydration_level:
          allOf:
          - $ref: '#/components/schemas/DehydrationLevelEnum'
          description: |-
            WHO dehydration classification (children)

            * `NONE` - No dehydration
            * `SOME` - Some dehydration
            * `SEVERE` - Severe dehydration
        fontanelle_status:
          allOf:
          - $ref: '#/components/schemas/FontanelleStatusEnum'
          description: |-
            Anterior fontanelle status (for infants <18 months)

            * `NORMAL` - Normal
            * `BULGING` - Bulging
            * `SUNKEN` - Sunken
        breastfeeding_ability:
          allOf:
          - $ref: '#/components/schemas/BreastfeedingAbilityEnum'
          description: |-
            Breastfeeding / feeding ability (for infants)

            * `NORMAL` - Normal / able to feed
            * `REDUCED` - Reduced / poor feeding
            * `UNABLE` - Unable to breastfeed / drink
        capillary_refill_seconds:
          type: integer
          maximum: 15
          minimum: 0
          nullable: true
          description: Capillary refill time in seconds (prolonged ≥3s is abnormal)
        muac_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          nullable: true
          description: Mid-Upper Arm Circumference in cm (SAM <11.5, MAM 11.5-12.4)
        triage_category:
          allOf:
          - $ref: '#/components/schemas/TriageCategoryEnum'
          description: |-
            Final triage category

            * `RED` - Emergency - Immediate
            * `ORANGE` - Very Urgent - <10 min
            * `YELLOW` - Urgent - <60 min
            * `GREEN` - Standard - <240 min
            * `BLUE` - Non-Urgent/Referral
        category_override_reason:
          type: string
          description: Required if nurse overrides system suggestion
        assigned_area:
          allOf:
          - $ref: '#/components/schemas/AssignedAreaEnum'
          description: |-
            Emergency care area assignment (ER zones). Use for emergency cases.

            * `ER_RESUS` - ER - Resuscitation
            * `ER_ACUTE` - ER - Acute Care
            * `ER_FAST_TRACK` - ER - Fast Track
            * `OBSERVATION` - Observation Unit
            * `OPD` - Outpatient Department
            * `TRAUMA` - Trauma Bay
            * `PEDIATRIC_ER` - Pediatric ER
            * `MATERNITY` - Maternity/Labor
            * `SPECIALTY` - Specialty Clinic
        assigned_clinic:
          type: integer
          nullable: true
          description: Target clinic for routing. Mutually exclusive with assigned_area.
        assigned_clinician:
          type: integer
          nullable: true
          description: Clinician assigned to this patient
        arrival_time:
          type: string
          format: date-time
          description: When patient arrived at facility
        triage_start_time:
          type: string
          format: date-time
          description: When triage assessment began
        triage_end_time:
          type: string
          format: date-time
          nullable: true
          description: When triage completed
        seen_by_clinician_time:
          type: string
          format: date-time
          nullable: true
          description: When patient was seen by clinician
      required:
      - arrival_time
