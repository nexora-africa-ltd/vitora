          type: string
          format: date
          readOnly: true
        period_end:
          type: string
          format: date
          readOnly: true
        quantity_dispensed:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          description: Total quantity dispensed in the period.
        quantity_transferred:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          description: Net transfer quantity (out - in) in the period.
        quantity_adjusted:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          description: Net adjustment quantity (damage, loss, expiry) in the period.
        total_consumption:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
        average_daily_consumption:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,4})?$
          readOnly: true
        facility:
          type: integer
          readOnly: true
          nullable: true
          description: Facility (branch) where this record was created.
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - average_daily_consumption
      - created_at
      - drug
      - drug_name
