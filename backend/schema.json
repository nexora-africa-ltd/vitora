openapi: 3.0.3
info:
  title: Vitora HMIS API
  version: 0.1.0
  description: Hospital Management Information System for Kenya
paths:
  /api/auditlogs/:
    get:
      operationId: api_auditlogs_list
      description: |-
        ViewSet for viewing audit logs (read-only).

        Only accessible by superusers.
      parameters:
      - in: query
        name: action
        schema:
          type: string
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: resource_type
        schema:
          type: string
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: user
        schema:
          type: integer
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAuditLogList'
          description: ''
  /api/auditlogs/{id}/:
    get:
      operationId: api_auditlogs_retrieve
      description: |-
        ViewSet for viewing audit logs (read-only).

        Only accessible by superusers.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this Audit Log.
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuditLog'
          description: ''
  /api/billing/claims/:
    get:
      operationId: api_billing_claims_list
      description: |-
        ViewSet for SHA Claims management.

        Provides CRUD operations for claims with validation, submission, and appeal workflows.
      parameters:
      - in: query
        name: claim_type
        schema:
          type: string
      - in: query
        name: encounter
        schema:
          type: integer
      - in: query
        name: format
        schema:
          type: string
          enum:
          - csv
          - json
          - xlsx
      - in: query
        name: invoice
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: patient
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSHAClaimList'
            text/csv:
              schema:
                $ref: '#/components/schemas/PaginatedSHAClaimList'
            application/vnd.openxmlformats-officedocument.spreadsheetml.sheet:
              schema:
                $ref: '#/components/schemas/PaginatedSHAClaimList'
          description: ''
    post:
      operationId: api_billing_claims_create
      description: |-
        ViewSet for SHA Claims management.

        Provides CRUD operations for claims with validation, submission, and appeal workflows.
      parameters:
      - in: query
        name: format
        schema:
          type: string
          enum:
          - csv
          - json
          - xlsx
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SHAClaimRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SHAClaimRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SHAClaimRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SHAClaim'
            text/csv:
              schema:
                $ref: '#/components/schemas/SHAClaim'
            application/vnd.openxmlformats-officedocument.spreadsheetml.sheet:
              schema:
                $ref: '#/components/schemas/SHAClaim'
          description: ''
