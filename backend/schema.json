      operationId: api_kenhdd_elements_list
      description: |-
        ViewSet for KENHDD data element definitions (read-only).
        Definitions are seeded via the ``seed_kenhdd_elements`` command.
      parameters:
      - in: query
        name: data_type
        schema:
          type: string
          enum:
          - BOOLEAN
          - CODED
          - DATE
          - DECIMAL
          - IDENTIFIER
          - INTEGER
          - STRING
        description: |-
          Expected data type

          * `STRING` - String
          * `DATE` - Date
          * `INTEGER` - Integer
          * `DECIMAL` - Decimal
          * `CODED` - Coded
          * `BOOLEAN` - Boolean
          * `IDENTIFIER` - Identifier
      - in: query
        name: is_active
        schema:
          type: boolean
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: requirement_level
        schema:
          type: string
          enum:
          - CONDITIONAL
          - MANDATORY
          - OPTIONAL
        description: |-
          Whether this element is mandatory, conditional, or optional

          * `MANDATORY` - Mandatory
          * `CONDITIONAL` - Conditional
          * `OPTIONAL` - Optional
      - in: query
        name: resource_type
        schema:
          type: string
          enum:
          - DIAGNOSIS
          - ENCOUNTER
          - FACILITY
          - LAB_RESULT
          - MCH_VISIT
          - PATIENT
          - PRESCRIPTION
        description: |-
          Resource type this element applies to

          * `PATIENT` - Patient
          * `ENCOUNTER` - Encounter
          * `DIAGNOSIS` - Diagnosis
          * `FACILITY` - Facility
          * `LAB_RESULT` - Lab Result
          * `PRESCRIPTION` - Prescription
          * `MCH_VISIT` - MCH Visit
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedKENHDDDataElementList'
          description: ''
