        name: identification_type
        schema:
          type: string
        description: '''National ID'' or ''passport'''
      - in: query
        name: license_number
        schema:
          type: string
        description: License number (alias for registration_number)
      - in: query
        name: registration_number
        schema:
          type: string
        description: Registration number (PUID)
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PractitionerSearchResponse'
          description: ''
