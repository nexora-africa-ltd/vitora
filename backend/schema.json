    DeathRecordCreate:
      type: object
      description: Serializer for creating a death record.
      properties:
        patient:
          type: integer
          description: The deceased patient
        date_of_death:
          type: string
          format: date
          description: Date of death
        time_of_death:
          type: string
          format: time
          nullable: true
          description: Time of death (if known)
        manner_of_death:
          allOf:
          - $ref: '#/components/schemas/MannerOfDeathEnum'
          description: |-
            Manner of death

            * `NATURAL` - Natural
            * `ACCIDENT` - Accident
            * `SUICIDE` - Suicide
            * `HOMICIDE` - Homicide
            * `UNDETERMINED` - Undetermined
            * `PENDING_INVESTIGATION` - Pending Investigation
        place_of_death:
          allOf:
          - $ref: '#/components/schemas/PlaceOfDeathEnum'
          description: |-
            Where the death occurred

            * `INPATIENT` - Inpatient Ward
            * `EMERGENCY` - Emergency Department
            * `THEATRE` - Operating Theatre
            * `ICU` - Intensive Care Unit
            * `BROUGHT_IN_DEAD` - Brought in Dead (BID)
            * `OTHER` - Other
        place_of_death_detail:
          type: string
          description: Ward name, room number, or other detail
          maxLength: 200
        notification_source:
          allOf:
          - $ref: '#/components/schemas/NotificationSourceEnum'
          description: |-
            How this death record was initiated

            * `INPATIENT_DISCHARGE` - Inpatient Discharge
            * `EMERGENCY` - Emergency Department
            * `MANUAL_ENTRY` - Manual Entry
            * `CLIENT_REGISTRY` - Client Registry Sync
        primary_cause:
          type: string
          description: Immediate cause of death (Line a)
        primary_cause_icd10:
          type: integer
          nullable: true
          description: ICD-10 code for primary cause of death
        antecedent_cause:
          type: string
          description: Due to / antecedent cause (Line b)
        antecedent_cause_icd10:
          type: integer
          nullable: true
          description: ICD-10 code for antecedent cause
        underlying_cause:
          type: string
          description: Underlying cause of death (Line c)
        underlying_cause_icd10:
          type: integer
          nullable: true
          description: ICD-10 code for underlying cause
        contributing_conditions:
          type: string
          description: Other significant conditions contributing to death (Part II)
        admission:
          type: integer
          nullable: true
          description: Linked inpatient admission (if died while admitted)
        encounter:
          type: integer
          nullable: true
          description: Linked encounter (if died during visit)
        morgue_compartment:
          type: string
          description: Morgue compartment/refrigerator number
          maxLength: 50
        notes:
          type: string
          description: Additional notes
      required:
      - date_of_death
      - patient
      - primary_cause
