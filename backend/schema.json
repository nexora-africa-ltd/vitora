    PatchedAdmissionRecommendationRequest:
      type: object
      description: Serializer for AdmissionRecommendation model.
      properties:
        encounter:
          type: integer
          description: OPD encounter that generated this recommendation
        recommended_by:
          type: integer
          description: Clinician making the recommendation
        reason:
          type: string
          minLength: 1
          description: Clinical reason for admission
        provisional_diagnosis:
          type: string
          minLength: 1
          description: ICD-10 code for provisional diagnosis
          maxLength: 10
        provisional_diagnosis_text:
          type: string
          minLength: 1
          description: Text description of diagnosis
          maxLength: 255
        urgency:
          allOf:
          - $ref: '#/components/schemas/AdmissionUrgencyPriorityEnum'
          description: |-
            Urgency level

            * `ROUTINE` - Routine
            * `URGENT` - Urgent
            * `EMERGENCY` - Emergency
        preferred_ward_type:
          type: string
          description: Preferred ward type (optional)
          maxLength: 20
        expires_at:
          type: string
          format: date-time
          description: Expiration time (default 24 hours from creation)
        decline_reason:
          type: string
          description: Reason if recommendation was declined
    PatchedAdmissionRequest:
      type: object
      description: |-
        Serializer for Admission model.

        Supports automatic bed assignment via `auto_assign_bed=true` in request body.
        When auto_assign_bed is true, the `bed` field becomes optional as the system
        will automatically select the first available bed in the ward.
      properties:
        patient:
          type: integer
          description: Patient being admitted
        opd_encounter:
          type: integer
          nullable: true
          description: OPD encounter that led to admission (if applicable)
        recommendation:
          type: integer
          nullable: true
          description: Admission recommendation (if from OPD)
        admission_date:
          type: string
          format: date-time
          description: Date and time of admission
        admitting_diagnosis:
          type: string
          minLength: 1
          description: ICD-10 code for admitting diagnosis
          maxLength: 10
        admitting_diagnosis_text:
          type: string
          minLength: 1
          description: Text description of diagnosis
          maxLength: 255
        admitting_officer:
          type: integer
          description: User who processed the admission
        attending_doctor:
          type: integer
          nullable: true
          description: Doctor attending the patient
        ward:
          type: integer
          description: Ward where patient is admitted
        bed:
          type: integer
          nullable: true
          description: Bed ID. Optional when auto_assign_bed=true is provided.
        payer_type:
          allOf:
          - $ref: '#/components/schemas/PayerTypeEnum'
          description: |-
            Type of payer

            * `CASH` - Cash
            * `SHA` - SHA Insurance
            * `CORPORATE` - Corporate
        insurance_details:
          description: Insurance information (for SHA/Corporate)
        constraint_override_reason:
          type: string
          description: Reason for overriding compatibility constraints
    PatchedAnalyzerRunRequest:
      type: object
      description: Serializer for analyzer runs.
      properties:
        specimen:
          type: integer
          description: Specimen this run is for
        instrument:
          type: integer
          description: Instrument that produced this run
        operator:
          type: integer
          nullable: true
          description: Lab technician operating the instrument (null for automated
            runs)
        run_datetime:
          type: string
          format: date-time
          description: When the analyzer run occurred
        raw_message:
          type: string
          minLength: 1
          description: Raw HL7/ASTM/FHIR message from instrument
        raw_payload:
          description: Parsed message data in structured format
        status:
          allOf:
          - $ref: '#/components/schemas/AnalyzerRunStatusEnum'
          description: |-
            Processing status of this run

            * `RECEIVED` - Message Received
            * `PARSED` - Parsed Successfully
            * `APPLIED` - Results Applied
            * `ERROR` - Parse Error
        error_message:
          type: string
          description: Error details if parsing failed
    PatchedAppointmentRequest:
      type: object
      description: Serializer for Appointment model.
      properties:
        patient:
          type: integer
          description: Patient for this appointment
        resource:
          type: integer
          description: Scheduled resource
        appointment_type:
          allOf:
          - $ref: '#/components/schemas/AppointmentTypeEnum'
          description: |-
            Type of appointment

            * `CONSULTATION` - Consultation
            * `FOLLOW_UP` - Follow-up
            * `PROCEDURE` - Procedure
            * `LAB_TEST` - Laboratory Test
            * `IMAGING` - Imaging/Radiology
            * `VACCINATION` - Vaccination
            * `THERAPY` - Therapy Session
            * `OTHER` - Other
        scheduled_start:
          type: string
          format: date-time
          description: Scheduled start datetime
        scheduled_end:
          type: string
          format: date-time
          description: Scheduled end datetime
        status:
          allOf:
          - $ref: '#/components/schemas/SchedulingStatusEnum'
          description: |-
            Current appointment status

            * `CREATED` - Created
            * `CONFIRMED` - Confirmed
            * `CHECKED_IN` - Checked In
            * `IN_PROGRESS` - In Progress
            * `COMPLETED` - Completed
            * `CANCELLED` - Cancelled
            * `NO_SHOW` - No Show
        reason:
          type: string
          minLength: 1
          description: Reason for appointment
        notes:
          type: string
          description: Additional notes
        priority:
          allOf:
          - $ref: '#/components/schemas/AdmissionUrgencyPriorityEnum'
          description: |-
            Appointment priority

            * `ROUTINE` - Routine
            * `URGENT` - Urgent
            * `EMERGENCY` - Emergency
    PatchedAssignmentOverrideRequest:
      type: object
      description: Serializer for AssignmentOverride model.
      properties:
        target_type:
          type: string
          minLength: 1
          description: Model name of the target (e.g., Appointment)
          maxLength: 100
        target_id:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          description: ID of the target object
        original_resource:
          type: integer
          nullable: true
          description: Originally assigned resource (null if was unassigned)
        new_resource:
          type: integer
          description: Newly assigned resource
        override_reason:
          allOf:
          - $ref: '#/components/schemas/OverrideReasonEnum'
          description: |-
            Category of override reason

            * `PATIENT_REQUEST` - Patient Request
            * `STAFF_UNAVAILABLE` - Staff Unavailable
            * `EMERGENCY` - Emergency Situation
            * `SPECIALIZATION_NEEDED` - Specialization Required
            * `LOAD_BALANCING` - Load Balancing
            * `ADMINISTRATIVE` - Administrative Decision
            * `OTHER` - Other
        justification:
          type: string
          minLength: 1
          description: Detailed justification for the override (required)
        requires_approval:
          type: boolean
          description: Whether this override requires supervisor approval
    PatchedAssignmentRuleRequest:
      type: object
      description: Serializer for AssignmentRule model.
      properties:
        name:
          type: string
          minLength: 1
          description: Human-readable rule name
          maxLength: 200
        rule_code:
          type: string
          minLength: 1
          description: Unique rule identifier (e.g., assign_doctor_to_opd)
          maxLength: 100
        applies_to:
          allOf:
          - $ref: '#/components/schemas/AppliesToEnum'
          description: |-
            Type of assignment this rule applies to

            * `APPOINTMENT` - Doctor to Appointment
            * `SHIFT` - Staff to Shift
            * `BED_ASSIGNMENT` - Bed to Admission
            * `LAB_BATCH` - Lab Technician to Test Batch
            * `THEATRE_SLOT` - Theatre to Procedure
        rule_definition:
          description: Rule definition in DSL format (JSON)
        version:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Rule version for tracking changes
        priority:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          description: Priority for rule ordering (higher = evaluated first)
        is_active:
          type: boolean
          description: Whether rule is currently active
        effective_from:
          type: string
          format: date
          description: When rule becomes effective
        effective_until:
          type: string
          format: date
          nullable: true
          description: When rule expires (null = indefinite)
        description:
          type: string
          description: Detailed description of what this rule does
    PatchedBedRequest:
      type: object
      description: Serializer for Bed model.
      properties:
        ward:
          type: integer
          description: Parent ward
        bed_number:
          type: string
          minLength: 1
          description: Bed identifier (e.g., 'B-101')
          maxLength: 20
        status:
          allOf:
          - $ref: '#/components/schemas/BedStatusEnum'
          description: |-
            Current bed status

            * `AVAILABLE` - Available
            * `OCCUPIED` - Occupied
            * `MAINTENANCE` - Under Maintenance
            * `RESERVED` - Reserved
        notes:
          type: string
          description: Additional notes (maintenance reason, etc.)
        status_changed_by:
          type: integer
          nullable: true
          description: User who changed status
    PatchedClinicEnrollmentRequest:
      type: object
      description: Serializer for ClinicEnrollment model with full chronic care fields.
      properties:
        clinic:
          type: integer
        patient:
          type: integer
        enrollment_number:
          type: string
          description: Clinic-specific ID (e.g., CCC number, ANC number)
          maxLength: 50
        enrollment_date:
          type: string
          format: date
          description: Date of enrollment
        status:
          $ref: '#/components/schemas/ClinicEnrollmentStatusEnum'
        enrollment_data:
          nullable: true
          description: "\n        Clinic-specific enrollment data. Examples:\n\n        CCC:
            {\n            \"art_start_date\": \"2024-01-15\",\n            \"current_regimen\":
            \"TDF/3TC/DTG\",\n            \"who_stage\": 2,\n            \"cd4_baseline\":
            350\n        }\n\n        ANC: {\n            \"lmp\": \"2025-09-01\",\n
            \           \"edd\": \"2026-06-08\",\n            \"gravida\": 2,\n            \"parity\":
            1\n        }\n\n        Diabetic: {\n            \"diagnosis_date\": \"2020-05-15\",\n
            \           \"diabetes_type\": \"Type 2\",\n            \"current_medications\":
            [\"Metformin 500mg BD\"]\n        }\n        "
        next_appointment:
          type: string
          format: date
          nullable: true
          description: Next scheduled visit
        appointment_interval_days:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Default days between appointments
        outcome_date:
          type: string
          format: date
          nullable: true
          description: Date of outcome (completion, transfer, etc.)
        outcome_reason:
          type: string
          description: Reason for outcome
        transfer_facility:
          type: string
          description: Facility transferred to (if applicable)
          maxLength: 200
        art_start_date:
          type: string
          format: date
          nullable: true
          description: Date ART was initiated
        current_art_regimen:
          type: string
          description: Current ART regimen (e.g., TDF/3TC/DTG)
          maxLength: 100
        art_regimen_line:
          allOf:
          - $ref: '#/components/schemas/ArtRegimenLineEnum'
          description: |-
            ART regimen line

            * `FIRST_LINE` - First Line
            * `SECOND_LINE` - Second Line
            * `THIRD_LINE` - Third Line
        who_clinical_stage:
          allOf:
          - $ref: '#/components/schemas/WhoClinicalStageEnum'
          nullable: true
          description: |-
            WHO clinical stage at enrollment

            * `1` - Stage 1
            * `2` - Stage 2
            * `3` - Stage 3
            * `4` - Stage 4
          minimum: 0
          maximum: 9223372036854775807
        baseline_cd4_count:
