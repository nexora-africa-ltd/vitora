          allOf:
          - $ref: '#/components/schemas/SiteEnum'
          default: ''
        vaccine_manufacturer:
          type: string
          default: ''
        diluent_batch_number:
          type: string
          default: ''
        diluent_manufacturer:
          type: string
          default: ''
        diluent_expiry_date:
          type: string
          format: date
          nullable: true
        notes:
          type: string
          default: ''
    AdministerVaccineRequest:
      type: object
      description: |-
