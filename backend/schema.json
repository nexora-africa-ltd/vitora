  /api/lab/analyzers/messages/:
    get:
      operationId: api_lab_analyzers_messages_list
      description: |-
        Read-only ViewSet for analyzer messages (audit trail).

        Messages are created via the ingest endpoint or by Celery tasks,
        not directly by users.
      parameters:
      - in: query
        name: channel
        schema:
          type: number
      - in: query
        name: direction
        schema:
          type: string
          enum:
          - INBOUND
          - OUTBOUND
        description: |-
          * `INBOUND` - Instrument → Host
          * `OUTBOUND` - Host → Instrument
      - in: query
        name: instrument
        schema:
          type: number
      - in: query
        name: message_type
        schema:
          type: string
          enum:
          - ACK
          - ACK_HL7
          - ERROR
          - NAK
          - ORDER_DOWNLOAD
          - ORM
          - ORU
          - QRY
          - QUERY
          - RAW
          - RESULT
          - STATUS
        description: |-
          * `QUERY` - Host Query (work order request)
          * `RESULT` - Result Upload
          * `ACK` - Acknowledgement
          * `NAK` - Negative Acknowledgement
          * `ORDER_DOWNLOAD` - Order Download (work order)
          * `ORM` - Order Message (ORM^O01)
          * `ORU` - Result Message (ORU^R01)
          * `QRY` - Query Message
          * `ACK_HL7` - HL7 Acknowledgement
          * `STATUS` - Status/Heartbeat
          * `ERROR` - Error Message
          * `RAW` - Raw/Unknown
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: sample_id
        schema:
          type: string
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: specimen
        schema:
          type: number
      - in: query
        name: status_filter
        schema:
          type: string
          enum:
          - APPLIED
          - FAILED
          - PARSED
          - PENDING
          - RECEIVED
          - REJECTED
          - SENT
          - TIMEOUT
        description: |-
          * `PENDING` - Pending Processing
          * `SENT` - Sent to Instrument
          * `RECEIVED` - Received from Instrument
          * `PARSED` - Parsed Successfully
          * `APPLIED` - Results Applied to Lab Order
          * `FAILED` - Processing Failed
          * `REJECTED` - Rejected by Instrument (NAK)
          * `TIMEOUT` - Timed Out
      - in: query
        name: timestamp_after
        schema:
          type: string
          format: date-time
      - in: query
        name: timestamp_before
        schema:
          type: string
          format: date-time
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAnalyzerMessageListList'
          description: ''
  /api/lab/analyzers/messages/{id}/:
    get:
      operationId: api_lab_analyzers_messages_retrieve
      description: |-
        Read-only ViewSet for analyzer messages (audit trail).

        Messages are created via the ingest endpoint or by Celery tasks,
        not directly by users.
      parameters:
      - in: path
        name: id
