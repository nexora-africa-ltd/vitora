        {
            "claim_reference": "SHA-CLM-2026-001",
            "status": "approved|rejected|pending",
            "outcome": "complete|queued|error",
            "disposition": "Reason text",
            "approved_amount": 1500.00,
            "payment_reference": "PAY-xxx"
