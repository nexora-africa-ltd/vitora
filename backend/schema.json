    ClinicalComment:
      type: object
      description: Read serializer for clinical comments (list/retrieve).
      properties:
        id:
          type: integer
          readOnly: true
        parent:
          type: integer
          readOnly: true
          nullable: true
          description: Parent comment for threading. Null = top-level comment.
        author:
          allOf:
          - $ref: '#/components/schemas/CommentAuthor'
          readOnly: true
        body:
          type: string
          readOnly: true
          description: Comment text. Supports @username mentions.
        display_body:
          type: string
          readOnly: true
        mentions:
          type: array
          items:
            type: string
            description: Required. 150 characters or fewer. Letters, digits and @/./+/-/_
              only.
          readOnly: true
        is_edited:
          type: boolean
          readOnly: true
        is_deleted:
          type: boolean
          readOnly: true
          description: Soft-deleted comments show '[deleted]' but preserve thread
            structure.
        created_at:
          type: string
          format: date-time
          readOnly: true
        edited_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        replies_count:
          type: integer
          readOnly: true
        reactions:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: 'Return aggregated reactions: [{emoji, count, users}].'
          readOnly: true
      required:
      - author
      - body
      - created_at
      - display_body
      - edited_at
      - id
      - is_deleted
      - is_edited
      - mentions
      - parent
      - reactions
      - replies_count
    ClinicalCommentCreate:
      type: object
