components:
  schemas:
    AEFI:
      type: object
      description: Full serializer for AEFI report — aligned with MOH AEFI Reporting
        Form.
      properties:
        id:
          type: integer
          readOnly: true
        immunization_record:
          type: integer
          description: The immunization that caused the adverse event
        report_type:
          allOf:
          - $ref: '#/components/schemas/ReportType01aEnum'
          description: |-
            Initial or follow-up report

            * `INITIAL` - Initial Report
            * `FOLLOW_UP` - Follow-up Report
        parent_report:
          type: integer
          nullable: true
          description: Parent AEFI report (for follow-up reports)
        vaccine_code:
          type: string
          readOnly: true
        vaccine_name:
          type: string
          readOnly: true
        patient_id:
          type: integer
          readOnly: true
        patient_name:
          type: string
          readOnly: true
        patient_mrn:
          type: string
          readOnly: true
        patient_gender:
          type: string
          readOnly: true
        patient_date_of_birth:
          type: string
          format: date
          readOnly: true
        guardian_name:
          type: string
          description: Name of guardian (if patient is a child)
          maxLength: 200
        vaccination_centre_name:
          type: string
          description: Vaccination centre name (auto-populated from facility)
          maxLength: 200
        vaccination_centre_county:
          type: integer
          nullable: true
          description: County of vaccination centre
        institution_mfl_code:
          type: string
          description: Institution Master Facility List code
          maxLength: 20
        vaccination_service_type:
          allOf:
          - $ref: '#/components/schemas/VaccinationServiceTypeEnum'
          description: |-
            Type of vaccination service (static, mass, outreach)

            * `STATIC` - Static
            * `MASS` - Mass Campaign
            * `OUTREACH` - Outreach
        event_date:
          type: string
          format: date
          description: Date adverse event was observed
        onset_time:
          type: string
          format: time
          nullable: true
          description: Time of onset (if known)
        event_types:
          description: List of AEFI event types (multi-select per MOH form checkboxes)
        other_event_type_detail:
          type: string
          description: Specify if 'Other' event type is selected
          maxLength: 200
        severity:
          $ref: '#/components/schemas/Severity9c6Enum'
        description:
          type: string
          description: Brief details on the event including timeline of occurrence
        vaccination_details:
          type: string
          readOnly: true
        outcome:
          $ref: '#/components/schemas/OutcomeC81Enum'
        past_medical_history_notes:
          type: string
          description: Past medical history including allergies, concomitant medication/vaccine,
            concomitant illness, other cases, pregnancy status
        treatment_given:
          type: boolean
          description: Whether treatment was given
        treatment_details:
          type: string
          description: Treatment given (specify)
        specimen_collected:
          type: boolean
          description: Whether specimen was collected for investigation
        specimen_type:
          type: string
          description: Type(s) of specimen collected
          maxLength: 200
        reported_by:
          type: integer
          nullable: true
          description: Person who reported the AEFI
        reported_by_name:
          type: string
          readOnly: true
        reported_by_designation:
          type: string
          description: Designation of the person reporting
          maxLength: 100
        reported_to_authorities:
          type: boolean
          description: Whether reported to national authorities
        report_date:
          type: string
          format: date
          nullable: true
          description: Date reported to authorities
        investigated_by:
          type: integer
          nullable: true
        investigated_by_name:
          type: string
          readOnly: true
        investigation_notes:
          type: string
        national_classification:
          type: string
          readOnly: true
          description: Final classification of AEFI (to be filled at national level)
        dhis2_submitted_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Timestamp of DHIS2 AEFI Tracker submission
        dhis2_response:
          readOnly: true
          nullable: true
          description: DHIS2 API response from submission
        follow_up_count:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - description
      - dhis2_response
      - dhis2_submitted_at
      - follow_up_count
      - id
      - immunization_record
      - investigated_by_name
      - national_classification
      - patient_date_of_birth
      - patient_gender
      - patient_id
      - patient_mrn
      - patient_name
      - reported_by_name
      - severity
      - updated_at
      - vaccination_details
      - vaccine_code
      - vaccine_name
