    Encounter:
      type: object
      description: |-
        Serializer for the Encounter model.

        Provides CRUD operations for encounters with validation
        and computed fields.
      properties:
        id:
          type: integer
          readOnly: true
        public_id:
          type: string
          format: uuid
          readOnly: true
          description: Stable public UUID for external APIs and links.
        patient:
          type: integer
          description: Patient associated with this encounter
        patient_id:
          type: integer
          readOnly: true
        patient_mrn:
          type: string
          readOnly: true
        patient_name:
          type: string
          readOnly: true
        patient_gender:
          type: string
          readOnly: true
        patient_date_of_birth:
          type: string
          format: date
          readOnly: true
        patient_age:
          type: integer
          nullable: true
          description: Calculate patient age from date of birth.
          readOnly: true
        encounter_type:
          allOf:
          - $ref: '#/components/schemas/EncounterTypeEnum'
          description: |-
            Type of encounter

            * `OPD` - Outpatient Department
            * `IPD` - Inpatient Department
            * `EMERGENCY` - Emergency
            * `ANC` - Antenatal Clinic
            * `PAEDIATRIC` - Paediatric Clinic
            * `DIALYSIS` - Dialysis Unit
            * `ONCOLOGY` - Oncology Clinic
            * `SCHEDULED_OPD` - Scheduled Outpatient
            * `FOLLOW_UP` - Follow-up Visit
            * `CONSULTANT_REVIEW` - Consultant Review
            * `CHRONIC_STABLE` - Stable Chronic Care
            * `SPECIALIST_CLINIC` - Specialist Clinic
            * `PROCEDURE` - Scheduled Procedure
            * `DAY_CASE` - Day Case
            * `WARD_ROUND` - Ward Round
            * `DISCHARGE_REVIEW` - Discharge Review
        encounter_type_display:
          type: string
          description: Get the display label for encounter type.
          readOnly: true
        encounter_date:
          type: string
          format: date
          description: Date of the encounter
        chief_complaint:
          type: string
          description: Patient's chief complaint
        temperature:
          type: number
          format: double
          nullable: true
        pulse:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          nullable: true
          description: Pulse rate (beats per minute)
        blood_pressure:
          type: string
          description: Blood pressure (e.g., 120/80)
          maxLength: 20
        systolic_bp:
          type: integer
          nullable: true
          description: Get systolic blood pressure.
          readOnly: true
        diastolic_bp:
          type: integer
          nullable: true
          description: Get diastolic blood pressure.
          readOnly: true
        respiratory_rate:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          nullable: true
          description: Respiratory rate (breaths per minute)
        spo2:
          type: number
          format: double
          nullable: true
        vitals_source:
          allOf:
          - $ref: '#/components/schemas/VitalsSourceEnum'
          nullable: true
          description: |-
            Where the vitals were recorded (e.g., triage)

            * `TRIAGE` - Triage
            * `CONSULTATION` - Consultation
            * `NURSING` - Nursing
        vitals_recorded_by:
          type: integer
          nullable: true
          description: User who recorded the vitals
        vitals_recorded_at:
          type: string
          format: date-time
          nullable: true
          description: Timestamp when vitals were recorded
        weight:
          type: number
          format: double
          nullable: true
        height:
          type: number
          format: double
          nullable: true
        bmi:
          type: number
          format: double
          nullable: true
          description: |-
            Calculate BMI from weight and height.

            BMI = weight (kg) / height (m)^2
          readOnly: true
        bmi_classification:
          type: string
          nullable: true
          description: Get BMI classification.
          readOnly: true
        vitals_summary:
          type: string
          description: Get formatted vitals summary.
          readOnly: true
        allergies:
          type: string
          description: Known allergies (medications, food, environmental)
        chronic_conditions:
          type: string
          description: Chronic conditions (e.g., Diabetes, Hypertension, Asthma)
        current_medications:
          type: string
          description: Current medications with dosage
        past_surgeries:
          type: string
          description: Past surgical procedures with dates
        family_history:
          type: string
          description: Relevant family medical history
        social_history:
          type: string
          description: Social history (smoking, alcohol, occupation, lifestyle)
        notes:
          type: string
          description: Additional clinical notes
        history_of_present_illness:
          type: string
          description: History of Present Illness (HPI) - detailed narrative of the
            patient's condition
        physical_examination:
          type: string
          description: Physical Examination findings
        assessment:
          type: string
          description: Clinical assessment/impression (SOAP 'A')
        clinical_template:
          type: integer
          nullable: true
          description: Clinical template used for this encounter
        clinical_template_data:
          nullable: true
          description: Structured data collected using the clinical template (JSON)
        has_critical_vitals:
          type: boolean
          description: |-
            Check if any vital signs are in critical ranges.

            Uses age-appropriate ranges for pediatric patients.

            Returns:
                bool: True if any vital signs are critical
          readOnly: true
        alerts:
          type: string
          description: Get alerts for critical vital signs.
          readOnly: true
        cds_alerts:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: |-
            Get pending CDS advisory alerts for this encounter.

            Returns lightweight alert data embedded in the encounter response
            so the frontend can render advisory banners without a second API call.
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/EncounterStatusEnum'
          readOnly: true
          description: |-
            Encounter status lifecycle

            * `CREATED` - Created
            * `CHECKED_IN` - Checked In
            * `TRIAGED` - Triaged
            * `IN_PROGRESS` - In Progress
            * `ON_HOLD` - On Hold
            * `ORDERS_PLACED` - Orders Placed
            * `RESULTS_PENDING` - Results Pending
            * `READY_TO_CLOSE` - Ready to Close
            * `CLOSED` - Closed
            * `CANCELLED` - Cancelled
        finalized_by:
          type: integer
          readOnly: true
        finalized_by_username:
          type: string
          readOnly: true
          nullable: true
        finalized_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Timestamp when the encounter was finalized/completed
        cancellation_reason:
          type: string
          readOnly: true
          description: Reason for cancellation (if status is CANCELLED)
        disposition:
          allOf:
          - $ref: '#/components/schemas/DispositionEnum'
          description: |-
            Encounter outcome/disposition

            * `` - Not Set
            * `ADVICE_ONLY` - Advice Only
            * `TREATED_DISCHARGED` - Treated & Discharged
            * `REFERRED` - Referred to Specialist
            * `ADMITTED` - Admitted to Inpatient
            * `FOLLOW_UP_SCHEDULED` - Follow-up Scheduled
            * `LEFT_AMA` - Left Against Medical Advice
        disposition_notes:
          type: string
          description: Required for ADVICE_ONLY and LEFT_AMA dispositions
        triage_requirement:
          allOf:
          - $ref: '#/components/schemas/TriageRequirementEnum'
          readOnly: true
          description: |-
            Whether triage is mandatory, optional, or not required

            * `MANDATORY` - Mandatory - Must complete triage
            * `OPTIONAL` - Optional - Can bypass triage
            * `NOT_REQUIRED` - Not Required - Skip triage
        triage_status:
          allOf:
          - $ref: '#/components/schemas/TriageStatusEnum'
          readOnly: true
          description: |-
            Current triage status

            * `PENDING` - Pending - Awaiting triage
            * `IN_PROGRESS` - In Progress - Being triaged
            * `COMPLETED` - Completed - Triage done
            * `BYPASSED` - Bypassed - Triage skipped
            * `NOT_APPLICABLE` - Not Applicable - Triage not required
        triage_bypass_reason:
          allOf:
          - $ref: '#/components/schemas/TriageBypassReasonEnum'
          nullable: true
        triage_bypassed_by:
          type: integer
          readOnly: true
          nullable: true
          description: User who bypassed the triage
        triage_bypassed_by_username:
          type: string
          readOnly: true
          nullable: true
        triage_bypassed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Timestamp when triage was bypassed
        triage_category:
          type: string
          nullable: true
          description: Get triage category from linked TriageAssessment.
          readOnly: true
        triage_completed_at:
          type: string
          nullable: true
          description: Get triage completion timestamp from linked TriageAssessment.
          readOnly: true
        consultation_status:
          allOf:
          - $ref: '#/components/schemas/ConsultationStatusEnum'
          readOnly: true
          description: |-
            Current consultation status

            * `WAITING` - Waiting for consultation
            * `CALLED` - Called - Patient summoned
            * `IN_PROGRESS` - In Progress - Being seen
            * `COMPLETED` - Completed - Consultation done
            * `CANCELLED` - Cancelled
        called_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Timestamp when patient was called for consultation
        consultation_started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Timestamp when consultation started
        can_enter_consultation:
          type: boolean
          description: Check if encounter can enter consultation queue.
          readOnly: true
        wait_time_minutes:
          type: integer
          nullable: true
          description: Calculate wait time in minutes since encounter creation.
          readOnly: true
        arrival_time:
          type: string
          description: Get arrival time (alias for created_at).
          readOnly: true
        chief_complaint_original:
          type: string
