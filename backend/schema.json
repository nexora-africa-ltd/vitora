          format: int64
          description: Total doses in the series (e.g., 3 for Hep B adult)
        series_name:
          type: string
          description: Name of the vaccine series (e.g., 'Pentavalent' for Penta1/2/3)
          maxLength: 50
        interval_days:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Minimum days between doses in a multi-dose series
        target_population:
          allOf:
          - $ref: '#/components/schemas/TargetPopulationEnum'
          description: |-
            Target population for this vaccine

            * `INFANT` - Infant (0-11 months)
            * `CHILD` - Child (1-9 years)
            * `ADOLESCENT` - Adolescent (10-17 years)
            * `ADULT` - Adult (18+ years)
            * `ALL` - All Ages
        program:
          allOf:
          - $ref: '#/components/schemas/ProgramEnum'
          description: |-
            Vaccination program this belongs to

            * `KEPI` - Kenya Expanded Programme on Immunization
            * `ROUTINE` - Routine (Non-KEPI)
            * `CAMPAIGN` - Mass Campaign
            * `OCCUPATIONAL` - Occupational
            * `TRAVEL` - Travel
            * `CATCH_UP` - Catch-Up
        min_age_days:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Minimum age in days for eligibility (0 = no minimum)
        max_age_days:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Maximum age in days for eligibility (0 = no maximum)
        is_active:
          type: boolean
          description: Whether this vaccine is currently active
        billing_service:
          type: integer
          nullable: true
          description: Linked billing service for invoice generation. When set, the
            service unit_price and SHA code are used for billing.
        billing_service_name:
          type: string
          readOnly: true
        billing_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
        base_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          description: Base vaccine fee (KES). Used as fallback when billing_service
            is not set.
        sha_tariff_code:
          type: string
          description: SHA intervention tariff code for vaccine billing
          maxLength: 50
      required:
      - billing_price
      - billing_service_name
      - code
      - id
      - name
