    PatchedANCVisitRequest:
      type: object
      description: Full serializer for ANC visit.
      properties:
        registration:
          type: integer
          description: MCH registration this visit belongs to
        encounter:
          type: integer
          nullable: true
          description: Clinical encounter for this visit
        clinic_visit:
          type: integer
          nullable: true
        visit_number:
          type: integer
          maximum: 20
          minimum: 1
          description: Sequential visit number (1-20, WHO recommends 8+)
        visit_date:
          type: string
          format: date
          description: Date of ANC visit
        weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,1})?$
          nullable: true
          description: Weight in kg
        blood_pressure:
          type: string
          description: Blood pressure in format '120/80'
          maxLength: 10
        fundal_height:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          nullable: true
          description: Fundal height in cm
        fetal_heart_rate:
          type: integer
          maximum: 200
          minimum: 80
          nullable: true
          description: 'Fetal heart rate in BPM (normal: 110-160)'
        presentation:
          allOf:
          - $ref: '#/components/schemas/PresentationEnum'
          description: |-
            Fetal presentation

            * `CEPHALIC` - Cephalic
            * `BREECH` - Breech
            * `TRANSVERSE` - Transverse
            * `OBLIQUE` - Oblique
            * `UNKNOWN` - Unknown
        lie:
          allOf:
          - $ref: '#/components/schemas/LieEnum'
          description: |-
            Fetal lie

            * `LONGITUDINAL` - Longitudinal
            * `TRANSVERSE` - Transverse
            * `OBLIQUE` - Oblique
        fetal_movements:
          type: boolean
          nullable: true
          description: Whether fetal movements are present
        urine_protein:
          allOf:
          - $ref: '#/components/schemas/UrineAcetoneEnum'
          description: |-
            Urine protein level

            * `NEGATIVE` - Negative
            * `TRACE` - Trace
            * `1+` - 1+
            * `2+` - 2+
            * `3+` - 3+
            * `4+` - 4+
        urine_glucose:
          allOf:
          - $ref: '#/components/schemas/UrineAcetoneEnum'
          description: |-
            Urine glucose level

            * `NEGATIVE` - Negative
            * `TRACE` - Trace
            * `1+` - 1+
            * `2+` - 2+
            * `3+` - 3+
            * `4+` - 4+
        hb_level:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          nullable: true
          description: Haemoglobin level in g/dL
        blood_sugar:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,1})?$
          nullable: true
          description: Blood sugar in mmol/L
        hiv_test_done:
          type: boolean
          description: Whether HIV test was done at this visit
        syphilis_test_done:
          type: boolean
          description: Whether syphilis test was done at this visit
        iron_folate_given:
          type: boolean
          description: Iron-folate supplement given
        calcium_given:
          type: boolean
          description: Calcium supplement given
        deworming_given:
          type: boolean
          description: Deworming medication given
        tetanus_toxoid_dose:
          type: integer
          maximum: 5
          minimum: 0
          nullable: true
          description: Tetanus toxoid dose number given (1-5)
        next_visit_date:
          type: string
          format: date
          nullable: true
          description: Next scheduled ANC visit date
        notes:
          type: string
          description: Clinical notes
        conducted_by:
          type: integer
          nullable: true
