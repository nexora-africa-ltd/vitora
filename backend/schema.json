    get:
      operationId: api_imaging_share_download_retrieve
      description: ZIP download of all instances for a shared study (if allow_download).
      parameters:
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - api
      responses:
        '200':
          description: No response body
