        intervention_fund:
          type: string
          readOnly: true
          description: Intervention-specific fund label from ILM payload
        supported_scheme:
          type: string
          readOnly: true
          description: Supported scheme label from ILM payload
        schemes:
          readOnly: true
          description: Applicable schemes from ILM payload
        intervention_payload:
          readOnly: true
          description: Raw ILM intervention payload preserved for future metadata
            needs
        level2_tariff:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          nullable: true
        level3_tariff:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          nullable: true
        level4_tariff:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          nullable: true
        level5_tariff:
