          description: Default weekly shift pattern for auto-fill, e.g. ['DAY','DAY','NIGHT','NIGHT','OFF','OFF','REST']
        active_shift_types:
          description: Working shift types this facility uses for auto-fill coverage,
            e.g. ['MORNING','AFTERNOON','NIGHT']. When set, auto-fill distributes
            staff across ALL listed types each day.
