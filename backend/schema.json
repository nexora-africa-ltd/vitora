openapi: 3.0.3
info:
  title: Vitora HMIS API
  version: 0.1.0
  description: Hospital Management Information System for Kenya
paths:
  /api/admissions/{admission_pk}/comments/:
    get:
      operationId: api_admissions_comments_list
      description: |-
        CRUD for clinical comments attached to encounters, lab orders, or prescriptions.

        List defaults to top-level comments (parent=null). Pass ?parent={id} for replies.
      parameters:
      - in: path
        name: admission_pk
        schema:
          type: integer
        required: true
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedClinicalCommentList'
          description: ''
    post:
      operationId: api_admissions_comments_create
      description: Override to resolve target before validation, and return read serializer
        on 201.
      parameters:
      - in: path
        name: admission_pk
        schema:
          type: integer
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ClinicalCommentCreateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ClinicalCommentCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ClinicalCommentCreateRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicalCommentCreate'
          description: ''
  /api/admissions/{admission_pk}/comments/{id}/:
    get:
      operationId: api_admissions_comments_retrieve
      description: |-
        CRUD for clinical comments attached to encounters, lab orders, or prescriptions.

        List defaults to top-level comments (parent=null). Pass ?parent={id} for replies.
      parameters:
      - in: path
        name: admission_pk
        schema:
          type: integer
        required: true
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicalComment'
          description: ''
    patch:
      operationId: api_admissions_comments_partial_update
      description: |-
        CRUD for clinical comments attached to encounters, lab orders, or prescriptions.

        List defaults to top-level comments (parent=null). Pass ?parent={id} for replies.
      parameters:
      - in: path
        name: admission_pk
        schema:
          type: integer
        required: true
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedClinicalCommentUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedClinicalCommentUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedClinicalCommentUpdateRequest'
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicalCommentUpdate'
          description: ''
    delete:
      operationId: api_admissions_comments_destroy
      description: 'Soft-delete: replace body with ''[deleted]'', preserve thread
        structure.'
      parameters:
      - in: path
        name: admission_pk
        schema:
          type: integer
        required: true
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '204':
          description: No response body
  /api/admissions/{admission_pk}/comments/{id}/react/:
    post:
      operationId: api_admissions_comments_react_create
      description: "Toggle a reaction (emoji) on a comment.\n\nPOST body: {\"emoji\":
        \"\U0001F44D\"}\nIf the reaction already exists for this user+emoji, it is
        removed (toggle off).\nReturns the updated reactions summary for the comment."
      parameters:
      - in: path
        name: admission_pk
        schema:
          type: integer
        required: true
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicalComment'
          description: ''
  /api/ai/advisory-links/:
    get:
      operationId: api_ai_advisory_links_retrieve
      description: GET /api/ai/advisory-links/?ai_result_id=<uuid>
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
    post:
      operationId: api_ai_advisory_links_create
      description: POST /api/ai/advisory-links/ — seed suggestion rows from result_data.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/advisory-links/{id}/action/:
    patch:
      operationId: api_ai_advisory_links_action_partial_update
      description: PATCH /api/ai/advisory-links/<id>/action/
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/advisory-links/has-orders/:
    get:
      operationId: api_ai_advisory_links_has_orders_retrieve
      description: GET /api/ai/advisory-links/has-orders/?ai_result_id=<uuid>
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/autopopulate/:
    post:
      operationId: api_ai_autopopulate_create
      description: |-
        AI-powered encounter form autopopulation.

        POST /api/ai/autopopulate/

        Accepts encounter context (chief complaint, vitals, patient info) and
        returns structured field suggestions for the encounter form.

        Gated behind both the AI feature flag (TIBABOT_ENABLED) and the
        smart_autopopulate feature flag. Returns 404 if either is disabled.

        All suggestions require explicit user confirmation before being applied.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/care-plan/conditions/:
    get:
      operationId: api_ai_care_plan_conditions_retrieve
      description: |-
        List conditions with care plan templates.

        GET /api/ai/care-plan/conditions/
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/care-plan/generate/:
    post:
      operationId: api_ai_care_plan_generate_create
      description: |-
        Generate structured, evidence-based care plan.

        POST /api/ai/care-plan/generate/

        Returns goals, interventions (grouped by category), discharge
        criteria, follow-up instructions, and CDS safety alerts.
        Falls back to generic template when TibaBot is unavailable.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/care-plan/generate/fhir/:
    post:
      operationId: api_ai_care_plan_generate_fhir_create
      description: |-
        Generate care plan as FHIR R4 CarePlan resource.

        POST /api/ai/care-plan/generate/fhir/

        Same input as /care-plan/generate/ but returns FHIR R4 JSON.
        No fallback — requires TibaBot.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/cds/evaluate/:
    post:
      operationId: api_ai_cds_evaluate_create
      description: |-
        TibaBot-powered CDS rule evaluation (supplements local engine).

        POST /api/ai/cds/evaluate/

        Checks for DDI, contraindications, protocol adherence, formulary
        compliance. Designed to augment (not replace) the local CDS engine.

        No fallback — returns empty alerts when TibaBot is unavailable.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/clerking/autocomplete/:
    post:
      operationId: api_ai_clerking_autocomplete_create
      description: |-
        Context-aware medical autocomplete for clinical notes.

        POST /api/ai/clerking/autocomplete/

        No meaningful fallback — returns empty suggestions when unavailable.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/clerking/structure/:
    post:
      operationId: api_ai_clerking_structure_create
      description: |-
        Convert free-text clinical notes to structured format (SOAP/SBAR).

        POST /api/ai/clerking/structure/

        Falls back to empty structure template when TibaBot is unavailable.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/clinical/assist/:
    post:
      operationId: api_ai_clinical_assist_create
      description: |-
        Proxy endpoint for encounter-aware clinical assistance.

        POST /api/ai/clinical/assist/
        Body: { "query": "...", "patient_context": {...}, "encounter_context": {...} }

        Auto-enriches the request with user_context and facility_context
        before forwarding to TibaBot.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/clinical/chat/:
    post:
      operationId: api_ai_clinical_chat_create
      description: |-
        Proxy endpoint for TibaBot clinical chat.

        POST /api/ai/clinical/chat/
        Body: { "message": "...", "session_id": "..." }

        Auto-enriches the request with user_context and facility_context
        before forwarding to TibaBot.

        Persists both user and assistant messages locally so the session
        management endpoints can list/retrieve/delete them.

        Response shape (matches frontend AIClinicalChatResponseSchema):
        {
            "session_id": "<uuid>",
            "message": {
                "id": "<uuid>",
                "role": "assistant",
                "content": "...",
                "timestamp": "<iso8601>"
            },
            "error": null  // optional
        }
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/clinical/chat/session/{session_id}/:
    get:
      operationId: api_ai_clinical_chat_session_retrieve
      description: |-
        Retrieve or delete a specific chat session.

        GET /api/ai/clinical/chat/session/{id}/
        Response shape (matches frontend AIChatSessionDetailResponseSchema):
        {
            "session": { "id", "title", "created_at", "updated_at", "message_count" },
            "messages": [
                { "id", "role", "content", "timestamp" }
            ]
        }

        DELETE /api/ai/clinical/chat/session/{id}/
        Returns 204 No Content.
      parameters:
      - in: path
        name: session_id
        schema:
          type: string
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
    delete:
      operationId: api_ai_clinical_chat_session_destroy
      description: |-
        Retrieve or delete a specific chat session.

        GET /api/ai/clinical/chat/session/{id}/
        Response shape (matches frontend AIChatSessionDetailResponseSchema):
        {
            "session": { "id", "title", "created_at", "updated_at", "message_count" },
            "messages": [
                { "id", "role", "content", "timestamp" }
            ]
        }

        DELETE /api/ai/clinical/chat/session/{id}/
        Returns 204 No Content.
      parameters:
      - in: path
        name: session_id
        schema:
          type: string
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '204':
          description: No response body
  /api/ai/clinical/chat/sessions/:
    get:
      operationId: api_ai_clinical_chat_sessions_retrieve
      description: |-
        List all chat sessions for the authenticated user.

        GET /api/ai/clinical/chat/sessions/

        Response shape (matches frontend AIChatSessionListResponseSchema):
        {
            "sessions": [
                {
                    "id": "<uuid>",
                    "title": "...",
                    "created_at": "<iso8601>",
                    "updated_at": "<iso8601>",
                    "message_count": 5
                }
            ]
        }
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/clinical/document/:
    post:
      operationId: api_ai_clinical_document_create
      description: |-
        Generate structured clinical documents using TibaBot LLM.

        POST /api/ai/clinical/document/

        Supports: discharge_summary, soap, progress_note, referral_letter,
        clerking_note. Output formats: markdown, structured, fhir.

        Falls back to empty template when TibaBot is unavailable.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/clinical/proactive-insights/:
    post:
      operationId: api_ai_clinical_proactive_insights_create
      description: |-
        Generate proactive clinical insights based on encounter context.

        POST /api/ai/clinical/proactive-insights/

        Three-tier insight generation:
        - Tier 1: Rule-based vital alerts (deterministic, instant)
        - Tier 2: Pattern-based clinical nudges (rules engine, instant)
        - Tier 3: LLM-powered insights (TibaBot, async, conditional)

        Rate-limited: max 2 requests per 30 seconds per user.
        Context deduplication: returns empty if context_hash matches previous call.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/discharge/assess/:
    post:
      operationId: api_ai_discharge_assess_create
      description: |-
        AI-powered discharge readiness assessment.

        POST /api/ai/discharge/assess/

        Evaluates condition-specific criteria, vitals stability, social
        factors (Kenya-specific), and readmission risk. Falls back to
        checklist scoring when TibaBot is unavailable.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/discharge/conditions/:
    get:
      operationId: api_ai_discharge_conditions_retrieve
      description: |-
        List conditions supported by discharge readiness assessment.

        GET /api/ai/discharge/conditions/
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/ecg/compare/:
    post:
      operationId: api_ai_ecg_compare_create
      description: |-
        Compare two ECGs for serial change detection.

        POST /api/ai/ecg/compare/
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/ecg/interpret/:
    post:
      operationId: api_ai_ecg_interpret_create
      description: |-
        Interpret ECG findings (structured parameters or free-text).

        POST /api/ai/ecg/interpret/
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/ecg/patterns/:
    get:
      operationId: api_ai_ecg_patterns_retrieve
      description: |-
        List all supported ECG patterns/diagnoses.

        GET /api/ai/ecg/patterns/
        No authentication required (public reference endpoint).
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/ai/ecg/report/:
    post:
      operationId: api_ai_ecg_report_create
      description: |-
        Generate downloadable PDF report from ECG interpretation.

        POST /api/ai/ecg/report/
        Returns: application/pdf
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/ecg/scores/cha2ds2-vasc/:
    post:
      operationId: api_ai_ecg_scores_cha2ds2_vasc_create
      description: |-
        Calculate CHA₂DS₂-VASc stroke risk score.

        POST /api/ai/ecg/scores/cha2ds2-vasc/
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/ecg/scores/has-bled/:
    post:
      operationId: api_ai_ecg_scores_has_bled_create
      description: |-
        Calculate HAS-BLED bleeding risk score.

        POST /api/ai/ecg/scores/has-bled/
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/ecg/upload/:
    post:
      operationId: api_ai_ecg_upload_create
      description: |-
        Upload ECG image/file for auto-interpretation.

        POST /api/ai/ecg/upload/
        Content-Type: multipart/form-data

        Supported: JPEG, PNG, TIFF, BMP, DICOM, GE MUSE XML, HL7 aECG, SCP-ECG.
        Max file size: 10 MB.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/egfr/calculate/:
    post:
      operationId: api_ai_egfr_calculate_create
      description: |-
        AI-powered eGFR calculation with CKD staging.

        POST /api/ai/egfr/calculate/

        Returns CKD-EPI 2021 eGFR, Cockcroft-Gault CrCl, CKD stage,
        dose adjustment band, and clinical action flags.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/facility/knowledge-base/:
    get:
      operationId: api_ai_facility_knowledge_base_retrieve
      description: |-
        Get facility knowledge base info and document list.

        GET /api/ai/facility/knowledge-base/
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/facility/knowledge-base/documents/:
    post:
      operationId: api_ai_facility_knowledge_base_documents_create
      description: |-
        Upload a document to the facility knowledge base.

        POST /api/ai/facility/knowledge-base/documents/

        Accepts multipart/form-data with a single ``file`` field.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/facility/knowledge-base/documents/{document_id}/:
    delete:
      operationId: api_ai_facility_knowledge_base_documents_destroy
      description: |-
        Delete a document from the facility knowledge base.

        DELETE /api/ai/facility/knowledge-base/documents/{document_id}/
      parameters:
      - in: path
        name: document_id
        schema:
          type: string
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '204':
          description: No response body
  /api/ai/facility/knowledge-base/search/:
    get:
      operationId: api_ai_facility_knowledge_base_search_retrieve
      description: |-
        Search the facility knowledge base.

        GET /api/ai/facility/knowledge-base/search/?q=<query>&limit=10
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/feedback/:
    post:
      operationId: api_ai_feedback_create
      description: |-
        Proxy endpoint for submitting feedback on TibaBot responses.

        POST /api/ai/feedback/
        Body: {
            "message_id": "enc-88-assist-1",
            "feedback": "up",
            "conversation_id": "encounter-88",      // optional
            "user_query": "...",                      // optional
            "bot_response": "...",                    // optional
            "risk_level": "critical"                  // optional
        }

        Forwards to TibaBot's POST /feedback and returns {status, message, feedback_id}.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/feedback/stats/:
    get:
      operationId: api_ai_feedback_stats_retrieve
      description: |-
        Proxy endpoint for TibaBot feedback aggregate statistics.

        GET /api/ai/feedback/stats/

        Returns: { total_up, total_down, recent_negatives }
        Useful for the admin dashboard.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/formulary/search/:
    get:
      operationId: api_ai_formulary_search_retrieve
      description: |-
        Search Kenya's pharmaceutical data sources.

        Proxies to TibaBot /drugs/search endpoint which searches across:
        - SmPC (Summary of Product Characteristics)
        - PPB Products (Pharmacy & Poisons Board register)
        - KEML (Kenya Essential Medicines List)
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/formulary/smpc/{doc_id}/:
    get:
      operationId: api_ai_formulary_smpc_retrieve
      description: |-
        Retrieve full SmPC monograph for a specific drug product.

        Proxies to TibaBot /drugs/smpc/{doc_id} endpoint.
      parameters:
      - in: path
        name: doc_id
        schema:
          type: string
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/formulary/stats/:
    get:
      operationId: api_ai_formulary_stats_retrieve
      description: |-
        Drug formulary service statistics and health check.

        Proxies to TibaBot /drugs/stats endpoint.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/icd10-suggest/:
    post:
      operationId: api_ai_icd10_suggest_create
      description: |-
        Proxy endpoint for TibaBot ICD-10 auto-coding.

        POST /api/ai/icd10-suggest/
        Body: { "clinical_text": "patient presenting with malaria symptoms and fever" }

        Returns ranked ICD-10 code suggestions with confidence scores.
        Advisory only — clinician must confirm/reject each suggestion.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/ai/insights/:
    get:
      operationId: api_ai_insights_retrieve
      description: |-
        GET /api/ai/insights/

        Aggregated AI usage insights for the admin dashboard.

        Returns:
        - Stored result counts (per type)
        - Suggestion audit accept/reject rates
