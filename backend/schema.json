      properties:
        id:
          type: integer
          readOnly: true
        fluid_balance_sheet:
          type: integer
          description: Fluid balance sheet this entry belongs to
        recorded_at:
          type: string
          format: date-time
          description: When the fluid entry was recorded
        recorded_by:
          type: integer
          description: Nurse/clinician who recorded the entry
        recorded_by_username:
          type: string
          readOnly: true
        entry_type:
          allOf:
          - $ref: '#/components/schemas/EntryTypeEnum'
          description: |-
            Category of fluid balance entry

            * `INTRAVENOUS` - Intravenous
            * `ALIMENTARY` - Alimentary
            * `OTHER_INTAKE` - Other Intake
            * `VOMIT` - Vomit
            * `STOOL` - Stool
            * `NASOGASTRIC` - Naso Gastric
            * `OTHER_OUTPUT` - Other Output
            * `URINE` - Urine
        entry_type_display:
          type: string
          readOnly: true
        item_type:
          type: string
          description: Type/name of fluid, feed, or output item
          maxLength: 100
        bottle_number:
          type: string
          description: Bottle number for IV intake where applicable
          maxLength: 50
        amount_ml:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Measured amount in mL
        specific_gravity:
          type: string
          format: decimal
          pattern: ^-?\d{0,1}(?:\.\d{0,3})?$
          nullable: true
          description: Urine specific gravity where applicable
        notes:
          type: string
          description: Additional notes for this fluid balance entry
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - entry_type
      - entry_type_display
      - fluid_balance_sheet
      - id
      - recorded_at
      - recorded_by
      - recorded_by_username
      - updated_at
