            * `PARSED` - Parsed Successfully
            * `APPLIED` - Results Applied
            * `ERROR` - Parse Error
        status_display:
          type: string
          readOnly: true
        error_message:
          type: string
          description: Error details if parsing failed
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - instrument
      - instrument_code
      - instrument_name
      - operator_name
      - raw_message
      - run_datetime
      - specimen
      - specimen_barcode
      - status_display
