components:
  schemas:
    AdjustmentTypeEnum:
      enum:
      - DAMAGE
      - LOSS
      - EXPIRED
      - RETURN_SUPPLIER
      - TRANSFER_OUT
      - TRANSFER_IN
      - COUNT_CORRECTION
      - SAMPLE
      type: string
      description: |-
        * `DAMAGE` - Damaged Stock
        * `LOSS` - Stock Loss/Theft
        * `EXPIRED` - Expired Stock
        * `RETURN_SUPPLIER` - Return to Supplier
        * `TRANSFER_OUT` - Transfer Out
        * `TRANSFER_IN` - Transfer In
        * `COUNT_CORRECTION` - Physical Count Correction
        * `SAMPLE` - Sample/Demo
    Admission:
      type: object
      description: |-
        Serializer for Admission model.

        Supports automatic bed assignment via `auto_assign_bed=true` in request body.
