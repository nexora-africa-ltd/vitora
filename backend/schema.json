    ETIMSInvoice:
      type: object
      description: Read serializer for eTIMS invoice submissions.
      properties:
        id:
          type: integer
          readOnly: true
        invoice:
          type: integer
        invoice_number:
          type: string
          readOnly: true
        patient_name:
          type: string
          readOnly: true
        invoice_total:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
        dispensing:
          type: integer
          nullable: true
          description: 'Optional: dispensing that triggered this submission.'
        receipt_type:
          allOf:
          - $ref: '#/components/schemas/ReceiptTypeEnum'
          description: |-
            KRA receipt type: N, C, T, P.

            * `N` - Normal
            * `C` - Copy
            * `T` - Training
            * `P` - Proforma
        transaction_type:
          allOf:
          - $ref: '#/components/schemas/TransactionType8dbEnum'
          description: |-
            KRA transaction type: S or NC.

            * `S` - Sale
            * `NC` - Credit Note
        receipt_label:
          allOf:
          - $ref: '#/components/schemas/ReceiptLabelEnum'
          description: |-
            Combined receipt label (NS, NC, CS, CC, TS, TC, PS).

            * `NS` - Normal Sale
            * `NC` - Normal Credit Note
            * `CS` - Copy Sale
            * `CC` - Copy Credit Note
            * `TS` - Training Sale
            * `TC` - Training Credit Note
            * `PS` - Proforma Sale
        receipt_type_counter:
          type: integer
          readOnly: true
          description: Sequential counter per receipt type (§6.3).
        original_etims_invoice:
          type: integer
          nullable: true
          description: Original invoice for credit notes (NC/CC).
        original_cu_invoice_number:
          type: string
          description: Original CU invoice number for credit note reference.
          maxLength: 100
        buyer_pin:
          type: string
          description: Buyer's KRA PIN (optional per §5.1.3).
          maxLength: 15
        etims_receipt_number:
          type: string
          readOnly: true
          description: Receipt number returned by KRA on confirmation.
        etims_internal_data:
          readOnly: true
          description: Raw response data from KRA for audit trail.
        scu_id:
          type: string
          readOnly: true
          description: SCU/CU ID from OSCU/VSCU response (§5.3.1).
        scu_datetime:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Date/time stamped by OSCU/VSCU (§5.3.2).
        scu_receipt_counter:
          type: integer
          readOnly: true
          description: Receipt counter per type from SCU (§5.3.4).
        scu_total_counter:
          type: integer
          readOnly: true
          description: Total receipt counter from SCU (§5.3.5).
        scu_internal_data:
          type: string
          readOnly: true
          description: Internal data string from SCU (§5.3.6 / §6.23.6).
        scu_receipt_signature:
          type: string
          readOnly: true
          description: Digital receipt signature from SCU (§5.3.6 / §6.23.7).
        cu_invoice_number:
          type: string
          readOnly: true
        formatted_internal_data:
          type: string
          readOnly: true
        formatted_receipt_signature:
          type: string
          readOnly: true
        qr_code_data:
          type: string
          readOnly: true
          description: 'QR code string per §6.23.8: date#time#cu_number#cu_receipt_number#internal_data#signature.'
        ej_data_sent:
          type: boolean
          readOnly: true
          description: Whether electronic journal data was sent for this receipt.
        status:
          allOf:
          - $ref: '#/components/schemas/ETIMSInvoiceStatusEnum'
          readOnly: true
        submitted_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        confirmed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        error_message:
          type: string
          readOnly: true
        retry_count:
          type: integer
          readOnly: true
        facility:
          type: integer
          readOnly: true
          nullable: true
          description: Facility (branch) where this record was created.
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        items:
          type: array
          items:
            $ref: '#/components/schemas/ETIMSItem'
          readOnly: true
      required:
      - confirmed_at
      - created_at
      - cu_invoice_number
      - ej_data_sent
      - error_message
      - etims_internal_data
      - etims_receipt_number
      - facility
      - formatted_internal_data
      - formatted_receipt_signature
      - id
      - invoice
      - invoice_number
      - invoice_total
      - items
      - patient_name
      - qr_code_data
      - receipt_type_counter
      - retry_count
      - scu_datetime
      - scu_id
      - scu_internal_data
      - scu_receipt_counter
      - scu_receipt_signature
      - scu_total_counter
      - status
      - submitted_at
      - updated_at
