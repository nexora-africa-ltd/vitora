      type: object
      description: Serializer for facility scheduling settings.
      properties:
        id:
          type: integer
          readOnly: true
        max_hours_per_week:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Maximum scheduled hours per staff member per week
        max_consecutive_days:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Maximum consecutive working days before a mandatory rest day
        min_rest_hours:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Minimum rest hours between shifts
        max_night_shifts_per_week:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Maximum night shifts per staff per week
        max_day_hours:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          description: Maximum hours per day shift
        max_night_hours:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          description: Maximum hours per night shift
        default_shift_pattern:
          description: Default weekly shift pattern for auto-fill, e.g. ['DAY','DAY','NIGHT','NIGHT','OFF','OFF','REST']
        active_shift_types:
          description: Working shift types this facility uses for auto-fill coverage,
            e.g. ['MORNING','AFTERNOON','NIGHT']. When set, auto-fill distributes
            staff across ALL listed types each day.
        overtime_threshold_hours:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,1})?$
          description: Weekly hours threshold after which shifts count as overtime
        require_swap_approval:
          type: boolean
          description: When True, shift swaps require manager approval after peer
            acceptance. When False, accepted swaps are completed automatically.
        enforce_constraints:
          type: boolean
          description: When True, the roster grid warns on constraint violations
        enforce_punctuality:
          type: boolean
          description: When True, clock-in is blocked if staff is more than late_cutoff_minutes
            late
        late_cutoff_minutes:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Minutes after shift start after which clock-in is blocked (0
            = no limit)
        autofill_mode:
          allOf:
          - $ref: '#/components/schemas/AutofillModeEnum'
          description: |-
            Autofill strategy mode. MIN_COVERAGE fills only required coverage slots. BALANCED_UTILIZATION also adds assignments to reach target days per staff.

            * `MIN_COVERAGE` - Minimum Coverage
            * `BALANCED_UTILIZATION` - Balanced Utilization
        autofill_target_days_per_staff:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Target scheduled working days per staff per week when autofill
            mode is BALANCED_UTILIZATION.
        autofill_min_staff_per_shift:
          description: 'Per-shift minimum staffing coverage targets for autofill,
            e.g. {"DAY": 3, "NIGHT": 2}. Missing keys default to 1.'
        autofill_group_minimums:
          description: 'Group-specific minimum staffing rules for autofill, e.g. [{"scope":
            "DEPARTMENT", "value": "Nursing", "min_staff": 2, "shift_types": ["DAY",
            "NIGHT"]}].'
        autofill_group_maximums:
          description: 'Group-specific maximum staffing rules for autofill, e.g. [{"scope":
            "ROLE", "value": "Nurse", "max_staff": 3, "shift_types": ["NIGHT"]}].'
        autofill_weights:
          description: 'Per-facility scoring weights for weekly roster autofill, e.g.
            {"weekly_load": 30, "history_hours": 4, "night_penalty": 16}. Missing
            keys fall back to system defaults.'
        autofill_run_history:
          readOnly: true
          description: Recent autofill run reports for this facility. Stored as an
            append-only list (latest first) for review/compare in UI.
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
