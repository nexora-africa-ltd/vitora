    QCRule:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          description: Rule display name
          maxLength: 100
        rule_type:
          allOf:
          - $ref: '#/components/schemas/RuleTypeEnum'
          description: |-
            Westgard rule type

            * `1_2S` - 1-2s (Warning)
            * `1_3S` - 1-3s (Reject)
            * `2_2S` - 2-2s (Reject)
            * `R_4S` - R-4s (Reject)
            * `4_1S` - 4-1s (Reject)
            * `10X` - 10x (Reject)
            * `CUSTOM` - Custom Rule
        severity:
          allOf:
          - $ref: '#/components/schemas/Severity779Enum'
          description: |-
            Whether violation is a warning or rejection

            * `WARNING` - Warning
            * `REJECT` - Reject
        description:
          type: string
          description: Rule description/explanation
        custom_expression:
          type: string
          description: Custom rule expression (for CUSTOM type only)
        is_active:
          type: boolean
          description: Whether rule is currently active
        applies_to_test:
          type: integer
          nullable: true
          description: Specific test (null = applies to all tests)
        test_name:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - rule_type
      - test_name
