    SHAClaimIntervention:
      type: object
      description: Serializer for claim interventions tracked from DHA HIE.
      properties:
        id:
          type: integer
          readOnly: true
        intervention_code:
          type: string
          readOnly: true
          description: SHA intervention code (e.g., SHA-07-001)
        intervention_name:
          type: string
          readOnly: true
          description: Human-readable intervention name from HIE response
        benefit_code:
          type: string
          readOnly: true
          description: Parent benefit package code (e.g., SHA-07)
        status:
          allOf:
          - $ref: '#/components/schemas/SHAClaimInterventionStatusEnum'
          readOnly: true
        preview_missing_streak:
          type: integer
          readOnly: true
          description: Consecutive preview reconciliations where this intervention
            code was absent
        last_seen_in_preview_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Last time this intervention code appeared in DHA preview payload
        auto_retired_by_omission:
          type: boolean
          readOnly: true
          description: True when intervention was soft-retired after repeated omission
            from preview
        required_document_types:
          readOnly: true
          description: Required document types from DHA (e.g., ['MEDICAL_REPORT',
            'LAB_REPORT'])
        dha_intervention_id:
          type: string
          readOnly: true
          description: ID returned by HIE for this intervention on the claim
        tariff_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          nullable: true
          description: Tariff amount for this intervention per HIE response
        payment_mechanism:
          allOf:
          - $ref: '#/components/schemas/PaymentMechanismEnum'
          readOnly: true
          description: |-
            PER_DIEM, FEE_FOR_SERVICE, or CAPITATION — drives billing flow

            * `PER_DIEM` - Per Diem
            * `FEE_FOR_SERVICE` - Fee for Service
            * `CAPITATION` - Capitation
        access_point:
          allOf:
          - $ref: '#/components/schemas/AccessPointEnum'
          readOnly: true
          description: |-
            IP (inpatient), OP (outpatient), or BOTH

            * `IP` - Inpatient
            * `OP` - Outpatient
            * `BOTH` - Both
        needs_preauth:
          type: boolean
          readOnly: true
          description: True if this intervention requires pre-authorization
        needs_manual_preauth_approval:
          type: boolean
          readOnly: true
          description: True if elective preauth (doctor approval required before visit)
        is_surgical_preauth:
          type: boolean
          readOnly: true
        is_renal_preauth:
          type: boolean
          readOnly: true
        is_oncology_preauth:
          type: boolean
          readOnly: true
        is_imaging_preauth:
          type: boolean
          readOnly: true
        is_optical_preauth:
          type: boolean
          readOnly: true
        fund:
          type: string
          readOnly: true
