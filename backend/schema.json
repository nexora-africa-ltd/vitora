  /api/billing/sha-tariffs/:
    get:
      operationId: api_billing_sha_tariffs_list
      description: |-
        ViewSet for SHA Tariff codes.

        Provides read-only access to SHA tariff codes with search and filtering.
      parameters:
      - in: query
        name: category
        schema:
          type: string
          enum:
          - consultation
          - dental
          - dialysis
          - inpatient
          - laboratory
          - maternity
          - oncology
          - optical
          - other
          - pharmacy
          - physiotherapy
          - procedure
          - radiology
          - surgery
        description: |-
          * `consultation` - Consultation
          * `laboratory` - Laboratory
          * `radiology` - Radiology/Imaging
          * `pharmacy` - Pharmacy/Drugs
          * `procedure` - Procedures
          * `surgery` - Surgery
          * `inpatient` - Inpatient Services
          * `maternity` - Maternity
          * `dental` - Dental
          * `optical` - Optical
          * `physiotherapy` - Physiotherapy
          * `dialysis` - Dialysis
          * `oncology` - Oncology
          * `other` - Other Services
      - in: query
        name: facility_level
        schema:
          type: string
          enum:
          - L1
          - L2
          - L3
          - L4
          - L5
          - L6
        description: |-
          Applicable facility level

          * `L1` - Level 1 (Dispensary)
          * `L2` - Level 2 (Health Centre)
          * `L3` - Level 3 (Sub-County Hospital)
          * `L4` - Level 4 (County Hospital)
          * `L5` - Level 5 (National Referral)
          * `L6` - Level 6 (Tertiary/Specialized)
      - in: query
        name: is_active
        schema:
          type: boolean
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSHATariffList'
          description: ''
