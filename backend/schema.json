        Endpoints:
        - GET /api/inpatient/admissions/ - List all admissions
        - GET /api/inpatient/admissions/{id}/ - Admission detail
        - POST /api/inpatient/admissions/ - Create admission
        - PATCH /api/inpatient/admissions/{id}/ - Update admission
      parameters:
      - in: query
        name: admission_status
        schema:
          type: string
          enum:
          - ABSCONDED
          - ACTIVE
          - DECEASED
          - DISCHARGED
          - TRANSFERRED_OUT
        description: |-
          Current admission status

          * `ACTIVE` - Active
          * `DISCHARGED` - Discharged
          * `TRANSFERRED_OUT` - Transferred Out
          * `DECEASED` - Deceased
          * `ABSCONDED` - Absconded
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: patient
        schema:
          type: integer
      - in: query
        name: payer_type
        schema:
          type: string
          enum:
          - CASH
          - CORPORATE
          - SHA
        description: |-
          Type of payer

          * `CASH` - Cash
          * `SHA` - SHA Insurance
          * `CORPORATE` - Corporate
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: ward
        schema:
          type: integer
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAdmissionList'
          description: ''
