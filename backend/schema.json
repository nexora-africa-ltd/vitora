    Admission:
      type: object
      description: |-
        Serializer for Admission model.

        Supports automatic bed assignment via `auto_assign_bed=true` in request body.
        When auto_assign_bed is true, the `bed` field becomes optional as the system
        will automatically select the first available bed in the ward.
      properties:
        id:
          type: integer
          readOnly: true
        public_id:
          type: string
          format: uuid
          readOnly: true
          description: Stable public UUID for external APIs and links.
        admission_number:
          type: string
          readOnly: true
          description: Unique admission number (ADM-YYYYMMDD-XXXX)
        patient:
          type: integer
          description: Patient being admitted
        patient_name:
          type: string
          description: Get patient full name.
          readOnly: true
        patient_age:
          type: integer
          nullable: true
          description: Get patient age in years from date of birth.
          readOnly: true
        patient_gender:
          type: string
          nullable: true
          description: Get patient gender (M, F, O).
          readOnly: true
        source_encounter:
          type: integer
          readOnly: true
          description: Alias for opd_encounter used by some frontend admission flows.
        clinical_context:
          type: object
          additionalProperties: {}
          description: 'AI-ready clinical context: comorbidities, medications, allergies,
            recent lab results.'
          readOnly: true
        opd_encounter:
          type: integer
          nullable: true
          description: OPD encounter that led to admission (if applicable)
        mch_registration:
          type: integer
          nullable: true
          description: Pregnancy registration linked to this maternity admission
        mch_registration_number:
          type: string
          readOnly: true
        ipd_encounter:
          type: integer
          readOnly: true
          description: IPD encounter for this admission
        recommendation:
          type: integer
          nullable: true
          description: Admission recommendation (if from OPD)
        admission_date:
          type: string
          format: date-time
          description: Date and time of admission
        admitting_diagnosis:
          type: string
          description: ICD-10 code for admitting diagnosis
          maxLength: 10
        admitting_diagnosis_text:
          type: string
          description: Text description of diagnosis
          maxLength: 255
        admitting_officer:
          type: integer
          description: User who processed the admission
        admitting_officer_username:
          type: string
          readOnly: true
        attending_doctor:
          type: integer
          nullable: true
          description: Doctor attending the patient
        attending_doctor_username:
          type: string
          readOnly: true
        ward:
          type: integer
          description: Ward where patient is admitted
        ward_name:
          type: string
          readOnly: true
        ward_type:
          type: string
          readOnly: true
        bed:
          type: integer
          nullable: true
          description: Bed ID. Optional when auto_assign_bed=true is provided.
        bed_number:
          type: string
          readOnly: true
        admission_status:
          allOf:
          - $ref: '#/components/schemas/AdmissionStatusEnum'
          readOnly: true
          description: |-
            Current admission status

            * `ACTIVE` - Active
            * `DISCHARGED` - Discharged
            * `TRANSFERRED_OUT` - Transferred Out
            * `DECEASED` - Deceased
            * `ABSCONDED` - Absconded
