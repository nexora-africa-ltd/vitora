          type: string
          description: Primary ICD-11 diagnosis code
          maxLength: 10
        primary_diagnosis_description:
          type: string
          maxLength: 255
        secondary_diagnosis_codes:
          description: List of secondary ICD-11 diagnosis codes
        claimed_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          description: Total amount claimed
        approved_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          description: Amount approved by SHA
        paid_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          description: Amount actually paid
        patient_copay:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
          description: Amount to be paid by patient
        submission_method:
          $ref: '#/components/schemas/ShaClaimSubmissionMethodEnum'
        submitted_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        submitted_by:
          type: integer
          readOnly: true
          nullable: true
        submitted_by_username:
          type: string
          readOnly: true
          nullable: true
        adjudication_date:
          type: string
          format: date
          readOnly: true
          nullable: true
        adjudication_notes:
          type: string
          readOnly: true
        rejection_reason:
          type: string
          readOnly: true
        rejection_code:
          type: string
          readOnly: true
        payment_date:
          type: string
          format: date
          readOnly: true
          nullable: true
        payment_reference:
          type: string
          readOnly: true
        preauth_number:
          type: string
          description: Pre-authorization reference number
          maxLength: 50
        preauth_date:
          type: string
          format: date
          nullable: true
        preauth_valid_until:
          type: string
          format: date
          nullable: true
        facility_code:
          type: string
          description: DHA Facility Registry (FR) code — used in FHIR bundles and
            claim submissions. Resolved from billing_config.sha_facility_fr_code >
            dha_fr_code > settings fallback.
          maxLength: 50
        facility_level:
          $ref: '#/components/schemas/FacilityLevelA6eEnum'
        claim_flow:
          allOf:
          - $ref: '#/components/schemas/ClaimFlowEnum'
          readOnly: true
          description: |-
            DHA HIE claim flow (PHC/SHIF/ECCIF), set by flow router

            * `phc` - Primary Health Care (UHC, Level 2-3)
            * `shif` - SHIF (Level 3+, biometric/OTP consent)
            * `eccif` - Emergency (ECCIF, bundled tariffs)
        is_emergency_claim:
          type: boolean
          readOnly: true
          description: Whether this is an emergency claim (ECCIF flow)
        version:
          type: integer
          readOnly: true
        parent_claim:
          type: integer
          readOnly: true
          nullable: true
          description: Original claim if this is a resubmission
        items_count:
          type: integer
          nullable: true
          description: Return count of claim items.
          readOnly: true
        attachments_count:
          type: integer
          description: Return count of attachments.
          readOnly: true
        dha_external_id:
          type: string
          readOnly: true
          description: DHA-side claim identifier returned by /api/v1/claims/visit
        dha_correlation_id:
          type: string
          readOnly: true
          description: Last X-Correlation-Id used when calling DHA HIE
        last_dha_status:
          type: string
          readOnly: true
          description: Last DHA-side status (VISIT_STARTED, SUBMITTED, CLOSED, ...)
        last_dha_payload_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: Timestamp of the most recent successful DHA HIE call
        dha_visit_started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: When /api/v1/claims/visit succeeded for this claim
        dha_invoice_number:
          type: string
          readOnly: true
          description: DHA-side invoice number from ILM preview (e.g. INV/12345/67890)
        dha_discharge_snapshot:
          readOnly: true
          description: Compact discharge-time DHA payload snapshot (status, totals,
            key identifiers) captured for audit/reporting.
        time_barring_deadline:
          type: string
          format: date-time
          readOnly: true
        is_time_barred:
          type: boolean
          readOnly: true
        hours_until_time_barred:
          type: number
          format: double
          readOnly: true
        consent_obtained:
          type: boolean
          description: Check if a valid (non-expired) consent token exists for this
            claim.
          readOnly: true
        encounter_clinician:
          type: object
          additionalProperties: {}
          nullable: true
          description: Return licence details for the clinician assigned to the encounter.
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - adjudication_date
      - adjudication_notes
      - approved_amount
      - attachments_count
      - claim_flow
      - claim_number
      - claim_type
      - claimed_amount
      - consent_obtained
      - created_at
      - dha_correlation_id
      - dha_discharge_snapshot
      - dha_external_id
      - dha_invoice_number
      - dha_visit_started_at
      - encounter
      - encounter_clinician
      - facility_code
      - facility_level
      - hours_until_time_barred
      - id
      - invoice_number
      - is_emergency_claim
      - is_time_barred
      - items_count
      - last_dha_payload_at
      - last_dha_status
      - paid_amount
      - parent_claim
      - patient
      - patient_copay
      - patient_name
      - payment_date
      - payment_reference
      - primary_diagnosis_code
      - primary_diagnosis_description
      - rejection_code
      - rejection_reason
      - service_date
      - sha_claim_reference
      - sha_member_number
      - status
      - submitted_at
      - submitted_by
      - submitted_by_username
      - time_barring_deadline
      - updated_at
      - version
