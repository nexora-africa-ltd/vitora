        required: true
      - in: query
        name: group_by
        schema:
          type: string
        description: '''category'', ''item_type'', or ''payment_method'''
      - in: query
        name: refresh
        schema:
          type: boolean
        description: Bypass cache
      - in: query
        name: start_date
        schema:
          type: string
          format: date
        description: Start date (YYYY-MM-DD)
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
