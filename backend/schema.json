    QualityMeasureRequest:
      type: object
      description: Serializer for QualityMeasure model.
      properties:
        code:
          type: string
          minLength: 1
          description: Unique measure code (e.g., 'KE-CQM-001', 'KHIS-ANC-01')
          maxLength: 30
        name:
          type: string
          minLength: 1
          description: Human-readable measure name
          maxLength: 200
        description:
          type: string
          description: Full description of what this measure assesses
        domain:
          $ref: '#/components/schemas/DomainEnum'
        status:
          $ref: '#/components/schemas/QualityMeasureStatusEnum'
        numerator_logic:
          type: string
          minLength: 1
          description: JSON or text description of the numerator criteria. E.g., 'patients
            with HbA1c < 7% in the reporting period'
        denominator_logic:
          type: string
          minLength: 1
          description: JSON or text description of the denominator criteria. E.g.,
            'all diabetic patients enrolled in the reporting period'
        exclusion_logic:
          type: string
          description: Criteria for excluding patients from the denominator
        target_percentage:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Target performance percentage (e.g., 90.00 for 90%)
        low_threshold:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Below this percentage is considered poor performance
        reporting_period:
          $ref: '#/components/schemas/PeriodTypeEnum'
        dhis2_indicator_id:
          type: string
          description: DHIS2 indicator ID for mapping
          maxLength: 50
        reference_url:
          type: string
          format: uri
          description: URL to measure specification or evidence base
          maxLength: 200
        applicable_clinic_types:
          description: List of clinic type codes this measure applies to. Empty list
            means all clinic types.
        evaluation_rule:
          nullable: true
      required:
      - code
      - denominator_logic
      - name
      - numerator_logic
