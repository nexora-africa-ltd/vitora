          application/json:
            schema:
              type: object
              required:
              - new_bed_id
              - override_reason
              - justification
              properties:
                new_bed_id:
                  type: integer
                  description: ID of the new bed
                override_reason:
                  type: string
                  enum:
                  - PATIENT_REQUEST
                  - STAFF_UNAVAILABLE
                  - EMERGENCY
                  - SPECIALIZATION_NEEDED
                  - LOAD_BALANCING
                  - ADMINISTRATIVE
