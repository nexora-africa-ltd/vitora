  /api/lab/specimens/:
    get:
      operationId: api_lab_specimens_list
      description: |-
        ViewSet for specimens — read-only.

        Provides list and retrieve operations for specimen tracking.
        Specimens are created automatically via signals when lab orders/queue entries are created.

        Lookup is by barcode (unique identifier).
      parameters:
      - in: query
        name: collected_at__gte
        schema:
          type: string
          format: date-time
      - in: query
        name: collected_at__lte
        schema:
          type: string
          format: date-time
      - in: query
        name: created_at__gte
        schema:
          type: string
          format: date-time
      - in: query
        name: created_at__lte
        schema:
          type: string
          format: date-time
      - in: query
        name: lab_order
        schema:
          type: integer
      - in: query
        name: order_number
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: patient
        schema:
          type: number
      - in: query
        name: specimen_type
        schema:
          type: string
          enum:
          - ASPIRATE
          - BLOOD
          - CSF
          - OTHER
          - PLASMA
          - SERUM
          - SPUTUM
          - STOOL
          - SWAB
          - TISSUE
          - URINE
        description: |-
          * `BLOOD` - Whole Blood
          * `SERUM` - Serum
          * `PLASMA` - Plasma
          * `URINE` - Urine
          * `STOOL` - Stool
          * `CSF` - Cerebrospinal Fluid
          * `SPUTUM` - Sputum
          * `SWAB` - Swab
          * `TISSUE` - Tissue
          * `ASPIRATE` - Aspirate
          * `OTHER` - Other
      - in: query
        name: status
        schema:
          type: string
          enum:
          - COLLECTED
          - DISPOSED
          - PENDING
          - PROCESSING
          - RECEIVED
          - REJECTED
          - STORED
        description: |-
          * `PENDING` - Pending Collection
          * `COLLECTED` - Collected
          * `RECEIVED` - Received at Lab
          * `PROCESSING` - Processing
          * `REJECTED` - Rejected
          * `STORED` - Stored
          * `DISPOSED` - Disposed
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSpecimenList'
          description: ''
