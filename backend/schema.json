    SHAClaim:
      type: object
      description: Serializer for SHA claims.
      properties:
        id:
          type: integer
          readOnly: true
        claim_number:
          type: string
          readOnly: true
          description: 'Internal claim reference (format: CLM-YYYYMMDD-XXXX)'
        sha_claim_reference:
          type: string
          readOnly: true
          description: SHA-assigned claim reference number
        patient:
          type: integer
        patient_name:
          type: string
          description: Return patient's full name.
          readOnly: true
        sha_member:
          type: integer
          nullable: true
        sha_member_number:
          type: string
          readOnly: true
        encounter:
          type: integer
        invoice:
          type: integer
          nullable: true
        invoice_number:
          type: string
          readOnly: true
        claim_type:
          $ref: '#/components/schemas/ClaimType539Enum'
        status:
          allOf:
          - $ref: '#/components/schemas/ShaClaimStatusEnum'
          readOnly: true
        service_date:
          type: string
          format: date
          description: Date service was provided
        admission_date:
          type: string
          format: date
          nullable: true
          description: Admission date (for inpatient claims)
        discharge_date:
          type: string
          format: date
          nullable: true
          description: Discharge date (for inpatient claims)
