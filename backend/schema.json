        visit_reason:
          allOf:
          - $ref: '#/components/schemas/VisitReasonA04Enum'
          description: |-
            Reason for visit

            * `NEW_COMPLAINT` - New Complaint
            * `FOLLOW_UP` - Follow-up
            * `CHRONIC_CARE` - Chronic Care Review
            * `SCHEDULED_PROCEDURE` - Scheduled Procedure
            * `PROCEDURE_REVIEW` - Post-Procedure Review
            * `REFILL_ONLY` - Medication Refill Only
            * `LAB_REVIEW` - Lab Results Review
            * `REFERRAL_VISIT` - Referral from Another Facility
            * `OTHER` - Other
    PatchedFacilityBillingConfigCreateRequest:
      type: object
      description: |-
        Serializer for creating/updating FacilityBillingConfig.

        M-Pesa secrets are accepted as write-only fields and stored via
        KMS-encrypted property setters on the model.
      properties:
        facility:
          type: integer
          description: The facility this billing config belongs to.
        default_payment_type:
          allOf:
          - $ref: '#/components/schemas/PaymentTypeEnum'
          description: |-
            Default payment type for new invoices at this facility.

            * `cash` - Cash
            * `mpesa` - M-Pesa
            * `insurance` - Insurance
            * `corporate` - Corporate Account
            * `mixed` - Mixed Payment
        default_due_days:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Default number of days until invoice is due.
        auto_finalize_on_checkout:
          type: boolean
          description: Automatically finalize draft invoices when patient checks out.
        tax_rate:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          description: Default tax rate (percentage) applied to invoices. 0 = exempt.
        sha_accreditation_status:
          allOf:
          - $ref: '#/components/schemas/ShaAccreditationStatusEnum'
          description: |-
            Current SHA accreditation status for this facility.

            * `not_applied` - Not Applied
            * `pending` - Application Pending
            * `accredited` - Accredited
            * `conditional` - Conditional Accreditation
            * `suspended` - Suspended
            * `revoked` - Revoked
            * `expired` - Expired
        sha_accreditation_date:
          type: string
          format: date
          nullable: true
          description: Date when SHA accreditation was granted.
        sha_accreditation_expiry:
          type: string
          format: date
          nullable: true
          description: Date when current SHA accreditation expires.
        sha_contract_number:
          type: string
          description: SHA contract reference number.
          maxLength: 50
        sha_contract_start:
          type: string
          format: date
          nullable: true
          description: Date when the SHA contract became effective.
        sha_contract_end:
          type: string
          format: date
          nullable: true
          description: Date when the SHA contract expires.
        sha_service_level:
          type: string
          description: SHA service level agreement tier (e.g., 'Comprehensive', 'Basic').
          maxLength: 50
        sha_max_claim_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          nullable: true
          description: Maximum single claim amount allowed under this contract.
        hide_capitation_interventions:
          type: boolean
          description: When enabled, intervention lookups for this facility hide CAPITATION
            codes unless explicitly requested via payment_mechanism.
        fee_schedule_name:
          type: string
          description: Name of the fee schedule applied at this facility.
          maxLength: 100
        fee_schedule_override:
          description: Service code → price overrides. Keys are service codes, values
            are unit prices.
        mpesa_paybill:
          type: string
          description: M-Pesa paybill number for this facility.
          maxLength: 20
        mpesa_account_ref:
          type: string
          description: Default M-Pesa account reference / till number.
          maxLength: 50
        bank_name:
          type: string
          description: Bank name for the facility's collection account.
          maxLength: 100
        bank_account_number:
          type: string
          description: Bank account number for collections.
          maxLength: 50
        bank_branch:
          type: string
          description: Bank branch name.
          maxLength: 100
        mpesa_consumer_key:
          type: string
          writeOnly: true
          default: ''
        mpesa_consumer_secret:
          type: string
          writeOnly: true
          default: ''
        mpesa_passkey:
          type: string
          writeOnly: true
          default: ''
        mpesa_shortcode:
          type: string
          description: M-Pesa business shortcode (paybill/till) for STK Push.
          maxLength: 20
        mpesa_callback_url:
          type: string
          format: uri
          description: Callback URL Safaricom will POST payment results to.
          maxLength: 500
        mpesa_environment:
          allOf:
          - $ref: '#/components/schemas/MpesaEnvironmentEnum'
          description: |-
            Daraja API environment (sandbox or production).

            * `sandbox` - Sandbox
            * `production` - Production
        sha_consumer_key:
          type: string
          writeOnly: true
          default: ''
        sha_client_id:
          type: string
          writeOnly: true
          default: ''
        sha_client_secret:
          type: string
          writeOnly: true
          default: ''
        sha_username:
          type: string
          writeOnly: true
          default: ''
        sha_password:
          type: string
          writeOnly: true
          default: ''
        sha_agent_code:
          type: string
          description: DHA agent identifier (e.g., DHABP05113).
          maxLength: 50
        sha_facility_fr_code:
          type: string
          description: Facility Registry code for DHA/ILM API calls.
          maxLength: 50
        sha_encrypted_pin:
          type: string
          description: Pre-encrypted DHA PIN (stored as-is, already encrypted by DHA).
        sha_api_environment:
          allOf:
          - $ref: '#/components/schemas/ShaApiEnvironmentEnum'
          description: |-
            DHA ILM API environment (sandbox or production).

            * `sandbox` - Sandbox (UAT)
            * `production` - Production
        automation_rules:
          type: array
          items:
            type: object
            additionalProperties: {}
          writeOnly: true
    PatchedFacilityDetailRequest:
      type: object
      description: |-
        Full serializer for facility detail / retrieve views.

        Includes the complete module capability map (``modules``) as a nested
        dictionary, plus resolved location names.  ``enabled_module_names``
        provides a convenience list of only the enabled modules for quick
        frontend rendering.

        ``effective_logo_url`` returns the facility's own logo URL if set,
        otherwise falls back to the parent organization's logo URL.
      properties:
        organization:
          type: integer
          nullable: true
          description: Parent organization (tenant) that owns this facility.
        mfl_code:
          type: string
          minLength: 1
          description: Kenya Master Facility List (MFL) code – the unique identifier
            assigned to every registered health facility by the MoH.
          maxLength: 20
        name:
          type: string
          minLength: 1
          description: Official facility name as registered on the MFL.
          maxLength: 200
        level:
          allOf:
          - $ref: '#/components/schemas/FacilityLevelEnum'
          description: |-
            KEPH level (1–6) determining the scope of services offered.

            * `1` - Level 1 – Community Unit
            * `2` - Level 2 – Dispensary
            * `3` - Level 3 – Health Centre
            * `4` - Level 4 – Sub-County Hospital
            * `5` - Level 5 – County Referral Hospital
            * `6` - Level 6 – National Referral Hospital
        level_subtype:
          allOf:
          - $ref: '#/components/schemas/LevelSubtypeEnum'
          description: |-
            Optional KEPH subtype band (e.g. A/B/C for Level 3/4 variants).

            * `A` - A
            * `B` - B
            * `C` - C
        ownership:
          allOf:
          - $ref: '#/components/schemas/FacilityOwnershipEnum'
          description: |-
            Ownership category (GOK, FBO, NGO, or Private).

            * `GOK` - Government of Kenya
            * `FBO` - Faith-Based Organization
            * `NGO` - Non-Governmental Organization
            * `PRIVATE` - Private Practice
        is_headquarters:
          type: boolean
          description: Whether this is the main branch of the organization.
        branch_code:
          type: string
          description: Internal branch identifier within the organization.
          maxLength: 50
        logo:
          type: string
          format: binary
          nullable: true
          description: Facility logo for branding. Falls back to organization logo
            if not set.
        county:
          type: integer
          description: County where the facility is located.
        sub_county:
          type: integer
          description: Sub-county where the facility is located.
        ward:
          type: integer
          nullable: true
          description: Ward where the facility is located (optional).
        sha_contracted:
          type: boolean
          description: Whether the facility is contracted by the Social Health Authority
            (SHA) for claims processing.
        sha_contract_expiry:
          type: string
          format: date
          nullable: true
          description: Date when the current SHA contract expires.
        sha_facility_code:
          type: string
          description: SHA-specific facility code used in claims submission.
          maxLength: 50
        workstation_id:
          type: string
          default: ''
        biometrics_enforced:
          type: boolean
          default: false
        biometrics_agent_national_id:
          type: string
          default: ''
        dhis2_org_unit:
          type: string
          description: DHIS2 Organisation Unit UID for this facility. Each facility
            has a unique 11-character UID in KHIS.
          maxLength: 11
        has_outpatient:
          type: boolean
          description: Outpatient Department (OPD) services.
        has_inpatient:
          type: boolean
          description: Inpatient (ward admission) services.
        has_emergency:
          type: boolean
          description: Emergency / Casualty department.
        has_pharmacy:
          type: boolean
          description: Pharmacy / dispensing services.
        has_laboratory:
          type: boolean
          description: Laboratory / diagnostics services.
        has_imaging:
          type: boolean
          description: Radiology / imaging services.
        has_theatre:
          type: boolean
          description: Surgical theatre / operating room.
        has_dialysis:
          type: boolean
          description: Renal dialysis unit.
        has_icu:
          type: boolean
          description: Intensive Care Unit (ICU).
        has_hdu:
          type: boolean
          description: High Dependency Unit (HDU).
        has_nbu:
          type: boolean
          description: Newborn Unit (NBU).
        has_maternity:
          type: boolean
          description: Maternity / obstetrics services.
        has_mortuary:
          type: boolean
          description: Mortuary / funeral services.
        has_blood_bank:
          type: boolean
          description: Blood bank / transfusion services.
        has_inventory:
          type: boolean
          description: Inventory / supply chain management module.
        has_lis_standalone:
          type: boolean
          description: 'LIS standalone mode: lab operates independently without full
            HMIS.'
        has_pharmacy_standalone:
          type: boolean
          description: 'Pharmacy standalone mode: pharmacy operates as a retail/walk-in
            dispensary without full HMIS.'
        has_imaging_standalone:
          type: boolean
          description: 'Imaging standalone mode: imaging operates independently (e.g.,
            diagnostic centre) without full HMIS.'
        has_triage:
          type: boolean
          description: Triage / patient acuity assessment.
        has_scheduling:
          type: boolean
          description: Appointment scheduling and roster management.
        has_surveillance:
          type: boolean
          description: Disease surveillance and outbreak reporting.
        has_immunizations:
          type: boolean
          description: Immunization / vaccination programme.
        has_allied_health:
          type: boolean
          description: Allied health services (physiotherapy, nutrition, social work,
            etc.).
        has_quality:
          type: boolean
          description: Quality improvement and clinical audit.
        has_billing:
          type: boolean
          description: Billing, invoicing, and financial management.
        has_private_insurance:
          type: boolean
          description: Private insurance claims, pre-authorizations, and remittances.
        has_moh_reporting:
          type: boolean
          description: MOH 705/711/717 aggregate reporting and DHIS2 submission.
        has_ai_assistant:
          type: boolean
          description: TibaBot AI assistant available at this facility (requires plan
            ai_assistant feature).
        has_cds:
          type: boolean
          description: Clinical Decision Support (CDS) available at this facility
            (requires plan ai_assistant feature).
        has_procedures:
          type: boolean
          description: Clinical procedures / treatment room capability at this facility.
        has_analytics:
          type: boolean
          description: Analytics and BI dashboards enabled at this facility (requires
            plan custom_reports feature).
        operating_mode:
          allOf:
          - $ref: '#/components/schemas/FacilityOperatingModeEnum'
          description: |-
            Top-level facility mode. Choosing a standalone mode disables clinical workflow modules (inpatient, ER, triage, etc.) and enables the relevant standalone module + billing + inventory.

            * `FULL_HMIS` - Full HMIS
            * `STANDALONE_LAB` - Standalone Lab
            * `STANDALONE_PHARMACY` - Standalone Pharmacy
            * `STANDALONE_IMAGING` - Standalone Imaging
            * `STANDALONE_DIAGNOSTIC` - Standalone Diagnostic Centre
        is_active:
          type: boolean
          description: Whether the facility is currently operational.
