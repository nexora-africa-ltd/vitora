          default: ''
        vaccine_manufacturer:
          type: string
          minLength: 1
          default: ''
        diluent_batch_number:
          type: string
          minLength: 1
          default: ''
        diluent_manufacturer:
          type: string
          minLength: 1
          default: ''
        diluent_expiry_date:
          type: string
          format: date
          nullable: true
        notes:
          type: string
          minLength: 1
