    WaitTimeBreach:
      type: object
      description: Read serializer for wait time breach alerts.
      properties:
        id:
          type: integer
          readOnly: true
        queue_entry:
          type: integer
          readOnly: true
          description: Queue entry whose wait time was breached
        triage_assessment:
          type: integer
          readOnly: true
          description: Associated triage assessment
        patient:
          type: integer
          readOnly: true
          description: Patient whose wait time was breached
        patient_name:
          type: string
          readOnly: true
        patient_mrn:
          type: string
          readOnly: true
        triage_category:
          type: string
          readOnly: true
          description: Triage category at breach time
        severity:
          allOf:
          - $ref: '#/components/schemas/WaitTimeBreachSeverityEnum'
          readOnly: true
          description: |-
            Severity derived from triage category

            * `CRITICAL` - Critical – RED category breach (> 0 min)
            * `URGENT` - Urgent – ORANGE category breach (> 10 min)
            * `WARNING` - Warning – YELLOW category breach (> 60 min)
            * `INFO` - Informational – GREEN/BLUE category breach
        target_wait_minutes:
          type: integer
          readOnly: true
          description: KETA target wait time in minutes for this category
        actual_wait_minutes:
          type: integer
          readOnly: true
          description: Actual wait time in minutes when breach was detected
        assigned_area:
          type: string
          readOnly: true
          description: ER zone where patient is waiting
        assigned_area_display:
          type: string
          description: Get human-readable area name.
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/WaitTimeBreachStatusEnum'
          readOnly: true
        acknowledged_by:
          type: integer
          readOnly: true
          nullable: true
        acknowledged_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        notes:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - acknowledged_at
      - acknowledged_by
      - actual_wait_minutes
      - assigned_area
      - assigned_area_display
      - created_at
      - id
      - notes
      - patient
      - patient_mrn
      - patient_name
      - queue_entry
      - severity
      - status
      - target_wait_minutes
      - triage_assessment
      - triage_category
      - updated_at
    WaitTimeBreachAcknowledgeRequest:
      type: object
      description: Serializer for acknowledging a wait time breach.
      properties:
        notes:
          type: string
          minLength: 1
          default: ''
          description: Optional notes when acknowledging
    WaitTimeBreachSeverityEnum:
      enum:
      - CRITICAL
      - URGENT
      - WARNING
      - INFO
      type: string
      description: |-
        * `CRITICAL` - Critical – RED category breach (> 0 min)
        * `URGENT` - Urgent – ORANGE category breach (> 10 min)
        * `WARNING` - Warning – YELLOW category breach (> 60 min)
        * `INFO` - Informational – GREEN/BLUE category breach
    WaitTimeBreachStatusEnum:
      enum:
      - ACTIVE
      - ACKNOWLEDGED
      - ESCALATED
      - RESOLVED
      type: string
      description: |-
        * `ACTIVE` - Active – Unacknowledged
        * `ACKNOWLEDGED` - Acknowledged by staff
        * `ESCALATED` - Escalated to charge nurse/supervisor
        * `RESOLVED` - Resolved – Patient seen or left
