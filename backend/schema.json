          enum:
          - EXTERNAL
          - IN_HOUSE
        description: |-
          * `IN_HOUSE` - In-House Processing
          * `EXTERNAL` - External Lab Referral
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: patient
        schema:
          type: integer
      - in: query
        name: priority
        schema:
          type: string
          enum:
          - ROUTINE
          - STAT
          - URGENT
        description: |-
          * `ROUTINE` - Routine
          * `URGENT` - Urgent
          * `STAT` - STAT (Immediate)
      - in: query
        name: status
        schema:
          type: string
          enum:
          - CANCELLED
          - COMPLETED
          - DRAFT
          - IN_PROGRESS
          - ORDERED
          - REJECTED
          - SPECIMEN_COLLECTED
        description: |-
          * `DRAFT` - Draft
          * `ORDERED` - Ordered
          * `SPECIMEN_COLLECTED` - Specimen Collected
          * `IN_PROGRESS` - In Progress
          * `COMPLETED` - Completed
          * `CANCELLED` - Cancelled
          * `REJECTED` - Rejected
