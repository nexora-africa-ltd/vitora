    ERBed:
      type: object
      description: Full ER bed detail serializer.
      properties:
        id:
          type: integer
          readOnly: true
        zone:
          allOf:
          - $ref: '#/components/schemas/ZoneEnum'
          description: |-
            ER zone this bed belongs to

            * `ER_RESUS` - ER - Resuscitation
            * `ER_ACUTE` - ER - Acute Care
            * `ER_FAST_TRACK` - ER - Fast Track
            * `OBSERVATION` - Observation Unit
            * `TRAUMA` - Trauma Bay
            * `PEDIATRIC_ER` - Pediatric ER
            * `MATERNITY` - Maternity/Labor
        zone_display:
          type: string
          readOnly: true
        bed_number:
          type: string
          description: Bed/bay identifier within zone (e.g., 'R-01', 'A-05')
          maxLength: 20
        status:
          allOf:
          - $ref: '#/components/schemas/Status4ccEnum'
          description: |-
            Current bed status

            * `AVAILABLE` - Available
            * `OCCUPIED` - Occupied
            * `CLEANING` - Cleaning
            * `OUT_OF_SERVICE` - Out of Service
        status_display:
          type: string
          readOnly: true
        current_patient:
          type: integer
          nullable: true
          description: Patient currently occupying this bed
        patient_name:
          type: string
          readOnly: true
        patient_mrn:
          type: string
          readOnly: true
        current_triage_assessment:
          type: integer
          nullable: true
          description: Triage assessment for current occupant
        triage_category:
          type: string
          readOnly: true
        occupied_duration_minutes:
          type: integer
          readOnly: true
        is_available:
          type: boolean
          readOnly: true
        notes:
          type: string
          description: Additional notes (cleaning reason, out-of-service reason, etc.)
        status_changed_at:
          type: string
          format: date-time
          readOnly: true
          description: When the bed status last changed
        status_changed_by:
          type: integer
          readOnly: true
          nullable: true
          description: User who last changed the bed status
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - bed_number
      - created_at
      - id
      - is_available
      - occupied_duration_minutes
      - patient_mrn
      - patient_name
      - status_changed_at
      - status_changed_by
      - status_display
      - triage_category
      - zone
      - zone_display
