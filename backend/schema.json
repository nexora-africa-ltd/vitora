        organization_name:
          type: string
          readOnly: true
          nullable: true
        registered_at_facility:
          type: integer
          readOnly: true
          nullable: true
          description: Facility where the patient was first registered.
        registered_at_facility_name:
          type: string
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
