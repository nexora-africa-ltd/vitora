    FacilityDailySummary:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        facility:
          type: integer
          readOnly: true
          nullable: true
          description: Facility (branch) where this record was created.
        facility_name:
          type: string
          readOnly: true
        date:
          type: string
          format: date
          readOnly: true
          description: Calendar date for this summary.
        new_patients:
          type: integer
          readOnly: true
          description: Patients registered on this date.
        total_patients:
          type: integer
          readOnly: true
          description: Cumulative patient count as of this date.
        encounters_opd:
          type: integer
          readOnly: true
        encounters_ipd:
          type: integer
          readOnly: true
        encounters_emergency:
          type: integer
          readOnly: true
        encounters_other:
          type: integer
          readOnly: true
          description: ANC, follow-up, specialist, etc.
        encounters_total:
          type: integer
          readOnly: true
        revenue_total:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
          readOnly: true
          description: Sum of completed payments on this date.
        revenue_cash:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
          readOnly: true
        revenue_mpesa:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
          readOnly: true
        revenue_insurance:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
          readOnly: true
        invoices_created:
          type: integer
          readOnly: true
        outstanding_balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
          readOnly: true
          description: Total unpaid balance across all open invoices as of this date.
        lab_orders_placed:
          type: integer
          readOnly: true
        lab_orders_completed:
          type: integer
          readOnly: true
        lab_critical_results:
          type: integer
          readOnly: true
        prescriptions_dispensed:
          type: integer
          readOnly: true
        low_stock_alerts:
          type: integer
          readOnly: true
        triage_assessments:
          type: integer
          readOnly: true
        triage_emergency_count:
          type: integer
          readOnly: true
        avg_wait_time_minutes:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,1})?$
          readOnly: true
          description: Average triage-to-consultation wait time in minutes.
        current_admissions:
          type: integer
          readOnly: true
        new_admissions:
          type: integer
          readOnly: true
        discharges:
          type: integer
          readOnly: true
        bed_occupancy_rate:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          readOnly: true
          description: Percentage of beds occupied (0–100).
        return_patients:
          type: integer
          readOnly: true
          description: Patients with a prior encounter before this date.
        walk_ins:
          type: integer
          readOnly: true
          description: Patients registered with referral_source='self'.
        referral_ins:
          type: integer
          readOnly: true
          description: Patients registered referred from another facility.
        clinic_referrals:
          type: integer
          readOnly: true
          description: Patients referred from a clinic.
        follow_up_encounters:
          type: integer
          readOnly: true
          description: Encounters of type FOLLOW_UP.
        created_at:
          type: string
          format: date-time
          readOnly: true
