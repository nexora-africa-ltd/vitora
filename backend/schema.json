        - Audit logging
      parameters:
      - in: query
        name: assigned_area
        schema:
          type: string
          enum:
          - ER_ACUTE
          - ER_FAST_TRACK
          - ER_RESUS
          - MATERNITY
          - OBSERVATION
          - OPD
          - PEDIATRIC_ER
          - SPECIALTY
          - TRAUMA
        description: |-
          Emergency care area assignment (ER zones). Use for emergency cases.

          * `ER_RESUS` - ER - Resuscitation
          * `ER_ACUTE` - ER - Acute Care
          * `ER_FAST_TRACK` - ER - Fast Track
          * `OBSERVATION` - Observation Unit
          * `OPD` - Outpatient Department
          * `TRAUMA` - Trauma Bay
          * `PEDIATRIC_ER` - Pediatric ER
          * `MATERNITY` - Maternity/Labor
          * `SPECIALTY` - Specialty Clinic
      - in: query
        name: encounter
        schema:
          type: integer
      - in: query
        name: mental_status
        schema:
          type: string
          enum:
          - A
          - P
          - U
          - V
        description: |-
          AVPU mental status scale

          * `A` - Alert
          * `V` - Responds to Voice
          * `P` - Responds to Pain
          * `U` - Unresponsive
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
