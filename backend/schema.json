    InpatientWard:
      type: object
      description: Serializer for Ward model (inpatient-specific with occupancy stats).
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          description: Unique ward name (e.g., 'Medical Ward 1')
          maxLength: 100
        code:
          type: string
          description: Unique ward code (e.g., 'MED-01')
          maxLength: 20
        ward_type:
          allOf:
          - $ref: '#/components/schemas/WardTypeEnum'
          description: |-
            Type of ward

            * `MEDICAL` - Medical Ward
            * `SURGICAL` - Surgical Ward
            * `PEDIATRIC` - Pediatric Ward
            * `MATERNITY` - Maternity Ward
            * `ICU` - Intensive Care Unit
            * `ISOLATION` - Isolation Ward
        ward_type_display:
          type: string
          readOnly: true
        floor:
          type: string
          description: Floor location
          maxLength: 50
        capacity:
          type: integer
          maximum: 9223372036854775807
          minimum: 1
          format: int64
          description: Total bed count (must be positive)
        description:
          type: string
          description: Ward description
        is_active:
          type: boolean
          description: Whether ward is currently active
        daily_rate:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          description: Bed charge per day (must be positive)
        gender_restriction:
          allOf:
          - $ref: '#/components/schemas/GenderRestrictionEnum'
          description: |-
            Gender restriction for patient admission

            * `ANY` - Any Gender
            * `MALE_ONLY` - Male Only
            * `FEMALE_ONLY` - Female Only
        min_age_years:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Minimum patient age in years (null = no minimum)
        max_age_years:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          nullable: true
          description: Maximum patient age in years (null = no maximum)
        isolation_capable:
          type: boolean
          description: Whether ward can handle isolation patients
        oxygen_equipped:
          type: boolean
          description: Whether beds have oxygen supply
        ventilator_capable:
          type: boolean
          description: Whether ward supports ventilated patients
        available_beds:
          type: integer
          description: |-
            Count of available beds (capacity minus occupied, maintenance, reserved).

            Returns:
                Number of available beds
          readOnly: true
        total_beds:
          type: integer
          description: |-
            Total bed capacity of this ward.

            Returns:
                Ward capacity (total number of beds)
          readOnly: true
        occupied_beds:
          type: integer
          description: |-
            Count of beds with status OCCUPIED.

            Returns:
                Number of beds in OCCUPIED status
          readOnly: true
        occupancy_rate:
          type: number
          format: double
          description: |-
            Current occupancy percentage based on capacity.

            Returns:
                Occupancy rate as percentage (0-100)
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - available_beds
      - capacity
      - code
      - created_at
      - daily_rate
      - id
      - name
      - occupancy_rate
      - occupied_beds
      - total_beds
      - updated_at
      - ward_type
      - ward_type_display
