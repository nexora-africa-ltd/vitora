  /api/inpatient/supervisor/alerts/:
    get:
      operationId: api_inpatient_supervisor_alerts_list
      description: List recent admissions with CRITICAL constraint violations that
        were overridden. Requires receive_critical_alerts permission. Used as polling
        fallback for WebSocket alerts.
      summary: List supervisor critical violation alerts
      parameters:
      - in: query
        name: limit
        schema:
          type: integer
        description: 'Maximum number of alerts to return (default: 20)'
      - in: query
        name: since
        schema:
          type: string
        description: ISO timestamp to filter alerts after (optional)
      tags:
      - Inpatient - Supervisor Alerts
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/SupervisorAlertsResponse'
          description: ''
        '403':
          content:
            application/json:
              schema:
                description: Permission denied - requires receive_critical_alerts
                  permission
          description: ''
  /api/inpatient/supervisor/alerts/acknowledge/:
    post:
      operationId: api_inpatient_supervisor_alerts_acknowledge_create
      description: Acknowledge a critical constraint violation that was overridden
        during admission. Requires receive_critical_alerts permission.
      summary: Acknowledge a supervisor critical violation alert
      tags:
      - Inpatient - Supervisor Alerts
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                admission_id:
                  type: integer
                  description: Admission ID to acknowledge
                notes:
                  type: string
                  description: Optional notes from supervisor
              required:
              - admission_id
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                description: Alert acknowledged successfully
          description: ''
        '400':
          content:
            application/json:
              schema:
                description: Invalid request or already acknowledged
          description: ''
        '403':
          content:
            application/json:
              schema:
                description: Permission denied
          description: ''
        '404':
          content:
            application/json:
              schema:
                description: Admission not found or has no critical violations
          description: ''
  /api/inpatient/supervisor/alerts/metrics/:
    get:
      operationId: api_inpatient_supervisor_alerts_metrics_retrieve
      description: Get statistics on constraint overrides including counts, rates,
        breakdown by violation type and ward, and common override reasons. Requires
        receive_critical_alerts permission.
      summary: Get constraint override metrics
