    QualityDashboard:
      type: object
      description: Serializer for quality dashboard summary data.
      properties:
        total_measures:
          type: integer
        active_measures:
          type: integer
        measures_meeting_target:
          type: integer
        measures_below_threshold:
          type: integer
        overall_compliance_rate:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
        domain_summary:
          type: array
          items:
            type: object
            additionalProperties: {}
        trend_data:
          type: array
          items:
            type: object
            additionalProperties: {}
      required:
      - active_measures
      - domain_summary
      - measures_below_threshold
      - measures_meeting_target
      - overall_compliance_rate
      - total_measures
      - trend_data
    QualityMeasure:
      type: object
      description: Serializer for QualityMeasure model.
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          description: Unique measure code (e.g., 'KE-CQM-001', 'KHIS-ANC-01')
          maxLength: 30
        name:
          type: string
          description: Human-readable measure name
          maxLength: 200
        description:
          type: string
          description: Full description of what this measure assesses
        domain:
          $ref: '#/components/schemas/DomainEnum'
        domain_display:
          type: string
          readOnly: true
        status:
          $ref: '#/components/schemas/QualityMeasureStatusEnum'
        status_display:
          type: string
          readOnly: true
        numerator_logic:
          type: string
          description: JSON or text description of the numerator criteria. E.g., 'patients
            with HbA1c < 7% in the reporting period'
        denominator_logic:
          type: string
          description: JSON or text description of the denominator criteria. E.g.,
            'all diabetic patients enrolled in the reporting period'
        exclusion_logic:
          type: string
          description: Criteria for excluding patients from the denominator
        target_percentage:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Target performance percentage (e.g., 90.00 for 90%)
        low_threshold:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Below this percentage is considered poor performance
        reporting_period:
          $ref: '#/components/schemas/PeriodTypeEnum'
        reporting_period_display:
          type: string
          readOnly: true
        dhis2_indicator_id:
          type: string
          description: DHIS2 indicator ID for mapping
          maxLength: 50
        reference_url:
          type: string
          format: uri
          description: URL to measure specification or evidence base
          maxLength: 200
        applicable_clinic_types:
          description: List of clinic type codes this measure applies to. Empty list
            means all clinic types.
        evaluation_rule:
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - code
      - created_at
      - denominator_logic
      - domain_display
      - id
      - name
      - numerator_logic
      - reporting_period_display
      - status_display
      - updated_at
    QualityMeasureExportFormatEnum:
      enum:
      - csv
      - json
      - qrda
      type: string
      description: |-
        * `csv` - CSV
        * `json` - JSON
        * `qrda` - QRDA (simplified)
    QualityMeasureExportRequest:
      type: object
      description: Serializer for export format selection.
      properties:
        format:
          allOf:
          - $ref: '#/components/schemas/QualityMeasureExportFormatEnum'
          default: json
        measures:
          type: array
          items:
            type: integer
          description: List of measure IDs to export. Empty exports all.
