          type: string
          readOnly: true
        age_group:
          type: string
          description: Get age group for frontend conditional rendering.
          readOnly: true
        chief_complaint:
          type: string
          description: Primary reason for visit
        chief_complaint_category:
          allOf:
          - $ref: '#/components/schemas/ChiefComplaintCategoryEnum'
          description: |-
            Chief complaint category

            * `CHEST_PAIN` - Chest Pain
            * `DIFFICULTY_BREATHING` - Difficulty Breathing
            * `TRAUMA` - Trauma/Injury
            * `FEVER` - Fever
            * `ABDOMINAL_PAIN` - Abdominal Pain
            * `HEADACHE` - Headache
            * `ALTERED_CONSCIOUSNESS` - Altered Consciousness
            * `BLEEDING` - Bleeding
            * `POISONING` - Poisoning/Overdose
            * `OBSTETRIC` - Obstetric Emergency
            * `PEDIATRIC` - Pediatric Emergency
            * `NEONATAL_SEPSIS` - Neonatal Sepsis
            * `NEONATAL_JAUNDICE` - Neonatal Jaundice
            * `NEONATAL_RESPIRATORY_DISTRESS` - Neonatal Respiratory Distress
            * `BIRTH_ASPHYXIA` - Birth Asphyxia
            * `FEBRILE_CONVULSION` - Febrile Convulsion
            * `CROUP` - Croup
            * `BRONCHIOLITIS` - Bronchiolitis
            * `SEVERE_MALARIA` - Severe Malaria
            * `OTHER` - Other
        pain_score:
          type: integer
          maximum: 10
          minimum: 0
          nullable: true
          description: Pain level 0-10
        mental_status:
          allOf:
          - $ref: '#/components/schemas/MentalStatusEnum'
          description: |-
            AVPU mental status scale

            * `A` - Alert
            * `V` - Responds to Voice
            * `P` - Responds to Pain
            * `U` - Unresponsive
        gcs_eye:
          type: integer
          maximum: 4
          minimum: 1
          nullable: true
          description: 'Eye response: 1=None, 2=To pain, 3=To voice, 4=Spontaneous'
        gcs_verbal:
          type: integer
          maximum: 5
          minimum: 1
          nullable: true
          description: 'Verbal response: 1=None, 2=Sounds, 3=Words, 4=Confused, 5=Oriented'
        gcs_motor:
          type: integer
          maximum: 6
          minimum: 1
          nullable: true
          description: 'Motor response: 1=None, 2=Extension, 3=Flexion, 4=Withdrawal,
            5=Localizes, 6=Obeys'
        gcs_total:
          type: integer
          readOnly: true
          nullable: true
        gcs_severity:
          type: string
          readOnly: true
          nullable: true
        mobility:
          allOf:
          - $ref: '#/components/schemas/MobilityEnum'
          description: |-
            Patient mobility status

            * `AMBULATORY` - Ambulatory
            * `WHEELCHAIR` - Wheelchair
            * `STRETCHER` - Stretcher
            * `IMMOBILE` - Immobile/Carried
        arrival_mode:
          allOf:
          - $ref: '#/components/schemas/ArrivalModeEnum'
          description: |-
            How patient arrived

            * `WALK_IN` - Walk-in
            * `AMBULANCE` - Ambulance
            * `POLICE` - Police
            * `REFERRAL` - Referral from another facility
            * `OTHER` - Other
        referring_facility_name:
          type: string
          description: Name of referring facility (required when arrival_mode is REFERRAL)
          maxLength: 255
        allergies_noted:
          type: string
          description: Allergies noted at triage (snapshot from patient record)
        spo2:
          type: number
          format: double
          nullable: true
        heart_rate:
          type: integer
          maximum: 300
          minimum: 0
          nullable: true
          description: Heart rate (beats per minute)
        systolic_bp:
          type: integer
          maximum: 300
          minimum: 0
          nullable: true
          description: Systolic blood pressure (mmHg)
        diastolic_bp:
          type: integer
          maximum: 200
          minimum: 0
          nullable: true
          description: Diastolic blood pressure (mmHg)
        temperature:
          type: number
          format: double
          nullable: true
        respiratory_rate:
          type: integer
          maximum: 60
          minimum: 0
          nullable: true
          description: Respiratory rate (breaths per minute)
        weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Body weight in kilograms (kg)
        height:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
          description: Body height in centimeters (cm)
        etat_danger_signs:
          description: 'ETAT danger signs present (list of strings). Valid values:
            unable_to_drink, convulsions, lethargy, chest_indrawing, stridor, severe_malnutrition,
            grunting, cyanosis, severe_pallor, hypothermia'
        dehydration_level:
          allOf:
          - $ref: '#/components/schemas/DehydrationLevelEnum'
          description: |-
            WHO dehydration classification (children)

            * `NONE` - No dehydration
            * `SOME` - Some dehydration
            * `SEVERE` - Severe dehydration
        fontanelle_status:
          allOf:
          - $ref: '#/components/schemas/FontanelleStatusEnum'
          description: |-
            Anterior fontanelle status (for infants <18 months)

            * `NORMAL` - Normal
            * `BULGING` - Bulging
            * `SUNKEN` - Sunken
        breastfeeding_ability:
          allOf:
          - $ref: '#/components/schemas/BreastfeedingAbilityEnum'
          description: |-
            Breastfeeding / feeding ability (for infants)

            * `NORMAL` - Normal / able to feed
            * `REDUCED` - Reduced / poor feeding
            * `UNABLE` - Unable to breastfeed / drink
        capillary_refill_seconds:
          type: integer
          maximum: 15
          minimum: 0
          nullable: true
          description: Capillary refill time in seconds (prolonged ≥3s is abnormal)
        muac_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          nullable: true
          description: Mid-Upper Arm Circumference in cm (SAM <11.5, MAM 11.5-12.4)
        triage_category:
          allOf:
          - $ref: '#/components/schemas/TriageCategoryEnum'
          description: |-
            Final triage category

            * `RED` - Emergency - Immediate
            * `ORANGE` - Very Urgent - <10 min
            * `YELLOW` - Urgent - <60 min
            * `GREEN` - Standard - <240 min
            * `BLUE` - Non-Urgent/Referral
        auto_calculated_category:
          allOf:
          - $ref: '#/components/schemas/TriageCategoryEnum'
          readOnly: true
          description: |-
            System-suggested category before nurse override

            * `RED` - Emergency - Immediate
            * `ORANGE` - Very Urgent - <10 min
            * `YELLOW` - Urgent - <60 min
            * `GREEN` - Standard - <240 min
            * `BLUE` - Non-Urgent/Referral
        category_override_reason:
          type: string
          description: Required if nurse overrides system suggestion
        assigned_area:
          allOf:
          - $ref: '#/components/schemas/AssignedAreaEnum'
          description: |-
            Emergency care area assignment (ER zones). Use for emergency cases.

            * `ER_RESUS` - ER - Resuscitation
            * `ER_ACUTE` - ER - Acute Care
            * `ER_FAST_TRACK` - ER - Fast Track
            * `OBSERVATION` - Observation Unit
            * `OPD` - Outpatient Department
            * `TRAUMA` - Trauma Bay
            * `PEDIATRIC_ER` - Pediatric ER
            * `MATERNITY` - Maternity/Labor
            * `SPECIALTY` - Specialty Clinic
        assigned_clinic:
          type: integer
          nullable: true
          description: Target clinic for routing. Mutually exclusive with assigned_area.
        assigned_clinic_name:
          type: string
          readOnly: true
          nullable: true
        routing_destination:
          type: string
          readOnly: true
        assigned_clinician:
          type: integer
          nullable: true
          description: Clinician assigned to this patient
        assigned_clinician_name:
          type: string
          nullable: true
          description: Get the full name of the assigned clinician.
          readOnly: true
        arrival_time:
          type: string
          format: date-time
          description: When patient arrived at facility
        triage_start_time:
          type: string
          format: date-time
          description: When triage assessment began
        triage_end_time:
          type: string
          format: date-time
          nullable: true
          description: When triage completed
        seen_by_clinician_time:
          type: string
          format: date-time
          nullable: true
          description: When patient was seen by clinician
        alerts:
          type: array
          items: {}
          description: |-
            Get alerts in structured format, converting legacy string alerts if needed.

            Legacy format: ['CRITICAL: Message here', 'WARNING: Another message']
            New format: [{'id': 'uuid', 'severity': 'CRITICAL', 'vital_type': 'GENERAL', ...}]
          readOnly: true
        vitals:
          type: object
          additionalProperties: {}
          description: Get vitals captured at triage (fallback to encounter vitals
            if needed).
          readOnly: true
        wait_time_minutes:
          type: integer
          description: Get calculated wait time in minutes.
          readOnly: true
        is_wait_time_exceeded:
          type: boolean
          description: Check if wait time exceeded target.
          readOnly: true
        triaged_by:
          type: integer
          readOnly: true
          description: User who performed triage
        triaged_by_name:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - age_group
      - alerts
      - arrival_time
      - assigned_clinic_name
      - assigned_clinician_name
      - auto_calculated_category
      - chief_complaint
      - chief_complaint_category
      - created_at
      - encounter
      - encounter_mrn
      - gcs_severity
      - gcs_total
      - id
      - is_wait_time_exceeded
      - mental_status
      - mobility
      - patient_age
      - patient_gender
      - patient_mrn
      - patient_name
      - routing_destination
      - triage_category
      - triage_start_time
      - triaged_by
      - triaged_by_name
      - updated_at
      - vitals
      - wait_time_minutes
