    EmergencyAccess:
      type: object
      description: Full serializer for emergency access records.
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
          description: User who invoked emergency access
        user_username:
          type: string
          readOnly: true
        user_full_name:
          type: string
          description: Get user's full name.
          readOnly: true
        patient:
          type: integer
          nullable: true
          description: Patient record being accessed (null for system-wide access)
        patient_mrn:
          type: string
          readOnly: true
          nullable: true
        patient_name:
          type: string
          nullable: true
          description: Get patient's full name.
          readOnly: true
        reason:
          allOf:
          - $ref: '#/components/schemas/ReasonCdbEnum'
          description: |-
            Predefined reason for emergency access

            * `LIFE_THREATENING` - Life-threatening emergency
            * `UNCONSCIOUS_PATIENT` - Patient unconscious/unable to consent
            * `MASS_CASUALTY` - Mass casualty incident
            * `CRITICAL_LAB_RESULT` - Critical lab result requiring immediate action
            * `MEDICATION_EMERGENCY` - Urgent medication information needed
            * `DISASTER_RESPONSE` - Disaster/emergency response
            * `OTHER` - Other (requires justification)
        reason_display:
          type: string
          readOnly: true
        reason_details:
          type: string
          description: Detailed justification for emergency access (required)
        requested_at:
          type: string
          format: date-time
          readOnly: true
          description: When emergency access was requested
        expires_at:
          type: string
          format: date-time
          readOnly: true
          description: When emergency access expires
        duration_minutes:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Duration of emergency access in minutes (max 1440 = 24 hours)
        status:
          allOf:
          - $ref: '#/components/schemas/EmergencyAccessStatusEnum'
          readOnly: true
          description: |-
            Current status of the emergency access

            * `ACTIVE` - Active
            * `EXPIRED` - Expired
            * `REVOKED` - Revoked
            * `REVIEWED` - Reviewed and Closed
        status_display:
          type: string
          readOnly: true
        is_active:
          type: boolean
          readOnly: true
        is_expired:
          type: boolean
          readOnly: true
        remaining_minutes:
          type: integer
          readOnly: true
        approver:
          type: integer
          readOnly: true
          nullable: true
          description: Administrator who reviewed/approved the emergency access
        approver_username:
          type: string
          readOnly: true
          nullable: true
        approved_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: When the emergency access was reviewed
        approval_notes:
          type: string
          description: Notes from the approver during review
        revoked_by:
          type: integer
          readOnly: true
          nullable: true
          description: User who revoked the emergency access
        revoked_by_username:
          type: string
          readOnly: true
          nullable: true
        revoked_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: When the emergency access was revoked
        revocation_reason:
          type: string
          description: Reason for revoking the emergency access
        escalation_sent:
          type: boolean
          readOnly: true
          description: Whether escalation notification was sent
        escalation_sent_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: When escalation notification was sent
        ip_address:
          type: string
          readOnly: true
          nullable: true
          description: IP address of the request
      required:
      - approved_at
      - approver
      - approver_username
      - escalation_sent
      - escalation_sent_at
      - expires_at
