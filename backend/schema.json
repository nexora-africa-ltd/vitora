    SyncConflictDetail:
      type: object
      description: Read serializer for SyncConflict.
      properties:
        id:
          type: integer
          readOnly: true
        model_name:
          type: string
          readOnly: true
          description: Name of the model with conflict
        record_id:
          type: integer
          readOnly: true
          nullable: true
          description: ID of the record with conflict
        field_name:
          type: string
          readOnly: true
          description: Specific field with conflict (if field-level)
        local_data:
          readOnly: true
          description: Local version of the data
        remote_data:
          readOnly: true
          description: Remote version of the data
        resolved_data:
          readOnly: true
          description: Final resolved data
        resolution_strategy:
          allOf:
          - $ref: '#/components/schemas/ResolutionStrategyEnum'
          readOnly: true
          description: |-
            Strategy used to resolve the conflict

            * `LAST_WRITE_WINS` - Last Write Wins
            * `LOCAL_WINS` - Local Wins
            * `REMOTE_WINS` - Remote Wins
            * `MANUAL` - Manual Resolution
            * `MERGED` - Merged
        status:
          allOf:
          - $ref: '#/components/schemas/SyncConflictStatusEnum'
          readOnly: true
          description: |-
            Current resolution status

            * `PENDING` - Pending Resolution
            * `RESOLVED` - Resolved
            * `DISMISSED` - Dismissed
        detected_at:
          type: string
          format: date-time
          readOnly: true
          description: When the conflict was detected
        resolved_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: When the conflict was resolved
        resolved_by:
          type: integer
          readOnly: true
          nullable: true
          description: User who resolved the conflict (if manual)
      required:
      - detected_at
      - field_name
      - id
      - local_data
      - model_name
      - record_id
      - remote_data
      - resolution_strategy
      - resolved_at
      - resolved_by
      - resolved_data
      - status
    SyncConflictResolveRequest:
      type: object
      description: Request to resolve a sync conflict.
      properties:
