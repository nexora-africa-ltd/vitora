          - DIAGNOSTIC
          - EMERGENCY
          - ENT
          - INJECTION
          - MINOR
          - OBSTETRIC
          - OPHTHALMIC
          - OTHER
          - PREVENTIVE
          - SURGICAL
          - THERAPEUTIC
          - WOUND_CARE
        description: |-
          * `MINOR` - Minor Procedure
          * `DIAGNOSTIC` - Diagnostic Procedure
          * `THERAPEUTIC` - Therapeutic Procedure
          * `PREVENTIVE` - Preventive Procedure
          * `EMERGENCY` - Emergency Procedure
          * `DENTAL` - Dental Procedure
          * `OPHTHALMIC` - Ophthalmic Procedure
          * `ENT` - ENT Procedure
          * `OBSTETRIC` - Obstetric Procedure
          * `WOUND_CARE` - Wound Care
          * `INJECTION` - Injection/Infusion
          * `SURGICAL` - Surgical Procedure
          * `OTHER` - Other
      - in: query
        name: facility
        schema:
          type: integer
      - in: query
        name: is_active
        schema:
          type: boolean
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
