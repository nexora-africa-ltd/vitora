    AdmissionRequest:
      type: object
      description: |-
        Serializer for Admission model.

        Supports automatic bed assignment via `auto_assign_bed=true` in request body.
        When auto_assign_bed is true, the `bed` field becomes optional as the system
        will automatically select the first available bed in the ward.
      properties:
        patient:
          type: integer
          description: Patient being admitted
        opd_encounter:
          type: integer
          nullable: true
          description: OPD encounter that led to admission (if applicable)
        mch_registration:
          type: integer
          nullable: true
          description: Pregnancy registration linked to this maternity admission
        recommendation:
          type: integer
          nullable: true
          description: Admission recommendation (if from OPD)
        admission_date:
          type: string
          format: date-time
          description: Date and time of admission
        admitting_diagnosis:
          type: string
          minLength: 1
          description: ICD-10 code for admitting diagnosis
          maxLength: 10
        admitting_diagnosis_text:
          type: string
          minLength: 1
          description: Text description of diagnosis
          maxLength: 255
        admitting_officer:
          type: integer
          description: User who processed the admission
        attending_doctor:
          type: integer
          nullable: true
          description: Doctor attending the patient
        ward:
          type: integer
          description: Ward where patient is admitted
        bed:
          type: integer
          nullable: true
          description: Bed ID. Optional when auto_assign_bed=true is provided.
        payer_type:
          allOf:
          - $ref: '#/components/schemas/AdmissionPayerTypeEnum'
          description: |-
            Type of payer

            * `CASH` - Cash
            * `SHA` - SHA Insurance
            * `CORPORATE` - Corporate
        insurance_details:
          description: Insurance information (for SHA/Corporate)
        constraint_override_reason:
          type: string
          description: Reason for overriding compatibility constraints
        expected_discharge_date:
          type: string
          format: date-time
          nullable: true
          description: Clinician-set expected discharge date for bed planning
      required:
      - admission_date
      - admitting_diagnosis
      - admitting_diagnosis_text
      - admitting_officer
      - patient
      - payer_type
      - ward
