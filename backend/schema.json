  /api/pharmacy/stock/:
    get:
      operationId: api_pharmacy_stock_list
      description: |-
        ViewSet for StockBatch model.

        Endpoints:
        - GET /api/pharmacy/stock/ - List all stock batches
        - GET /api/pharmacy/stock/{id}/ - Get batch details
        - POST /api/pharmacy/stock/ - Receive new stock
        - PATCH /api/pharmacy/stock/{id}/ - Update batch
      parameters:
      - in: query
        name: drug
        schema:
          type: integer
      - in: query
        name: drug__item_type
        schema:
          type: string
          enum:
          - CONSUMABLE
          - MEDICATION
          - REAGENT
        description: |-
          MEDICATION for drugs, CONSUMABLE for medical supplies, REAGENT for lab reagents

          * `MEDICATION` - Medication
          * `CONSUMABLE` - Consumable
          * `REAGENT` - Reagent
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
          enum:
          - AVAILABLE
          - EXPIRED
          - LOW
          - OUT_OF_STOCK
          - QUARANTINE
          - RECALLED
        description: |-
          * `AVAILABLE` - Available
          * `LOW` - Low Stock
          * `OUT_OF_STOCK` - Out of Stock
          * `EXPIRED` - Expired
          * `QUARANTINE` - Quarantine
          * `RECALLED` - Recalled
      - in: query
        name: store_location
        schema:
          type: integer
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedStockBatchList'
          description: ''
