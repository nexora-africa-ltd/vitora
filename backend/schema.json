  /api/imaging/studies/:
    get:
      operationId: api_imaging_studies_list
      description: |-
        ViewSet for DICOM studies.

        Provides list, retrieve, upload, and delete operations.
        Studies are looked up by study_instance_uid.

        Endpoints:
            GET    /api/imaging/studies/                     → list
            GET    /api/imaging/studies/{uid}/                → retrieve (detail + series)
            POST   /api/imaging/studies/upload/               → upload DICOM files
            DELETE /api/imaging/studies/{uid}/                → delete study + PACS files
            GET    /api/imaging/studies/{uid}/series/         → list series
            GET    /api/imaging/studies/{uid}/instances/      → list all instances
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDICOMStudyList'
          description: ''
  /api/imaging/studies/{study_instance_uid}/:
    get:
      operationId: api_imaging_studies_retrieve
      description: |-
        ViewSet for DICOM studies.

        Provides list, retrieve, upload, and delete operations.
        Studies are looked up by study_instance_uid.

        Endpoints:
            GET    /api/imaging/studies/                     → list
            GET    /api/imaging/studies/{uid}/                → retrieve (detail + series)
            POST   /api/imaging/studies/upload/               → upload DICOM files
            DELETE /api/imaging/studies/{uid}/                → delete study + PACS files
            GET    /api/imaging/studies/{uid}/series/         → list series
            GET    /api/imaging/studies/{uid}/instances/      → list all instances
      parameters:
      - in: path
        name: study_instance_uid
        schema:
          type: string
          pattern: ^[\d.]+$
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DICOMStudyDetail'
          description: ''
    delete:
      operationId: api_imaging_studies_destroy
      description: |-
        Delete a DICOM study and clean up PACS files.

        Removes all series, instances (via cascade) and the
        corresponding files from the filesystem.
      parameters:
      - in: path
        name: study_instance_uid
        schema:
          type: string
          pattern: ^[\d.]+$
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '204':
          description: No response body
  /api/imaging/studies/{study_instance_uid}/download/:
    get:
      operationId: api_imaging_studies_download_retrieve
      description: |-
        Download all DICOM instances for a study as a single ZIP archive.

        The archive layout is:
            {study_uid}/
                {series_uid}/
                    {sop_uid}.dcm
      parameters:
      - in: path
        name: study_instance_uid
        schema:
          type: string
          pattern: ^[\d.]+$
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DICOMStudy'
          description: ''
