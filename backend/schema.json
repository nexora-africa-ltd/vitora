        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: theatre_type
        schema:
          type: string
          enum:
          - CARDIAC
          - EMERGENCY
          - ENT
          - EYE
          - GENERAL
          - MINOR
          - NEURO
          - OBSTETRIC
          - ORTHO
          - PEDIATRIC
