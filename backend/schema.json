  /api/licensing/registry-token/:
    post:
      operationId: api_licensing_registry_token_create
      description: |-
        Exchange a valid license JWT for a short-lived Docker registry pull token.

        POST /api/licensing/registry-token/
        Authorization: Bearer <license-jwt>
        Body: {"installation_id": "..."}

        Returns a short-lived bearer token scoped for pulling the hub image.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegistryTokenRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RegistryTokenRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RegistryTokenRequestRequest'
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RegistryTokenResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LicenseErrorResponse'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LicenseErrorResponse'
          description: ''
