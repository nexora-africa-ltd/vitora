        operator_name:
          type: string
          nullable: true
          readOnly: true
        run_datetime:
          type: string
          format: date-time
          description: When the analyzer run occurred
        raw_message:
          type: string
          description: Raw HL7/ASTM/FHIR message from instrument
        raw_payload:
          description: Parsed message data in structured format
        status:
          allOf:
          - $ref: '#/components/schemas/AnalyzerRunStatusEnum'
          description: |-
            Processing status of this run

