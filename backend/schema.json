    InstrumentChannelCreate:
      type: object
      description: Create/update serializer for instrument channels.
      properties:
        instrument:
          type: integer
          description: Instrument this channel connects to
        name:
          type: string
          description: Channel display name (e.g., 'Primary ASTM', 'Backup HL7')
          maxLength: 100
        protocol:
          allOf:
          - $ref: '#/components/schemas/ProtocolEnum'
          description: |-
            Communication protocol

            * `ASTM` - ASTM E1394/LIS2-A2
            * `HL7` - HL7 v2.x over MLLP
            * `SERIAL` - Serial/RS-232 via TCP bridge
            * `TCP` - Raw TCP socket
        direction:
          allOf:
          - $ref: '#/components/schemas/Direction1dcEnum'
          description: |-
            Communication direction

            * `BIDIRECTIONAL` - Bidirectional
            * `HOST_TO_INSTRUMENT` - Host → Instrument only
            * `INSTRUMENT_TO_HOST` - Instrument → Host only
        host:
          type: string
          description: Host address (IP or hostname) of the instrument or TCP bridge
          maxLength: 255
        port:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: TCP port number
        encoding:
          type: string
          description: Character encoding (ascii, utf-8, cp1252)
          maxLength: 20
        config:
          description: 'Protocol-specific settings. ASTM: {baud_rate, data_bits, stop_bits,
            parity, timeout_ms, frame_size}. HL7: {receiving_application, receiving_facility,
            version, ack_mode}. SERIAL: {baud_rate, data_bits, stop_bits, parity,
            flow_control}. TCP: {timeout_ms, keepalive_interval}.'
        field_mapping:
          description: 'Maps protocol fields to Vitora fields. E.g., {''sample_id_field'':
            ''OBR.3'', ''result_value_field'': ''OBX.5'', ''test_code_field'': ''OBX.3.1''}'
        is_active:
          type: boolean
      required:
      - host
      - instrument
      - name
      - port
      - protocol
