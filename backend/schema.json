          maxLength: 100
        substance_type:
          allOf:
          - $ref: '#/components/schemas/SubstanceTypeEnum'
          description: |-
            Category of allergen

            * `medication` - Medication
            * `food` - Food
            * `environmental` - Environmental
            * `biological` - Biological
            * `other` - Other
        substance_type_display:
          type: string
          readOnly: true
        drug:
          type: integer
          nullable: true
          description: Linked drug record for medication allergies (enables interaction
            checking)
        drug_name:
          type: string
          readOnly: true
          nullable: true
        reaction_type:
          allOf:
          - $ref: '#/components/schemas/ReactionTypeEnum'
          description: |-
            Type of allergic reaction

            * `anaphylaxis` - Anaphylaxis
            * `angioedema` - Angioedema
            * `bronchospasm` - Bronchospasm
            * `cardiac_arrhythmia` - Cardiac Arrhythmia
            * `diarrhea` - Diarrhea
            * `dyspnea` - Dyspnea
            * `hives` - Hives/Urticaria
            * `hypotension` - Hypotension
            * `itching` - Itching/Pruritus
            * `nausea` - Nausea
            * `rash` - Rash
            * `swelling` - Swelling
            * `vomiting` - Vomiting
            * `other` - Other
        reaction_type_display:
          type: string
          readOnly: true
        reaction_description:
          type: string
          description: Detailed description of the reaction
        severity:
          allOf:
          - $ref: '#/components/schemas/Severity72dEnum'
          description: |-
            Severity of the allergic reaction

            * `mild` - Mild
            * `moderate` - Moderate
            * `severe` - Severe
            * `life_threatening` - Life-Threatening
        severity_display:
          type: string
          readOnly: true
        criticality:
          allOf:
          - $ref: '#/components/schemas/CriticalityEnum'
          description: |-
            Estimate of potential clinical harm (FHIR criticality)

            * `low` - Low Risk
            * `high` - High Risk
            * `unable_to_assess` - Unable to Assess
        criticality_display:
          type: string
          readOnly: true
        onset_date:
          type: string
          format: date
          nullable: true
          description: Date when the allergy was first identified
        last_occurrence:
          type: string
          format: date
          nullable: true
          description: Date of most recent known occurrence
        status:
          allOf:
          - $ref: '#/components/schemas/Status61bEnum'
          default: active
          description: |-
            Current status of the allergy

            * `active` - Active
            * `inactive` - Inactive
            * `resolved` - Resolved
        status_display:
          type: string
          readOnly: true
        verification_status:
          allOf:
          - $ref: '#/components/schemas/AllergyVerificationStatusEnum'
          description: |-
            Whether the allergy is confirmed or suspected

            * `unconfirmed` - Unconfirmed
            * `presumed` - Presumed
            * `confirmed` - Confirmed
            * `refuted` - Refuted
            * `entered_in_error` - Entered in Error
        verification_status_display:
          type: string
          readOnly: true
        is_high_risk:
          type: boolean
          description: Check if this allergy is high risk (severe or life-threatening).
          readOnly: true
        is_active:
          type: boolean
          description: Check if this allergy is currently active.
          readOnly: true
        notes:
          type: string
          description: Additional clinical notes about the allergy
        source_encounter:
          type: integer
          nullable: true
          description: Encounter during which this allergy was recorded
        recorded_by:
          type: integer
          readOnly: true
          nullable: true
          description: Staff member who recorded this allergy
        recorded_by_username:
          type: string
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - criticality_display
      - drug_name
      - id
      - is_active
      - is_high_risk
      - patient_mrn
      - patient_name
      - reaction_type_display
      - recorded_by
      - recorded_by_username
      - severity_display
      - status_display
      - substance
      - substance_type_display
      - updated_at
      - verification_status_display
