          type: string
        description: National ID or Passport number
      - in: query
        name: identification_type
        schema:
          type: string
        description: '''National ID'' or ''passport'''
      - in: query
        name: regulator
        schema:
          type: string
        description: 'Regulator code: KMPDC, COC, PPB, NCK (optional – tries all if
          omitted)'
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PractitionerSearchResponse'
          description: ''
