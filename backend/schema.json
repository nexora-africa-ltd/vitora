          description: ''
  /api/scheduling/shifts/cross-facility-conflicts/:
    get:
      operationId: api_scheduling_shifts_cross_facility_conflicts_retrieve
      description: |-
        Check for scheduling conflicts across facilities for multi-site staff.

        For each staff resource in the current facility's roster for the given
        date range, checks whether the linked StaffProfile has shifts at OTHER
        facilities on the same dates.

        Query params:
            from_date: Start date (required, YYYY-MM-DD)
            to_date:   End date   (required, YYYY-MM-DD)

        Returns a list of conflicts:
        [
          {
            "staff_resource_id": 42,
            "staff_resource_name": "Dr. Kamau",
            "staff_profile_id": 7,
            "shift_date": "2026-04-14",
            "this_facility_shift": { "shift_type": "DAY", "start_time": "07:00", "end_time": "19:00" },
            "other_facility": { "id": 3, "name": "Clinic B" },
            "other_shift": { "shift_type": "NIGHT", "start_time": "19:00", "end_time": "07:00" }
          }
        ]
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Shift'
          description: ''
  /api/scheduling/shifts/emergency-clock-in/:
    post:
      operationId: api_scheduling_shifts_emergency_clock_in_create
      description: |-
        Emergency clock-in: create an ad-hoc shift and immediately start it.

        For staff who need to work but have no scheduled shift (e.g. called in
        for an emergency, covering for absent colleague). Requires a mandatory
        reason that is logged in the audit trail.

        Request body:
        {
            "reason": "Called in for emergency surgery cover",
            "shift_type": "DAY",           // optional, default DAY
            "duration_hours": 8.0,         // optional, default 8
            "room_id": 123,                // optional
            "clinic_id": 456,              // optional
            "method": "MANUAL"             // optional
        }
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmergencyClockInRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/EmergencyClockInRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/EmergencyClockInRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EmergencyClockIn'
          description: ''
