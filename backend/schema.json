    OperatorEnum:
      enum:
      - GT
      - LT
      - GTE
      - LTE
      - EQ
      - NEQ
      - IN_RANGE
      - OUT_OF_RANGE
      - CONTAINS
      - CRITICAL
      - ABNORMAL
      type: string
      description: |-
        * `GT` - Greater Than (>)
        * `LT` - Less Than (<)
        * `GTE` - Greater Than or Equal (>=)
        * `LTE` - Less Than or Equal (<=)
        * `EQ` - Equals (==)
        * `NEQ` - Not Equals (!=)
        * `IN_RANGE` - In Range (between)
        * `OUT_OF_RANGE` - Out of Range
        * `CONTAINS` - Contains (text)
        * `CRITICAL` - Is Critical Value
        * `ABNORMAL` - Is Abnormal
