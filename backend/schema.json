    StaffConstraint:
      type: object
      description: Serializer for staff scheduling constraints.
      properties:
        id:
          type: integer
          readOnly: true
        staff_resource:
          type: integer
          description: Staff member this constraint applies to
        staff_resource_name:
          type: string
          readOnly: true
        constraint_type:
          allOf:
          - $ref: '#/components/schemas/ConstraintTypeEnum'
          description: |-
            Type of scheduling constraint

            * `NO_NIGHTS` - Cannot work night shifts
            * `NO_WEEKENDS` - Cannot work weekends
            * `MAX_HOURS` - Custom max hours per week
            * `MAX_CONSECUTIVE` - Custom max consecutive days
            * `PREFERRED_SHIFTS` - Preferred shift types only
            * `NO_OVERTIME` - No overtime shifts
            * `LIGHT_DUTY` - Light duty — day shifts only
            * `NO_SHARED_SHIFT_WITH` - Cannot share shift with specific staff
        constraint_type_display:
          type: string
          readOnly: true
        value:
          description: 'Configuration value, e.g. {"max_hours": 36} or {"shift_types":
            ["DAY", "MORNING"]}'
        reason:
          type: string
          description: Reason for this constraint (e.g. medical, personal request)
        is_active:
          type: boolean
          description: Whether this constraint is currently enforced
        effective_from:
          type: string
          format: date
          nullable: true
          description: Date from which this constraint is effective
        effective_until:
          type: string
          format: date
          nullable: true
          description: Date until which this constraint is effective (null = indefinite)
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - constraint_type
      - constraint_type_display
      - created_at
      - id
      - staff_resource
      - staff_resource_name
      - updated_at
    StaffConstraintRequest:
      type: object
