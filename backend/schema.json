      - in: query
        name: flag_key
        schema:
          type: string
      - in: query
        name: mapping_status
        schema:
          type: string
          enum:
          - AUTO_MAPPED
          - CONFIRMED
          - NEEDS_REVIEW
          - UNMAPPED
        description: |-
          * `UNMAPPED` - Unmapped
          * `AUTO_MAPPED` - Auto mapped
          * `NEEDS_REVIEW` - Needs review
          * `CONFIRMED` - Confirmed
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: path
        name: patient_pk
        schema:
          type: integer
        required: true
      - in: query
        name: severity
        schema:
          type: string
          enum:
          - CRITICAL
          - INFO
          - WARNING
        description: |-
          * `INFO` - Info
          * `WARNING` - Warning
          * `CRITICAL` - Critical
      - in: query
        name: source_type
        schema:
          type: string
          enum:
          - BACKGROUND_RULE
          - ENCOUNTER
          - TRIAGE
        description: |-
          * `TRIAGE` - Triage
          * `ENCOUNTER` - Encounter
          * `BACKGROUND_RULE` - Background Rule
      - in: query
        name: status
        schema:
          type: string
          enum:
          - ACCEPTED
          - ACKNOWLEDGED
          - EXPIRED
          - MAPPED
          - NEW
          - REJECTED
          - SUPERSEDED
        description: |-
          * `NEW` - New
          * `ACKNOWLEDGED` - Acknowledged
          * `MAPPED` - Mapped
          * `ACCEPTED` - Accepted
          * `REJECTED` - Rejected
          * `EXPIRED` - Expired
          * `SUPERSEDED` - Superseded
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedVitalFlagSuggestionList'
          description: ''
