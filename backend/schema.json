            schema:
              $ref: '#/components/schemas/AllergyRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AllergyRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AllergyRequest'
        required: true
