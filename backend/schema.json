      - referral_ins
      - return_patients
      - revenue_cash
      - revenue_insurance
      - revenue_mpesa
      - revenue_total
      - total_patients
      - triage_assessments
      - triage_emergency_count
      - walk_ins
    FacilityDetail:
      type: object
      description: |-
        Full serializer for facility detail / retrieve views.

        Includes the complete module capability map (``modules``) as a nested
        dictionary, plus resolved location names.  ``enabled_module_names``
        provides a convenience list of only the enabled modules for quick
        frontend rendering.

        ``effective_logo_url`` returns the facility's own logo URL if set,
        otherwise falls back to the parent organization's logo URL.
      properties:
        id:
          type: integer
          readOnly: true
        organization:
          type: integer
          nullable: true
          description: Parent organization (tenant) that owns this facility.
        organization_name:
          type: string
          readOnly: true
        mfl_code:
          type: string
          description: Kenya Master Facility List (MFL) code – the unique identifier
            assigned to every registered health facility by the MoH.
          maxLength: 20
        name:
          type: string
          description: Official facility name as registered on the MFL.
          maxLength: 200
        level:
          allOf:
          - $ref: '#/components/schemas/FacilityLevelEnum'
          description: |-
            KEPH level (1–6) determining the scope of services offered.

            * `1` - Level 1 – Community Unit
            * `2` - Level 2 – Dispensary
            * `3` - Level 3 – Health Centre
            * `4` - Level 4 – Sub-County Hospital
            * `5` - Level 5 – County Referral Hospital
            * `6` - Level 6 – National Referral Hospital
        level_subtype:
          allOf:
          - $ref: '#/components/schemas/LevelSubtypeEnum'
          description: |-
            Optional KEPH subtype band (e.g. A/B/C for Level 3/4 variants).

            * `A` - A
            * `B` - B
            * `C` - C
        ownership:
          allOf:
          - $ref: '#/components/schemas/FacilityOwnershipEnum'
          description: |-
            Ownership category (GOK, FBO, NGO, or Private).

            * `GOK` - Government of Kenya
            * `FBO` - Faith-Based Organization
            * `NGO` - Non-Governmental Organization
            * `PRIVATE` - Private Practice
        is_headquarters:
          type: boolean
          description: Whether this is the main branch of the organization.
        branch_code:
          type: string
          description: Internal branch identifier within the organization.
          maxLength: 50
        logo:
          type: string
          format: uri
          nullable: true
          description: Facility logo for branding. Falls back to organization logo
            if not set.
        effective_logo_url:
          type: string
          nullable: true
          description: Return the effective logo URL (facility logo or organization
            fallback).
          readOnly: true
        county:
          type: integer
          description: County where the facility is located.
        county_name:
          type: string
          readOnly: true
        sub_county:
          type: integer
          description: Sub-county where the facility is located.
        sub_county_name:
          type: string
          readOnly: true
        ward:
          type: integer
          nullable: true
          description: Ward where the facility is located (optional).
        ward_name:
          type: string
          readOnly: true
        sha_contracted:
          type: boolean
          description: Whether the facility is contracted by the Social Health Authority
            (SHA) for claims processing.
        sha_contract_expiry:
          type: string
          format: date
          nullable: true
          description: Date when the current SHA contract expires.
        sha_facility_code:
          type: string
          description: SHA-specific facility code used in claims submission.
          maxLength: 50
        workstation_id:
          type: string
          default: ''
        biometrics_enforced:
          type: boolean
          default: false
        biometrics_agent_national_id:
          type: string
          default: ''
        dha_registry_synced_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          description: When the DHA registry data was last fetched.
        dha_fid_code:
          type: string
          readOnly: true
          description: DHA Facility ID code.
        dha_fr_code:
          type: string
          readOnly: true
          description: DHA Facility Registration code.
        dha_license_status:
          type: string
          readOnly: true
          description: License status from DHA (e.g. LICENSED).
        dha_license_number:
          type: string
          readOnly: true
          description: License number from DHA.
        dha_license_expiry:
          type: string
          readOnly: true
          description: License expiry date string from DHA.
        dha_operational_status:
          type: string
          readOnly: true
          description: Regulatory operational status from DHA.
        dha_sha_contract_status:
          type: string
          readOnly: true
          description: SHA contract status from DHA.
        dha_sha_contract_start:
          type: string
