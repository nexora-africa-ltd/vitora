          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Percentage of beds reserved for emergency admissions (0-100)
        available_beds:
          type: integer
          description: |-
            Count of available beds (capacity minus occupied, cleaning, maintenance, reserved).

            Returns:
                Number of available beds
          readOnly: true
        total_beds:
          type: integer
          description: |-
            Total bed capacity of this ward.

            Returns:
                Ward capacity (total number of beds)
          readOnly: true
        occupied_beds:
          type: integer
          description: |-
            Count of beds with status OCCUPIED.

            Returns:
                Number of beds in OCCUPIED status
          readOnly: true
        occupancy_rate:
          type: number
          format: double
          description: |-
            Current occupancy percentage based on capacity.

            Returns:
                Occupancy rate as percentage (0-100)
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
