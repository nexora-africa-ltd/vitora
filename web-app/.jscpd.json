{
  "threshold": 3,
  "minLines": 10,
  "minTokens": 70,
  "reporters": [
    "console",
    "json",
    "html"
  ],
  "output": "./reports/jscpd",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/migrations/**",
    "**/tests/**",
    "**/e2e/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/*.config.js",
    "**/*.config.ts",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.d.ts",
    "**/jest-*.config.js",
    "**/playwright-*.config.ts",
    "**/coverage/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/reports/**",
    "**/.vscode/**",
    "**/playwright-report/**",
    "**/bdd-reports/**",
    "**/*.json",
    "**/*.lock",
    "**/*.md",
    "**/*.yaml",
    "**/*.yml",
    "**/test-results/**"

  ],
  "formats": [
    "javascript",
    "typescript",
    "python",
    "jsx",
    "tsx"
  ],
  "absolute": true,
  "skipLocal": false
}
