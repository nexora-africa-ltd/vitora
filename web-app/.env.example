# =============================================================================
# Vitora HMIS Web App - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development
# =============================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:9088

# App name (displayed in UI)
NEXT_PUBLIC_APP_NAME=Vitora HMIS

# Environment (development | staging | production)
NEXT_PUBLIC_ENV=development

# =============================================================================
# Optional: Feature Flags
# =============================================================================
# NEXT_PUBLIC_ENABLE_BILLING=true
# NEXT_PUBLIC_ENABLE_LAB=true
# NEXT_PUBLIC_ENABLE_PHARMACY=true
# NEXT_PUBLIC_ENABLE_TRIAGE=true

# =============================================================================
# Optional: Analytics & Monitoring
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_TRACKING_ID=
