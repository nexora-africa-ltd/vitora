# =============================================================================
# Vitora HMIS Web App - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All others are server-side only.
# =============================================================================

# =============================================================================
# Core / Required
# =============================================================================

# Backend Django REST API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:9088

# Application display name (shown in page titles, headers)
NEXT_PUBLIC_APP_NAME=Vitora HMIS

# Environment identifier: development | staging | production
# Controls default feature-flag behaviour (see below)
NEXT_PUBLIC_ENV=development

# =============================================================================
# Feature Flags (all optional — sensible defaults per environment)
# =============================================================================

# AI / TibaBot — ICD-10 suggestions, clinical assist panel, care plans
# Default: true in dev/staging, must be explicitly enabled in production
NEXT_PUBLIC_ENABLE_AI=true

# Theatre / Surgery module (Phase 2 — not yet implemented)
# Default: true in dev, must be explicitly enabled in staging/production
# NEXT_PUBLIC_ENABLE_THEATRE=true

# Legacy single-page triage form (set to "1" to enable, default: new tabbed flow)
# NEXT_PUBLIC_LEGACY_TRIAGE_FLOW=0

# First-run setup wizard (redirects unauthenticated users to /setup)
# Only effective when no organizations exist in the database
# NEXT_PUBLIC_SETUP_WIZARD_ENABLED=false

# =============================================================================
# Analytics & Error Monitoring (optional)
# =============================================================================

# Sentry DSN for error reporting
# NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_TRACKING_ID=
