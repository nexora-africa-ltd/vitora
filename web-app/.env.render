# =============================================================================
# Vitora HMIS Web App - Render Deployment Environment Variables
# =============================================================================
# Copy these to Render Dashboard > Environment Variables
# URL: https://vitora-hmis.onrender.com
# =============================================================================

# Backend API URL (your Render backend service)
NEXT_PUBLIC_API_URL=https://vitora.onrender.com

# App name (displayed in UI)
NEXT_PUBLIC_APP_NAME=Vitora HMIS

# Environment identifier (staging for demo/feedback)
NEXT_PUBLIC_ENV=staging

# Build Settings
NODE_ENV=production
