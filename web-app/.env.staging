# =============================================================================
# Vitora HMIS Web App - Staging Environment Variables
# =============================================================================
# Use this for stakeholder demos and workflow validation
# Mimics production UI but connects to staging backend
# =============================================================================

# Backend API URL (staging backend on Azure Container Apps)
NEXT_PUBLIC_API_URL=https://vitora-api.agreeabledune-6cc420cc.eastus.azurecontainerapps.io

# App name (displayed in UI)
NEXT_PUBLIC_APP_NAME=Vitora HMIS

# Environment identifier - triggers demo banner
NEXT_PUBLIC_ENV=staging

# Demo mode - shows demo banner and watermark
NEXT_PUBLIC_DEMO_MODE=true

# Demo facility name (shown in banner)
NEXT_PUBLIC_DEMO_FACILITY=Demo Health Facility

# Build Settings (production build for realistic performance)
NODE_ENV=production

# =============================================================================
# Feature Flags - Enable all for demo
# =============================================================================
NEXT_PUBLIC_ENABLE_BILLING=true
NEXT_PUBLIC_ENABLE_LAB=true
NEXT_PUBLIC_ENABLE_PHARMACY=true
NEXT_PUBLIC_ENABLE_TRIAGE=true
NEXT_PUBLIC_ENABLE_INPATIENT=true
NEXT_PUBLIC_ENABLE_THEATRE=true
NEXT_PUBLIC_ENABLE_AI=true

# =============================================================================
# Demo User Credentials (for stakeholder login)
# =============================================================================
# These are displayed on login page in staging mode
NEXT_PUBLIC_DEMO_USERS=true
