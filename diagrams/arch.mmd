flowchart TD

subgraph group_clients["Client surfaces"]
  node_web["Web dashboard<br/>Next.js client<br/>[layout.tsx]"]
  node_desktop["Desktop shell<br/>Tauri client<br/>[main.rs]"]
  node_mobile["Outreach mobile<br/>mobile client<br/>[_layout.tsx]"]
end

subgraph group_backend["Django system of record"]
  node_api{{"DRF API<br/>HTTP API boundary<br/>[urls.py]"}}
  node_governance["Tenancy and security<br/>core governance<br/>[models.py]"]
end

subgraph group_clinical["Care and operations"]
  node_patients["Patient identity<br/>patient domain<br/>[models.py]"]
  node_frontdoor["Check-in and triage<br/>care routing<br/>[services.py]"]
  node_encounters["Encounter care<br/>clinical workflow"]
  node_clinicalops["Clinical fulfillment<br/>lab, pharmacy, imaging<br/>[workflow.py]"]
  node_inpatient["Inpatient care<br/>admission workflow"]
end

subgraph group_exchange["Finance and exchange"]
  node_billing["Billing and claims<br/>revenue cycle"]
  node_standards{{"FHIR and HL7<br/>standards gateway"}}
  node_national["National reporting<br/>DHIS2 and MOH exchange"]
end

subgraph group_platform["Sync and runtime"]
  node_database[("Clinical database<br/>SQLite or PostgreSQL")]
  node_sync["Offline sync<br/>PowerSync pipeline"]
  node_realtime["Realtime updates<br/>WebSocket delivery"]
  node_workers["Background workers<br/>Celery runtime<br/>[celery.py]"]
  node_observability["Monitoring<br/>Prometheus and Grafana"]
end

node_web -->|"HTTPS API"| node_api
node_desktop -->|"HTTPS API"| node_api
node_mobile -->|"sync and API"| node_api
node_web -->|"offline adapter"| node_sync
node_mobile -->|"sync engine"| node_sync
node_api -->|"authorizes and audits"| node_governance
node_api -->|"patient API"| node_patients
node_api -->|"arrival workflow"| node_frontdoor
node_frontdoor -->|"routes visit"| node_encounters
node_patients -->|"patient context"| node_encounters
node_encounters -->|"orders"| node_clinicalops
node_encounters -->|"admit or discharge"| node_inpatient
node_encounters -->|"chargeable care"| node_billing
node_clinicalops -->|"inventory and services"| node_billing
node_billing -->|"SHA/DHA exchange"| node_standards
node_api -->|"FHIR APIs"| node_standards
node_api -->|"reporting data"| node_national
node_api -->|"persists records"| node_database
node_sync -->|"materialized data"| node_database
node_api -->|"publishes events"| node_realtime
node_api -->|"queues async work"| node_workers
node_workers -.->|"scheduled submissions"| node_national
node_api -.->|"metrics"| node_observability

