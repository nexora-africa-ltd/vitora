                          },
                          "citizenship": {
                            "type": "string"
                          },
                          "county": {
                            "type": "string"
                          },
                          "date_of_birth": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          },
                          "first_name": {
                            "type": "string"
                          },
                          "gender": {
                            "type": "string"
                          },
                          "id": {
                            "type": "string"
                          },
                          "identification_number": {
                            "type": "string"
                          },
                          "identification_type": {
                            "type": "string"
                          },
                          "last_name": {
                            "type": "string"
                          },
                          "learning_institution_code": {
                            "type": "string"
                          },
                          "learning_institution_name": {
                            "type": "string"
                          },
                          "middle_name": {
                            "type": "string"
