    "/api/v1/professionals": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Retrieves a practitioner's record from health worker registry",
        "tags": [
          "Health Worker Registry"
        ],
        "operationId": "ProfessionalSearch",
        "summary": "Get practitioner's record",
        "parameters": [
          {
            "description": "The unique number from the professional's identification document",
            "name": "identification_number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "A11702"
              }
            }
          },
          {
            "description": "The kind of identification document of the healthcare professional",
            "name": "identification_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "registration_number",
                "license_number",
                "practice_number",
                "national_id",
                "passport",
                "other"
              ]
            },
            "examples": {
              "default": {
                "value": "registration_number"
              }
            }
          },
          {
            "description": "Practitioner regulator. This is required to identify the correct practitioner registry to query.",
            "name": "regulator",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "KMPDC",
                "COC",
                "PPB"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "object",
