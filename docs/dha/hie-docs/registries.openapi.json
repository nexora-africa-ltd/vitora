{
  "openapi": "3.1.1",
  "info": {
    "title": "HIE Registries",
    "version": "1.0.0",
    "description": "API for accessing various registries in the Health Information Exchange (HIE) system."
  },
  "servers": [
    {
      "url": "https://ilm-dev.dha.go.ke/uat-middleware"
    }
  ],
  "tags": [
    {
      "name": "Client Registry",
      "description": "Endpoints for accessing client registry"
    },
    {
      "name": "Health Worker Registry",
      "description": "Endpoints for accessing health worker registry"
    },
    {
      "name": "Facility Registry",
      "description": "Endpoints for accessing facility registry"
    }
  ],
  "paths": {
    "/api/v1/facilities/search": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Retrieves a facility's record from facility registry",
        "tags": [
          "Facility Registry"
        ],
        "operationId": "FacilitySearch",
        "summary": "Get facility's record",
        "parameters": [
          {
            "description": "The unique identifier value for the facility",
            "required": true,
            "name": "identifier",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "021240"
              }
            }
          },
          {
            "name": "identifier-type",
            "description": "The type of identifier being used to search for the facility",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "registration-number"
              }
            }
          },
          {
            "description": "Facility's name",
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "SHAOperationStatus": {
                      "type": "object",
                      "properties": {
                        "earliestReinstatementDate": {
                          "type": "string"
                        },
                        "operationalStatus": {
                          "type": "string"
                        },
                        "operationalStatusReason": {
                          "type": "string"
                        },
                        "reinstatementDate": {
                          "type": "string"
                        },
                        "reinstatementRecommendations": {
                          "type": "string"
                        },
                        "suspensionDate": {
                          "type": "string"
                        },
                        "suspensionReason": {
                          "type": "string"
                        }
                      }
                    },
                    "address": {
                      "type": "object",
                      "properties": {
                        "constituency": {
                          "type": "string"
                        },
                        "country": {
                          "type": "string"
                        },
                        "county": {
                          "type": "string"
                        },
                        "countyCode": {
                          "type": "string"
                        },
                        "latitude": {
                          "type": "string"
                        },
                        "longitude": {
                          "type": "string"
                        },
                        "physicalLocation": {
                          "type": "string"
                        },
                        "postalAddress": {
                          "type": "string"
                        },
                        "subCounty": {
                          "type": "string"
                        },
                        "subCountyCode": {
                          "type": "string"
                        },
                        "town": {
                          "type": "string"
                        },
                        "ward": {
                          "type": "string"
                        }
                      }
                    },
                    "bedOccupancy": {
                      "type": "object",
                      "properties": {
                        "dialysisBeds": {
                          "type": "integer"
                        },
                        "hduBeds": {
                          "type": "integer"
                        },
                        "icuBeds": {
                          "type": "integer"
                        },
                        "normalBeds": {
                          "type": "integer"
                        },
                        "numberOfCots": {
                          "type": "integer"
                        },
                        "totalBeds": {
                          "type": "integer"
                        }
                      }
                    },
                    "facilityAdministratorEmail": {
                      "type": "string"
                    },
                    "facilityAdministratorIdentifier": {
                      "type": "string"
                    },
                    "facilityAdministratorName": {
                      "type": "string"
                    },
                    "facilityAdministratorPhone": {
                      "type": "string"
                    },
                    "facilityEmail": {
                      "type": "string"
                    },
                    "facilityLicenseEndDate": {
                      "type": "string"
                    },
                    "facilityLicenseStartDate": {
                      "type": "string"
                    },
                    "facilityLicenseStatus": {
                      "type": "string"
                    },
                    "facilityOwnership": {
                      "type": "string"
                    },
                    "facilityPhoneNumber": {
                      "type": "string"
                    },
                    "facilityType": {
                      "type": "string"
                    },
                    "fidCode": {
                      "type": "string"
                    },
                    "frCode": {
                      "type": "string"
                    },
                    "isHub": {
                      "type": "boolean"
                    },
                    "kephLevel": {
                      "type": "string"
                    },
                    "licenseNumber": {
                      "type": "string"
                    },
                    "officialName": {
                      "type": "string"
                    },
                    "pcnCode": {
                      "type": "string"
                    },
                    "registrationNumber": {
                      "type": "string"
                    },
                    "regulatoryBody": {
                      "type": "string"
                    },
                    "regulatoryOperationalStatus": {
                      "$ref_circular": "#/__circ_32"
                    },
                    "shaConstractEndDate": {},
                    "shaConstractStartDate": {},
                    "shaContractStatus": {
                      "type": "string"
                    },
                    "shaContractedServices": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "uuid": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Missing required query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid identity",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Standard error response format for all error conditions.",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "@Description\tHTTP status text from the standard HTTP status codes\n\t@Example\t\t\"Bad Request\"",
                      "type": "string"
                    },
                    "message": {
                      "description": "@Description\tDetailed error message explaining what went wrong\n\t@Example\t\t\"token missing required tenant_id claim\"",
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Not enough permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref_circular": "#/__circ_99"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Failed to retrieve practitioner record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref_circular": "#/__circ_92"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/patients": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Retrieves patient record from the client registry using a patient's identification number and type",
        "tags": [
          "Client Registry"
        ],
        "summary": "Get patient record",
        "parameters": [
          {
            "name": "identification_number",
            "description": "The unique number from the patient's identification document",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "12345678"
              }
            }
          },
          {
            "name": "identification_type",
            "in": "query",
            "description": "The kind of identification document of the Patient",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Temporary ID",
                "Alien ID",
                "Refugee ID",
                "Mandate Number",
                "Birth Certificate",
                "National ID",
                "Birth Notification",
                "ClientRegistry ID"
              ]
            },
            "examples": {
              "default": {
                "value": "National ID"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "admission_number": {
                      "type": "string"
                    },
