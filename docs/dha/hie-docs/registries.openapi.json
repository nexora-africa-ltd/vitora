                              "type": "string"
                            },
                            "identification_number": {
                              "type": "string"
                            },
                            "identification_type": {
                              "type": "string"
                            },
                            "student_id": {
                              "type": "string"
                            }
                          }
                        },
                        "licenses": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "external_reference_id": {
                                "type": "string"
                              },
                              "id": {
                                "type": "string"
                              },
                              "license_end": {
                                "type": "string"
                              },
                              "license_start": {
                                "type": "string"
                              },
                              "license_type": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "membership": {
                          "type": "object",
                          "properties": {
                            "external_reference_id": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string"
                            },
                            "full_name": {
                              "type": "string"
                            },
                            "gender": {
                              "type": "string"
                            },
                            "id": {
                              "type": "string"
                            },
                            "is_active": {
                              "type": "integer"
                            },
                            "last_name": {
                              "type": "string"
                            },
                            "licensing_body": {
                              "type": "string"
                            },
                            "middle_name": {
                              "type": "string"
                            },
                            "registration_id": {
                              "type": "string"
                            },
                            "specialty": {
                              "type": "string"
                            }
                          }
                        },
                        "professional_details": {
                          "type": "object",
                          "properties": {
                            "discipline_name": {
                              "type": "string"
                            },
                            "educational_qualifications": {
                              "type": "string"
                            },
                            "practice_type": {
                              "type": "string"
                            },
                            "professional_cadre": {
                              "type": "string"
                            },
                            "specialty": {
                              "type": "string"
                            },
                            "subspecialty": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Missing required query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref_circular": "#/__circ_92"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Failed to retrieve practitioner record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref_circular": "#/__circ_92"
                }
              }
            }
          }
        }
      }
    }
