{
  "uid": "vitora-insurance-healthcloud",
  "title": "Vitora HMIS - Insurance HealthCloud",
  "description": "Operational telemetry for HealthCloud insurance integrations: token acquisition, upstream stability, remittance lag, and workflow outcomes.",
  "tags": ["vitora", "insurance", "healthcloud", "observability"],
  "timezone": "Africa/Nairobi",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Token Success Rate (30m)",
      "description": "Percentage of successful HealthCloud token acquisition attempts over 30 minutes.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(increase(vitora_insurance_healthcloud_token_requests_total{result=\"success\"}[30m])) / clamp_min(sum(increase(vitora_insurance_healthcloud_token_requests_total[30m])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 97 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Token Failures (30m)",
      "description": "Absolute failed token acquisitions over 30 minutes.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(vitora_insurance_healthcloud_token_requests_total{result=\"failed\"}[30m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Upstream 5xx Ratio (10m)",
      "description": "Share of insurer upstream responses returning 5xx over 10 minutes.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(increase(vitora_insurance_upstream_responses_total{status_family=\"5xx\"}[10m])) / clamp_min(sum(increase(vitora_insurance_upstream_responses_total[10m])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Remittance Poll Successes (6h)",
      "description": "Successful HealthCloud remittance poll operations over 6 hours.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(vitora_insurance_healthcloud_workflow_total{operation=\"healthcloud.get_claim_remittance\",result=\"success\"}[6h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token Requests by Result",
      "description": "HealthCloud token request rates split by success/failed.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (result) (rate(vitora_insurance_healthcloud_token_requests_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Upstream Responses by Host and Status Family",
      "description": "Insurer upstream response rate split by host and 2xx/4xx/5xx status families.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (host, status_family) (rate(vitora_insurance_upstream_responses_total[5m]))",
          "legendFormat": "{{host}} {{status_family}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HealthCloud Workflow Throughput by Operation",
      "description": "Workflow operation rates split by operation and outcome.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (operation, result) (rate(vitora_insurance_healthcloud_workflow_total{operation=~\"healthcloud.*\"}[5m]))",
          "legendFormat": "{{operation}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HealthCloud Workflow Latency p95",
      "description": "p95 latency for each HealthCloud workflow operation.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(vitora_insurance_healthcloud_workflow_latency_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "id": null
}
