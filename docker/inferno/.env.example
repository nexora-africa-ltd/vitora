# Inferno Testing Suite Environment Configuration
# Copy this file to .env and customize for your environment
#
# Usage:
#   cp docker/inferno/.env.example docker/inferno/.env
#   # Edit .env with your values
#   docker compose -f docker/inferno/compose.yml --env-file docker/inferno/.env up -d

# =============================================================================
# INFERNO CONFIGURATION
# =============================================================================

# Session secret for Inferno (generate a secure random string in production)
INFERNO_SESSION_SECRET=vitora-inferno-secret-key-change-in-production

# =============================================================================
# VITORA FHIR SERVER CONFIGURATION
# =============================================================================

# Vitora FHIR base URL (the server under test)
# Development: http://host.docker.internal:9088 (from inside Docker)
# Production: https://your-domain.com
VITORA_FHIR_URL=http://host.docker.internal:9088

# FHIR API endpoints
VITORA_FHIR_METADATA_URL=${VITORA_FHIR_URL}/fhir/metadata
VITORA_SMART_CONFIG_URL=${VITORA_FHIR_URL}/.well-known/smart-configuration

# =============================================================================
# SMART APP LAUNCH CONFIGURATION
# =============================================================================

# OAuth2 endpoints (used by SMART test kit)
VITORA_OAUTH_AUTHORIZE_URL=${VITORA_FHIR_URL}/oauth/authorize/
VITORA_OAUTH_TOKEN_URL=${VITORA_FHIR_URL}/oauth/token/
VITORA_OAUTH_INTROSPECT_URL=${VITORA_FHIR_URL}/smart/introspect

# Test client credentials (register in Vitora Django admin)
# These are created automatically by the test runner script
SMART_CLIENT_ID=inferno-test-client
SMART_CLIENT_SECRET=inferno-test-secret
SMART_REDIRECT_URI=http://localhost:4567/custom/smart/redirect

# =============================================================================
# TEST DATA CONFIGURATION
# =============================================================================

# Test patient ID (create a test patient in Vitora)
TEST_PATIENT_ID=1

# Test practitioner ID
TEST_PRACTITIONER_ID=1

# Test encounter ID
TEST_ENCOUNTER_ID=1

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info
